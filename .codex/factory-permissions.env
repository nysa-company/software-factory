# Wrapper-controlled Codex profile. Project config cannot define permission
# tables because repositories must not be able to grant themselves access.
CODEX_FACTORY_PERMISSION_NAME=factory
CODEX_FACTORY_PERMISSION_CONFIG='permissions.factory={extends=":workspace",filesystem={glob_scan_max_depth=8,":workspace_roots"={"**/.env"="deny","**/.env.*"="deny","**/*.pem"="deny","**/*.key"="deny","**/credentials*.json"="deny"}},network={enabled=true,allow_local_binding=true,domains={localhost="allow","127.0.0.1"="allow"}}}'
CODEX_FACTORY_SHELL_CONFIG='shell_environment_policy={inherit="core",exclude=["*KEY*","*TOKEN*","*SECRET*","*PASSWORD*","*DSN*","*CONN*","*AUTH*"]}'
