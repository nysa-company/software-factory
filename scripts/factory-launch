run_selected_helper() {
  "${HELPER_ENV[@]}" /bin/bash "$@"
}

exec_selected_helper() {
  exec "${HELPER_ENV[@]}" /bin/bash "$@"
}

run_selected_python() {
  "${HELPER_ENV[@]}" "$PYTHON_BIN" -I -S "$@"
}

require_exact() {
  local expected="$1"
  shift
  [[ $# -eq 1 && "$1" == "$expected" ]] || usage
}

validate_ticket_command() {
  LEASE_ID="" TICKET_WORKDIR=""
  if [[ $# -eq 3 && "$1" == "--ticket" && "$3" == "--json" ]]; then
    :
  elif [[ $# -eq 5 && "$1" == "--ticket" && "$3" == "--workdir" && "$5" == "--json" ]]; then
    TICKET_WORKDIR="$4"
  elif [[ $# -eq 5 && "$1" == "--ticket" && "$3" == "--lease" && "$5" == "--json" ]]; then
    LEASE_ID="$4"
    [[ "$LEASE_ID" =~ ^[0-9a-f]{64}$ ]] || die "invalid dispatcher lease"
  elif [[ $# -eq 7 && "$1" == "--ticket" && "$3" == "--lease" &&
          "$5" == "--workdir" && "$7" == "--json" ]]; then
    LEASE_ID="$4" TICKET_WORKDIR="$6"
    [[ "$LEASE_ID" =~ ^[0-9a-f]{64}$ ]] || die "invalid dispatcher lease"
  else
    usage
  fi
  [[ "$2" =~ ^T-[0-9]+$ ]] || die "invalid ticket identifier"
  TICKET="$2"
  if [[ "$CONTRACT_VERSION" == "1.2.0" || "$CONTRACT_VERSION" == "1.3.0" ||
        "$CONTRACT_VERSION" == "1.4.0" || "$CONTRACT_VERSION" == "1.5.0" ||
        "$CONTRACT_VERSION" == "1.6.0" || "$CONTRACT_VERSION" == "1.7.0" || "$CONTRACT_VERSION" == "1.8.0" ||
        "$CONTRACT_VERSION" == "2.0.0" ]] &&
     [[ -z "$TICKET_WORKDIR" ]]; then
    die "contract $CONTRACT_VERSION requires a ticket workdir"
  fi
  if [[ -n "$TICKET_WORKDIR" ]]; then
    resolve_product_workdir "$TICKET_WORKDIR"
    validate_ticket_worktree "$TICKET"
    TICKET_WORKDIR="$RESOLVED_WORKDIR"
  fi
}

validate_preflight_command() {
  PREFLIGHT_ROLE="" TRANSITION_RECEIPT=""
  if [[ "$CONTRACT_VERSION" == "1.8.0" || "$CONTRACT_VERSION" == "2.0.0" ]]; then
    if [[ $# -eq 9 && "$1" == "--ticket" && "$3" == "--role" &&
          "$5" == "--receipt" && "$7" == "--workdir" && "$9" == "--json" ]]; then
      TICKET="$2" PREFLIGHT_ROLE="$4" TRANSITION_RECEIPT="$6"
      LEASE_ID="" TICKET_WORKDIR="$8"
    elif [[ $# -eq 11 && "$1" == "--ticket" && "$3" == "--role" &&
            "$5" == "--lease" && "$7" == "--receipt" &&
            "$9" == "--workdir" && "${11}" == "--json" ]]; then
      TICKET="$2" PREFLIGHT_ROLE="$4" LEASE_ID="$6"
      TRANSITION_RECEIPT="$8" TICKET_WORKDIR="${10}"
      [[ "$LEASE_ID" =~ ^[0-9a-f]{64}$ ]] || die "invalid dispatcher lease"
    else
      usage
    fi
    [[ "$TICKET" =~ ^T-[0-9]+$ ]] || die "invalid ticket identifier"
    [[ "$TRANSITION_RECEIPT" =~ ^[0-9a-f]{64}$ ]] ||
      die "invalid transition receipt"
    role_is_allowed "$PREFLIGHT_ROLE" ||
      die "preflight role is not allowed by the active contract"
    resolve_product_workdir "$TICKET_WORKDIR"
    validate_ticket_worktree "$TICKET"
    TICKET_WORKDIR="$RESOLVED_WORKDIR"
  elif [[ "$CONTRACT_VERSION" == "1.5.0" || "$CONTRACT_VERSION" == "1.6.0" ||
          "$CONTRACT_VERSION" == "1.7.0" ]]; then
    [[ $# -ge 5 && "$1" == "--ticket" && "$3" == "--role" ]] || usage
    local ticket_arg="$2"
    PREFLIGHT_ROLE="$4"
    role_is_allowed "$PREFLIGHT_ROLE" ||
      die "preflight role is not allowed by the active contract"
    shift 4
    validate_ticket_command --ticket "$ticket_arg" "$@"
  else
    validate_ticket_command "$@"
  fi
}

controller_state_dir() {
  if [[ "$QUALIFICATION_MODE" == "takeover" ]]; then
    CONTROLLER_STATE_DIR="$TAKEOVER_KITS_ROOT/projects/$PROJECT/controller"
  elif [[ "$QUALIFICATION_LAUNCHER" == "1" ]]; then
    CONTROLLER_STATE_DIR="$ACTIVE_CONTROLLER_STATE"
  else
    CONTROLLER_STATE_DIR="$KITS_ROOT/projects/$PROJECT/controller"
  fi
  if [[ ! -e "$CONTROLLER_STATE_DIR" ]]; then
    mkdir -m 700 "$CONTROLLER_STATE_DIR" ||
      die "cannot create controller state directory"
  fi
  require_managed_directory "$CONTROLLER_STATE_DIR" "controller state directory"
}

transition_receipt() {
  local action="$1" role="${2:-}"
  local output
  controller_state_dir
  add_certified_origin_env
  local -a arguments=(
    "$action"
    --factory-root "$PRODUCT_ROOT"
    --workdir "$RESOLVED_WORKDIR"
    --kit-dir "$RELEASE_PATH"
    --state-dir "$CONTROLLER_STATE_DIR"
    --ticket "$TICKET"
    --contract-version "$CONTRACT_VERSION"
    --factory-sha "$KIT_SHA"
    --project "$PROJECT"
    --receipt "$TRANSITION_RECEIPT"
  )
  [[ -z "$LEASE_ID" ]] || arguments+=(--lease "$LEASE_ID")
  [[ -z "$role" ]] || arguments+=(--role "$role")
  output="$(run_selected_python "$RELEASE_PATH/scripts/state-machine.py" \
    "${arguments[@]}")" || return 1
  TRANSITION_STAGE="$("$PYTHON_BIN" -I -S -c \
    'import json,sys; print(json.load(sys.stdin)["stage"])' <<<"$output")" ||
    return 1
  TRANSITION_PREFLIGHT_STAGE="$("$PYTHON_BIN" -I -S -c \
    'import json,sys; value=json.load(sys.stdin); print(value.get("preflight_stage", value["stage"]))' \
    <<<"$output")" || return 1
}

add_dispatch_lease_env() {
  if [[ -n "${1:-}" ]]; then
    [[ "$CONTRACT_VERSION" == "1.1.0" || "$CONTRACT_VERSION" == "1.2.0" ||
       "$CONTRACT_VERSION" == "1.3.0" || "$CONTRACT_VERSION" == "1.4.0" ||
       "$CONTRACT_VERSION" == "1.5.0" || "$CONTRACT_VERSION" == "1.6.0" ||
       "$CONTRACT_VERSION" == "1.7.0" || "$CONTRACT_VERSION" == "1.8.0" ||
       "$CONTRACT_VERSION" == "2.0.0" ]] ||
      die "dispatcher leases require contract 1.1.0 or newer"
    HELPER_ENV+=("FACTORY_DISPATCH_LEASE_ID=$1")
  fi
}

add_certified_origin_env() {
  [[ "$CONTRACT_VERSION" == "1.2.0" || "$CONTRACT_VERSION" == "1.3.0" ||
     "$CONTRACT_VERSION" == "1.4.0" || "$CONTRACT_VERSION" == "1.5.0" ||
     "$CONTRACT_VERSION" == "1.6.0" || "$CONTRACT_VERSION" == "1.7.0" || "$CONTRACT_VERSION" == "1.8.0" ||
     "$CONTRACT_VERSION" == "2.0.0" ]] || return 0
  [[ -n "$CERTIFIED_PRODUCT_ORIGIN" ]] ||
    die "certified product origin is unavailable"
  HELPER_ENV+=("FACTORY_CERTIFIED_PRODUCT_ORIGIN=$CERTIFIED_PRODUCT_ORIGIN")
}

validate_lease_command() {
  [[ "$CONTRACT_VERSION" == "1.1.0" || "$CONTRACT_VERSION" == "1.2.0" ||
     "$CONTRACT_VERSION" == "1.3.0" || "$CONTRACT_VERSION" == "1.4.0" ||
     "$CONTRACT_VERSION" == "1.5.0" || "$CONTRACT_VERSION" == "1.6.0" ||
     "$CONTRACT_VERSION" == "1.7.0" || "$CONTRACT_VERSION" == "1.8.0" ||
     "$CONTRACT_VERSION" == "2.0.0" ]] ||
    die "dispatcher leases require contract 1.1.0 or newer"
  [[ "$1" != "release-expired" || "$CONTRACT_VERSION" == "1.8.0" ||
     "$CONTRACT_VERSION" == "2.0.0" ]] ||
    die "expired lease recovery requires contract 1.8.0 or newer"
  LEASE_ID=""
  if [[ "$1" == "claim" ]]; then
    [[ $# -eq 3 && "$2" == "--ticket" ]] || usage
  else
    [[ $# -eq 5 && "$2" == "--ticket" && "$4" == "--lease" ]] || usage
    LEASE_ID="$5"
    [[ "$LEASE_ID" =~ ^[0-9a-f]{64}$ ]] || die "invalid dispatcher lease"
  fi
  [[ "$3" =~ ^T-[0-9]+$ ]] || die "invalid ticket identifier"
  TICKET="$3"
}

git_common_directory() {
  local root="$1" common
  common="$(git -C "$root" rev-parse --git-common-dir 2>/dev/null)" || return 1
  case "$common" in
    /*) ;;
    *) common="$root/$common" ;;
  esac
  (cd "$common" 2>/dev/null && pwd -P)
}

resolve_product_workdir() {
  local raw="$1" top product_common workdir_common
  case "$raw" in
    /*) ;;
    *) die "workdir must be absolute" ;;
  esac
  case "$raw" in
    *'`'*|*'$('*|*$'\n'*|*$'\r'*|*$'\t'*)
      die "workdir contains unsafe characters"
      ;;
    *'/../'*|*/..|*'/./'*|*/.|*//*)
      die "workdir contains path traversal"
      ;;
  esac
  [[ -d "$raw" && ! -L "$raw" ]] ||
    die "workdir is missing or a symlink"
  reject_symlink_components "$raw" "workdir"
  RESOLVED_WORKDIR="$(cd "$raw" 2>/dev/null && pwd -P)" ||
    die "workdir cannot be resolved"
  git -C "$RESOLVED_WORKDIR" rev-parse --is-inside-work-tree 2>/dev/null |
    grep -Fqx true || die "workdir is not a Git worktree"
  top="$(git -C "$RESOLVED_WORKDIR" rev-parse --show-toplevel 2>/dev/null)" ||
    die "worktree root cannot be resolved"
  top="$(cd "$top" 2>/dev/null && pwd -P)" ||
    die "worktree root cannot be resolved"
  [[ "$top" == "$RESOLVED_WORKDIR" ]] ||
    die "workdir must be the Git worktree root"
  product_common="$(git_common_directory "$PRODUCT_ROOT" 2>/dev/null || true)"
  workdir_common="$(git_common_directory "$RESOLVED_WORKDIR" 2>/dev/null || true)"
  [[ -n "$product_common" && "$workdir_common" == "$product_common" ]] ||
    die "workdir does not belong to the registered product"
}

ticket_branch_prefix() {
  local descriptor="$PRODUCT_ROOT/factory/PROJECT.env" data count value
  TICKET_BRANCH_PREFIX="ticket/"
  [[ -e "$descriptor" ]] || return 0
  [[ -f "$descriptor" && ! -L "$descriptor" ]] ||
    die "product project descriptor is not a safe regular file"
  data="$(awk '
    /^[[:space:]]*#/ { next }
    {
      line=$0
      sub(/^[[:space:]]*export[[:space:]]+/, "", line)
      if (line ~ /^TICKET_BRANCH_PREFIX[[:space:]]*=/) {
        count++
        sub(/^TICKET_BRANCH_PREFIX[[:space:]]*=[[:space:]]*/, "", line)
        sub(/[[:space:]]+$/, "", line)
        if ((line ~ /^".*"$/) || (line ~ /^'\''.*'\''$/)) {
          line=substr(line, 2, length(line)-2)
        }
        value=line
      }
    }
    END { printf "%d\t%s\n", count+0, value }
  ' "$descriptor" 2>/dev/null)" ||
    die "cannot parse product ticket branch prefix"
  IFS="$(printf '\t')" read -r count value <<EOF
$data
EOF
  case "$count" in
    0) ;;
    1) TICKET_BRANCH_PREFIX="$value" ;;
    *) die "product ticket branch prefix must be defined at most once" ;;
  esac
  [[ "$TICKET_BRANCH_PREFIX" =~ ^[A-Za-z0-9][A-Za-z0-9._/-]*/$ ]] ||
    die "product ticket branch prefix is invalid"
  case "$TICKET_BRANCH_PREFIX" in
    *..*|*//*|*@\{*|*\\*|*~*|*^*|*:*)
      die "product ticket branch prefix is invalid"
      ;;
  esac
}

validate_ticket_worktree() {
  local ticket="$1" allow_dirty="${2:-0}"
  local product_top git_dir common branch expected worktree_status
  ticket_branch_prefix
  expected="$TICKET_BRANCH_PREFIX$ticket"
  git check-ref-format --branch "$expected" >/dev/null 2>&1 ||
    die "ticket branch name is invalid"
  product_top="$(git -C "$PRODUCT_ROOT" rev-parse --show-toplevel 2>/dev/null)" ||
    die "registered product Git root cannot be resolved"
  product_top="$(cd "$product_top" 2>/dev/null && pwd -P)" ||
    die "registered product Git root cannot be resolved"
  [[ "$RESOLVED_WORKDIR" != "$product_top" ]] ||
    die "ticket workdir must be a distinct linked worktree"
  common="$(git_common_directory "$RESOLVED_WORKDIR" 2>/dev/null || true)"
  git_dir="$(git -C "$RESOLVED_WORKDIR" rev-parse --git-dir 2>/dev/null)" ||
    die "run worktree Git directory cannot be resolved"
  case "$git_dir" in
    /*) ;;
    *) git_dir="$RESOLVED_WORKDIR/$git_dir" ;;
  esac
  git_dir="$(cd "$git_dir" 2>/dev/null && pwd -P)" ||
    die "run worktree Git directory cannot be resolved"
  [[ -n "$common" && "$git_dir" != "$common" ]] ||
    die "ticket workdir must be a linked worktree"
  branch="$(git -C "$RESOLVED_WORKDIR" symbolic-ref --quiet --short HEAD 2>/dev/null)" ||
    die "ticket worktree must be on a non-detached branch"
  [[ "$branch" == "$expected" ]] ||
    die "worktree branch does not match the requested ticket"
  if [[ "$allow_dirty" -ne 1 ]] &&
     [[ "$CONTRACT_VERSION" == "1.2.0" || "$CONTRACT_VERSION" == "1.3.0" ||
        "$CONTRACT_VERSION" == "1.4.0" || "$CONTRACT_VERSION" == "1.5.0" ||
        "$CONTRACT_VERSION" == "1.6.0" || "$CONTRACT_VERSION" == "1.7.0" || "$CONTRACT_VERSION" == "1.8.0" ||
        "$CONTRACT_VERSION" == "2.0.0" ]]; then
    worktree_status="$(git -C "$RESOLVED_WORKDIR" status --porcelain \
      --untracked-files=all --ignore-submodules=none)" ||
      die "ticket worktree cannot be inspected"
    [[ -z "$worktree_status" ]] ||
      die "ticket worktree must be clean"
  fi
}

role_is_allowed() {
  printf '%s\n' "$ROLE_WHITELIST" | grep -Fqx "$1"
}

resolve_prompt_path() {
  local raw="$1" role="$2" raw_dir expected
  case "$raw" in
    /*) ;;
    *) die "prompt path must be absolute" ;;
  esac
  case "$raw" in
    *'`'*|*'$('*|*$'\n'*|*$'\r'*|*$'\t'*)
      die "prompt path contains unsafe characters"
      ;;
    *'/../'*|*/..|*'/./'*|*/.|*//*)
      die "prompt path contains path traversal"
      ;;
  esac
  require_managed_file "$raw" "run prompt"
  raw_dir="$(cd "$(dirname "$raw")" 2>/dev/null && pwd -P)" ||
    die "prompt path cannot be resolved"
  RESOLVED_PROMPT="$raw_dir/$(basename "$raw")"
  expected="$RELEASE_PATH/roles/$role.md"
  require_managed_file "$expected" "canonical release prompt"
  [[ "$RESOLVED_PROMPT" == "$expected" ]] ||
    die "prompt path is not the canonical release role prompt"
}

wrap_json_command() {
  local schema="$1" command_name="$2" ticket="$3" script="$4"
  local output rc=0 json_rc=0
  shift 4
  require_managed_file "$script" "active release $command_name helper"
  RAW_OUTPUT_FILE="$TREE_TMP/raw-output"
  : > "$RAW_OUTPUT_FILE" || die "cannot allocate command output"
  output="$RAW_OUTPUT_FILE"
  run_selected_helper "$script" "$@" > "$output" 2>&1 || rc=$?
  "$PYTHON_BIN" -I -S - "$schema" "$CONTRACT_VERSION" "$PROJECT" "$ticket" \
    "$command_name" "$rc" "$output" <<'PY'
import json
import re
import sys

schema, contract, project, ticket, command, exit_code, path = sys.argv[1:]
text = open(path, encoding="utf-8", errors="replace").read()

SENSITIVE = r"[A-Za-z0-9_.-]*(?:key|token|secret|password|url|dsn|conn|auth)[A-Za-z0-9_.-]*"
text = text.replace("\x00", "")
text = re.sub(
    r"(?im)(authorization\s*:\s*)(?:bearer|basic|token)?\s*[^\r\n]*",
    lambda match: match.group(1) + "[redacted]",
    text,
)
text = re.sub(r"(?i)\b[A-Za-z][A-Za-z0-9+.-]*://[^\s]+", "[redacted-url]", text)
quoted = re.compile(
    rf"(?is)(?P<prefix>[\"']?{SENSITIVE}[\"']?\s*[:=]\s*)"
    rf"(?P<quote>[\"'])(?:\\.|(?!(?P=quote)).)*(?P=quote)"
)
text = quoted.sub(lambda match: match.group("prefix") + "[redacted]", text)
key_line = re.compile(
    rf"(?i)^(?P<prefix>.*?[\"']?{SENSITIVE}[\"']?\s*[:=]\s*)(?P<value>.*)$"
)
redacted_lines = []
continuation_indent = None
for line in text.splitlines(keepends=True):
    content = line.rstrip("\r\n")
    ending = line[len(content):]
    indent = len(content) - len(content.lstrip(" \t"))
    if continuation_indent is not None:
        if not content.strip() or indent > continuation_indent:
            redacted_lines.append(content[:indent] + "[redacted]" + ending)
            continue
        continuation_indent = None
    match = key_line.match(content)
    if match:
        value = match.group("value").strip()
        redacted_lines.append(match.group("prefix") + "[redacted]" + ending)
        if value in ("", "|", ">", "|-", ">-"):
            continuation_indent = indent
        continue
    redacted_lines.append(line)
text = "".join(redacted_lines)
rc = int(exit_code)
value = {
    "schema": schema,
    "schema_version": 1,
    "contract_version": contract,
    "command": command,
    "project": project,
    "ticket": ticket,
    "status": "ok" if rc == 0 else "error",
    "exit_code": rc,
    "output": text,
}
if command == "next-stage":
    first = next((line.strip() for line in text.splitlines() if line.strip()), "")
    action, _, detail = first.partition(" ")
    value["action"] = action or None
    value["detail"] = detail or None
print(json.dumps(value, indent=2, sort_keys=True))
PY
  json_rc=$?
  rm -f "$output"
  RAW_OUTPUT_FILE=""
  [[ "$json_rc" -eq 0 ]] || return 1
  return "$rc"
}

case "$COMMAND" in
  contract)
    require_exact "--json" "$@"
    cleanup_runtime
    trap - EXIT HUP INT TERM
    exec "$PYTHON_BIN" -I -S - "$CONTRACT_FILE" <<'PY'
import json
import sys
with open(sys.argv[1], encoding="utf-8") as handle:
    value = json.load(handle)
print(json.dumps(value, indent=2, sort_keys=True))
PY
    ;;
  doctor)
    require_exact "--json" "$@"
    DOCTOR="$RELEASE_PATH/scripts/factory-doctor.sh"
    require_managed_file "$DOCTOR" "active release doctor"
    if [[ "$QUALIFICATION_MODE" == "takeover" ]]; then
      DOCTOR_CONTROLLER_STATE="$TAKEOVER_KITS_ROOT/projects/$PROJECT/controller"
    elif [[ "$QUALIFICATION_LAUNCHER" == "1" ]]; then
      DOCTOR_CONTROLLER_STATE="$ACTIVE_CONTROLLER_STATE"
    else
      DOCTOR_CONTROLLER_STATE="$KITS_ROOT/projects/$PROJECT/controller"
    fi
    if [[ -e "$DOCTOR_CONTROLLER_STATE" ]]; then
      require_managed_directory "$DOCTOR_CONTROLLER_STATE" "controller state directory"
      HELPER_ENV+=("FACTORY_CONTROLLER_STATE_DIR=$DOCTOR_CONTROLLER_STATE")
    fi
    cleanup_runtime
    trap - EXIT HUP INT TERM
    exec_selected_helper "$DOCTOR" --json --project "$PROJECT" \
      --kit-dir "$RELEASE_PATH" --product-root "$PRODUCT_ROOT" --kit-sha "$KIT_SHA"
    ;;
  reconcile)
    [[ "$ACTIVE_CONTRACT" == "1.8.0" || "$ACTIVE_CONTRACT" == "2.0.0" ]] ||
      die "deterministic reconciliation requires contract 1.8.0 or newer"
    require_exact "--json" "$@"
    controller_state_dir
    CONTROLLER="$RELEASE_PATH/scripts/factory-controller.py"
    require_managed_file "$CONTROLLER" "active release controller"
    CONTROLLER_ENV=("${HELPER_ENV[@]}")
    if [[ "$ISOLATED_TEST_LAUNCHER" == "1" ]]; then
      CONTROLLER_ENV+=(
        "FACTORY_LAUNCH_TEST_MODE=1"
        "FACTORY_LAUNCH_TEST_HOME=$HOME"
        "FACTORY_KITS_ROOT=$KITS_ROOT"
      )
    fi
    cleanup_runtime
    trap - EXIT HUP INT TERM
    exec "${CONTROLLER_ENV[@]}" "$PYTHON_BIN" -I -S "$CONTROLLER" \
      --launcher "$SELF_PATH" \
      --project "$PROJECT" \
      --product-root "$PRODUCT_ROOT" \
      --release-path "$RELEASE_PATH" \
      --state-dir "$CONTROLLER_STATE_DIR"
    ;;
  incident-report)
    [[ "$QUALIFICATION_LAUNCHER" -eq 0 ]] ||
      die "automatic incident reporting is production-only"
    [[ "$ACTIVE_CONTRACT" == "1.8.0" || "$ACTIVE_CONTRACT" == "2.0.0" ]] ||
      die "automatic incident reporting requires contract 1.8.0 or newer"
    [[ $# -eq 3 && "$1" == "--repo" &&
       "$2" =~ ^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$ && "$3" == "--json" ]] || usage
    controller_state_dir
    INCIDENT_REPORTER="$RELEASE_PATH/scripts/factory-incident-reporter.py"
    require_managed_file "$INCIDENT_REPORTER" "active release incident reporter"
    cleanup_runtime
    trap - EXIT HUP INT TERM
    exec "${HELPER_ENV[@]}" "$PYTHON_BIN" -I -S "$INCIDENT_REPORTER" \
      --project "$PROJECT" --repo "$2" \
      --state-dir "$CONTROLLER_STATE_DIR" --json
    ;;
  watch)
    [[ "$ACTIVE_CONTRACT" == "1.8.0" || "$ACTIVE_CONTRACT" == "2.0.0" ]] ||
      die "operator event watch requires contract 1.8.0 or newer"
    WATCH_ARGS=() WATCH_JSON=0 WATCH_CURSOR=0 WATCH_LIMIT=0 WATCH_IDLE=0
    while [[ $# -gt 0 ]]; do
      case "$1" in
        --json)
          [[ "$WATCH_JSON" -eq 0 ]] || usage
          WATCH_JSON=1
          WATCH_ARGS+=(--json)
          shift
          ;;
        --cursor)
          [[ "$WATCH_CURSOR" -eq 0 && $# -ge 2 &&
             "${#2}" -le 1024 && "$2" =~ ^[A-Za-z0-9_-]+$ ]] || usage
          WATCH_CURSOR=1
          WATCH_ARGS+=(--cursor "$2")
          shift 2
          ;;
        --limit)
          [[ "$WATCH_LIMIT" -eq 0 && $# -ge 2 &&
             "$2" =~ ^[0-9]{1,4}$ ]] || usage
          WATCH_LIMIT=1
          WATCH_ARGS+=(--limit "$2")
          shift 2
          ;;
        --idle-timeout-seconds)
          [[ "$WATCH_IDLE" -eq 0 && $# -ge 2 &&
             "$2" =~ ^[0-9]{1,4}([.][0-9]{1,3})?$ ]] || usage
          WATCH_IDLE=1
          WATCH_ARGS+=(--idle-timeout-seconds "$2")
          shift 2
          ;;
        *) usage ;;
      esac
    done
    [[ "$WATCH_JSON" -eq 1 ]] || usage
    controller_state_dir
    WATCH_HELPER="$RELEASE_PATH/scripts/operator-event-watch.py"
    require_managed_file "$WATCH_HELPER" "active release operator event watch"
    cleanup_runtime
    trap - EXIT HUP INT TERM
    exec /usr/bin/env -i "HOME=$HOME" "PATH=$SAFE_PATH" "TMPDIR=$SAFE_TMPDIR" \
      "$PYTHON_BIN" -I -S "$WATCH_HELPER" \
      --state-dir "$CONTROLLER_STATE_DIR" --project "$PROJECT" "${WATCH_ARGS[@]}"
    ;;
  ticket-control)
    [[ "$ACTIVE_CONTRACT" == "1.8.0" || "$ACTIVE_CONTRACT" == "2.0.0" ]] ||
      die "ticket control requires contract 1.8.0 or newer"
    CONTROL_ARGS=()
    if [[ $# -eq 6 && "$1" == "pause" && "$2" == "--ticket" &&
          "$3" =~ ^T-[0-9]+$ && "$4" == "--issue" &&
          "$5" =~ ^https://github[.]com/[A-Za-z0-9_.-]+/software-factory/issues/[1-9][0-9]*$ &&
          "$6" == "--json" ]]; then
      CONTROL_ARGS=(--action pause --ticket "$3" --issue "$5")
    elif [[ $# -eq 6 && "$1" == "resume" && "$2" == "--ticket" &&
            "$3" =~ ^T-[0-9]+$ && "$4" == "--factory-sha" &&
            "$5" =~ ^[0-9a-f]{40}$ && "$6" == "--json" ]]; then
      CONTROL_ARGS=(--action resume --ticket "$3" --factory-sha "$5")
    elif [[ $# -eq 6 && "$1" == "retry-preview" &&
            "$2" == "--ticket" && "$3" =~ ^T-[0-9]+$ &&
            "$4" == "--operator-id" &&
            "$5" =~ ^[A-Za-z0-9][A-Za-z0-9._-]{0,99}$ &&
            "$5" != "auto" && "$6" == "--json" ]]; then
      CONTROL_ARGS=(
        --action preview-timeout-retry --ticket "$3" --operator-id "$5"
      )
    elif [[ $# -eq 11 && "$1" == "authorize-round" && "$2" == "plan" &&
            "$3" == "--ticket" && "$4" =~ ^T-[0-9]+$ &&
            "$5" == "--role" &&
            "$6" =~ ^(planner|spec-linter|test-author|builder|narrator)$ &&
            "$7" == "--round" && "$8" =~ ^[1-9][0-9]*$ &&
            "$9" == "--operator-id" &&
            "${10}" =~ ^[A-Za-z0-9][A-Za-z0-9._-]{0,99}$ &&
            "${10}" != "auto" && "${11}" == "--json" ]]; then
      CONTROL_ARGS=(
        --action authorize-round-plan --ticket "$4" --role "$6"
        --semantic-round "$8" --operator-id "${10}"
      )
    elif [[ $# -eq 13 && "$1" == "authorize-round" && "$2" == "apply" &&
            "$3" == "--ticket" && "$4" =~ ^T-[0-9]+$ &&
            "$5" == "--role" &&
            "$6" =~ ^(planner|spec-linter|test-author|builder|narrator)$ &&
            "$7" == "--round" && "$8" =~ ^[1-9][0-9]*$ &&
            "$9" == "--operator-id" &&
            "${10}" =~ ^[A-Za-z0-9][A-Za-z0-9._-]{0,99}$ &&
            "${10}" != "auto" && "${11}" == "--approve-hash" &&
            "${12}" =~ ^[0-9a-f]{64}$ && "${13}" == "--json" ]]; then
      CONTROL_ARGS=(
        --action authorize-round-apply --ticket "$4" --role "$6"
        --semantic-round "$8" --operator-id "${10}"
        --approve-hash "${12}"
      )
    elif [[ $# -eq 9 && "$1" == "reviewer-void" && "$2" == "plan" &&
            "$3" == "--ticket" && "$4" =~ ^T-[0-9]+$ &&
            "$5" == "--run" && "$6" =~ ^[1-9][0-9]*$ &&
            "$7" == "--operator-id" &&
            "$8" =~ ^[A-Za-z0-9][A-Za-z0-9._-]{0,99}$ &&
            "$8" != "auto" && "$9" == "--json" ]]; then
      CONTROL_ARGS=(
        --action reviewer-void-plan --ticket "$4" --run-ordinal "$6"
        --operator-id "$8"
      )
    elif [[ $# -eq 11 && "$1" == "reviewer-void" && "$2" == "apply" &&
            "$3" == "--ticket" && "$4" =~ ^T-[0-9]+$ &&
            "$5" == "--run" && "$6" =~ ^[1-9][0-9]*$ &&
            "$7" == "--operator-id" &&
            "$8" =~ ^[A-Za-z0-9][A-Za-z0-9._-]{0,99}$ &&
            "$8" != "auto" && "$9" == "--approve-hash" &&
            "${10}" =~ ^[0-9a-f]{64}$ && "${11}" == "--json" ]]; then
      CONTROL_ARGS=(
        --action reviewer-void-apply --ticket "$4" --run-ordinal "$6"
        --operator-id "$8" --approve-hash "${10}"
      )
    else
      usage
    fi
    controller_state_dir
    CONTROLLER="$RELEASE_PATH/scripts/factory-controller.py"
    require_managed_file "$CONTROLLER" "active release controller"
    cleanup_runtime
    trap - EXIT HUP INT TERM
    exec "${HELPER_ENV[@]}" "$PYTHON_BIN" -I -S "$CONTROLLER" \
      --launcher "$SELF_PATH" \
      --project "$PROJECT" \
      --product-root "$PRODUCT_ROOT" \
      --release-path "$RELEASE_PATH" \
      --state-dir "$CONTROLLER_STATE_DIR" \
      "${CONTROL_ARGS[@]}"
    ;;
  qualification)
    [[ "$ACTIVE_CONTRACT" == "1.8.0" || "$ACTIVE_CONTRACT" == "2.0.0" ]] ||
      die "qualification reduction requires contract 1.8.0 or newer"
    require_exact "--json" "$@"
    controller_state_dir
    QUALIFICATION_REDUCER="$RELEASE_PATH/scripts/qualification-reducer.py"
    require_managed_file "$QUALIFICATION_REDUCER" "active release qualification reducer"
    cleanup_runtime
    trap - EXIT HUP INT TERM
    exec "${HELPER_ENV[@]}" "$PYTHON_BIN" -I -S "$QUALIFICATION_REDUCER" \
      --product-root "$PRODUCT_ROOT" \
      --state-dir "$CONTROLLER_STATE_DIR" \
      --kit-dir "$RELEASE_PATH"
    ;;
  dispatch-plan)
    [[ "$ACTIVE_CONTRACT" == "1.6.0" || "$ACTIVE_CONTRACT" == "1.7.0" || "$ACTIVE_CONTRACT" == "1.8.0" ||
       "$ACTIVE_CONTRACT" == "2.0.0" ]] ||
      die "autonomous dispatch requires contract 1.6.0 or newer"
    [[ $# -ge 2 && ( "$1" == "--shadow" || "$1" == "--claim" ) ]] || usage
    ACTION="${1#--}"
    shift
    DISPATCH_ARGS=()
    while [[ $# -gt 1 ]]; do
      case "$1" in
        --exclude-ticket)
          [[ "$2" =~ ^T-[0-9]+$ ]] || usage
          DISPATCH_ARGS+=(--exclude-ticket "$2")
          shift 2
          ;;
        *) usage ;;
      esac
    done
    require_exact "--json" "$@"
    DISPATCH_ARGS+=("$ACTION")
    DISPATCH_HELPER="$RELEASE_PATH/scripts/dispatch-plan.py"
    require_managed_file "$DISPATCH_HELPER" "active release dispatch planner"
    if [[ "$QUALIFICATION_LAUNCHER" == "1" ]]; then
      WORKTREE_PARENT="$KITS_ROOT/worktrees"
    else
      WORKTREE_PARENT="$HOME/.factory/worktrees"
    fi
    WORKTREE_ROOT="$WORKTREE_PARENT/$PROJECT"
    if [[ "$ACTION" == "claim" ]]; then
      mkdir -p "$WORKTREE_ROOT" || die "cannot create trusted worktree root"
      chmod 700 "$WORKTREE_PARENT" "$WORKTREE_ROOT" ||
        die "cannot secure trusted worktree root"
      require_managed_directory "$WORKTREE_PARENT" "trusted worktree parent"
      require_managed_directory "$WORKTREE_ROOT" "trusted project worktree root"
    fi
    if [[ "$ACTIVE_CONTRACT" == "1.8.0" || "$ACTIVE_CONTRACT" == "2.0.0" ]]; then
      controller_state_dir
      HELPER_ENV+=("FACTORY_CONTROLLER_STATE_DIR=$CONTROLLER_STATE_DIR")
    fi
    add_certified_origin_env
    cleanup_runtime
    trap - EXIT HUP INT TERM
    exec "${HELPER_ENV[@]}" "$PYTHON_BIN" -I -S "$DISPATCH_HELPER" \
      --factory-root "$PRODUCT_ROOT" \
      --worktree-root "$WORKTREE_ROOT" \
      "${DISPATCH_ARGS[@]}"
    ;;
  state-machine)
    [[ "$ACTIVE_CONTRACT" == "1.8.0" || "$ACTIVE_CONTRACT" == "2.0.0" ]] ||
      die "deterministic state-machine requires contract 1.8.0 or newer"
    STATE_ACTION="next" STATE_EXPECTED_HEAD="" TRANSITION_RECEIPT=""
    if [[ "${1:-}" == "block" && $# -eq 10 &&
          "$2" == "--ticket" && "$4" == "--lease" &&
          "$6" == "--receipt" && "$8" == "--workdir" &&
          "${10}" == "--json" ]]; then
      STATE_ACTION="$1" TICKET="$3" LEASE_ID="$5"
      TRANSITION_RECEIPT="$7" TICKET_WORKDIR="$9"
    elif [[ "${1:-}" =~ ^(repair-check|resume)$ && $# -eq 8 &&
            "$2" == "--ticket" && "$4" == "--receipt" &&
            "$6" == "--workdir" && "$8" == "--json" ]]; then
      STATE_ACTION="$1" TICKET="$3" LEASE_ID=""
      TRANSITION_RECEIPT="$5" TICKET_WORKDIR="$7"
    elif [[ $# -eq 9 && "$1" == "--ticket" && "$3" == "--lease" &&
            "$5" == "--workdir" && "$7" == "--expected-head" &&
            "$9" == "--json" ]]; then
      TICKET="$2" LEASE_ID="$4" TICKET_WORKDIR="$6"
      STATE_EXPECTED_HEAD="$8"
    else
      validate_ticket_command "$@"
    fi
    [[ "$TICKET" =~ ^T-[0-9]+$ ]] || die "invalid ticket identifier"
    [[ -z "$TRANSITION_RECEIPT" ||
       "$TRANSITION_RECEIPT" =~ ^[0-9a-f]{64}$ ]] ||
      die "invalid transition receipt"
    [[ -z "$LEASE_ID" || "$LEASE_ID" =~ ^[0-9a-f]{64}$ ]] ||
      die "invalid dispatcher lease"
    [[ -z "$STATE_EXPECTED_HEAD" || "$STATE_EXPECTED_HEAD" =~ ^[0-9a-f]{40}$ ]] ||
      die "invalid expected state-machine head"
    resolve_product_workdir "$TICKET_WORKDIR"
    validate_ticket_worktree "$TICKET"
    TICKET_WORKDIR="$RESOLVED_WORKDIR"
    add_dispatch_lease_env "$LEASE_ID"
    add_certified_origin_env
    controller_state_dir
    STATE_MACHINE="$RELEASE_PATH/scripts/state-machine.py"
    require_managed_file "$STATE_MACHINE" "active release state-machine"
    STATE_ARGS=(
      "$STATE_ACTION"
      --factory-root "$PRODUCT_ROOT"
      --workdir "$TICKET_WORKDIR"
      --kit-dir "$RELEASE_PATH"
      --state-dir "$CONTROLLER_STATE_DIR"
      --ticket "$TICKET"
      --contract-version "$CONTRACT_VERSION"
      --factory-sha "$KIT_SHA"
      --project "$PROJECT"
    )
    [[ -z "$LEASE_ID" ]] || STATE_ARGS+=(--lease "$LEASE_ID")
    [[ -z "$TRANSITION_RECEIPT" ]] ||
      STATE_ARGS+=(--receipt "$TRANSITION_RECEIPT")
    [[ -z "$STATE_EXPECTED_HEAD" ]] ||
      STATE_ARGS+=(--expected-head "$STATE_EXPECTED_HEAD")
    cleanup_runtime
    trap - EXIT HUP INT TERM
    exec "${HELPER_ENV[@]}" "$PYTHON_BIN" -I -S \
      "$STATE_MACHINE" "${STATE_ARGS[@]}"
    ;;
  emergency-admit)
    [[ "$ACTIVE_CONTRACT" == "1.8.0" || "$ACTIVE_CONTRACT" == "2.0.0" ]] ||
      die "emergency role admission requires contract 1.8.0 or newer"
    EMERGENCY_ACTION="${1:-}" EMERGENCY_REQUEST="" EMERGENCY_APPROVE_HASH=""
    if [[ "$EMERGENCY_ACTION" == "plan" && $# -eq 12 &&
          "$2" == "--ticket" && "$4" == "--role" &&
          "$6" == "--receipt" && "$8" == "--workdir" &&
          "${10}" == "--request" && "${12}" == "--json" ]]; then
      TICKET="$3" EMERGENCY_ROLE="$5" TRANSITION_RECEIPT="$7"
      TICKET_WORKDIR="$9" EMERGENCY_REQUEST="${11}"
    elif [[ "$EMERGENCY_ACTION" == "apply" && $# -eq 14 &&
            "$2" == "--ticket" && "$4" == "--role" &&
            "$6" == "--receipt" && "$8" == "--workdir" &&
            "${10}" == "--request" && "${12}" == "--approve-hash" &&
            "${14}" == "--json" ]]; then
      TICKET="$3" EMERGENCY_ROLE="$5" TRANSITION_RECEIPT="$7"
      TICKET_WORKDIR="$9" EMERGENCY_REQUEST="${11}"
      EMERGENCY_APPROVE_HASH="${13}"
      [[ "$EMERGENCY_APPROVE_HASH" =~ ^[0-9a-f]{64}$ ]] ||
        die "invalid emergency admission approval hash"
    elif [[ "$EMERGENCY_ACTION" == "archive" && $# -eq 10 &&
            "$2" == "--ticket" && "$4" == "--role" &&
            "$6" == "--receipt" && "$8" == "--workdir" &&
            "${10}" == "--json" ]]; then
      TICKET="$3" EMERGENCY_ROLE="$5" TRANSITION_RECEIPT="$7"
      TICKET_WORKDIR="$9"
    else
      usage
    fi
    [[ "$TICKET" =~ ^T-[0-9]+$ ]] || die "invalid ticket identifier"
    role_is_allowed "$EMERGENCY_ROLE" ||
      die "emergency admission role is not allowed by the active contract"
    [[ "$TRANSITION_RECEIPT" =~ ^[0-9a-f]{64}$ ]] ||
      die "invalid transition receipt"
    resolve_product_workdir "$TICKET_WORKDIR"
    validate_ticket_worktree "$TICKET"
    TICKET_WORKDIR="$RESOLVED_WORKDIR"
    if [[ -n "$EMERGENCY_REQUEST" ]]; then
      [[ "$EMERGENCY_REQUEST" == /* ]] ||
        die "emergency admission request must be absolute"
      require_managed_file "$EMERGENCY_REQUEST" "emergency admission request"
    fi
    add_certified_origin_env
    controller_state_dir
    EMERGENCY_HELPER="$RELEASE_PATH/scripts/emergency-admit.py"
    require_managed_file "$EMERGENCY_HELPER" "active release emergency admission helper"
    EMERGENCY_ARGS=(
      "$EMERGENCY_ACTION" --factory-root "$PRODUCT_ROOT"
      --workdir "$TICKET_WORKDIR" --kit-dir "$RELEASE_PATH"
      --state-dir "$CONTROLLER_STATE_DIR" --ticket "$TICKET"
      --contract-version "$CONTRACT_VERSION" --factory-sha "$KIT_SHA"
      --project "$PROJECT" --receipt "$TRANSITION_RECEIPT"
      --role "$EMERGENCY_ROLE"
    )
    [[ -z "$EMERGENCY_REQUEST" ]] ||
      EMERGENCY_ARGS+=(--request "$EMERGENCY_REQUEST")
    [[ -z "$EMERGENCY_APPROVE_HASH" ]] ||
      EMERGENCY_ARGS+=(--approve-hash "$EMERGENCY_APPROVE_HASH")
    cleanup_runtime
    trap - EXIT HUP INT TERM
    exec "${HELPER_ENV[@]}" "$PYTHON_BIN" -I -S \
      "$EMERGENCY_HELPER" "${EMERGENCY_ARGS[@]}"
    ;;
  passport)
    [[ "$ACTIVE_CONTRACT" == "1.8.0" || "$ACTIVE_CONTRACT" == "2.0.0" ]] ||
      die "portable passports require contract 1.8.0 or newer"
    PASSPORT_ACTION="${1:-}"
    PASSPORT_EXPECTED_HEAD="" PASSPORT_RECEIPT=""
    PASSPORT_PUBLICATION="preserve" PASSPORT_RUN_ID=""
    if [[ "$PASSPORT_ACTION" == "export" && $# -eq 10 &&
          "$2" == "--ticket" && "$4" == "--receipt" &&
          "$6" == "--publication-state" && "$8" == "--workdir" &&
          "${10}" == "--json" ]]; then
      TICKET="$3" PASSPORT_RECEIPT="$5" PASSPORT_PUBLICATION="$7"
      TICKET_WORKDIR="$9"
      [[ "$PASSPORT_RECEIPT" =~ ^[0-9a-f]{64}$ ]] ||
        die "invalid transition receipt"
      [[ "$PASSPORT_PUBLICATION" =~ ^(none|validating|ready|merge-pending|merged|repair)$ ]] ||
        die "invalid publication state"
    elif [[ ( "$PASSPORT_ACTION" == "correct-converged-success" ||
              "$PASSPORT_ACTION" == "recover-model-identity-success" ||
              "$PASSPORT_ACTION" == "verify-model-identity-success" ) && $# -eq 10 &&
            "$2" == "--ticket" && "$4" == "--receipt" &&
            "$6" == "--run-id" && "$8" == "--workdir" &&
            "${10}" == "--json" ]]; then
      TICKET="$3" PASSPORT_RECEIPT="$5" PASSPORT_RUN_ID="$7"
      TICKET_WORKDIR="$9"
      [[ "$PASSPORT_RECEIPT" =~ ^[0-9a-f]{64}$ ]] ||
        die "invalid transition receipt"
      [[ "$PASSPORT_RUN_ID" =~ ^[A-Za-z0-9._-]{1,200}$ ]] ||
        die "invalid run identifier"
    elif [[ "$PASSPORT_ACTION" == "migrate" && ( $# -eq 8 || $# -eq 10 ) &&
            "$2" == "--ticket" && "$4" == "--publication-state" &&
            "$6" == "--workdir" &&
            ( $# -eq 8 && "$8" == "--json" ||
              $# -eq 10 && "$8" == "--expected-head" &&
              "${10}" == "--json" ) ]]; then
      TICKET="$3" PASSPORT_PUBLICATION="$5" TICKET_WORKDIR="$7"
      [[ $# -eq 8 ]] || PASSPORT_EXPECTED_HEAD="$9"
      [[ "$PASSPORT_PUBLICATION" =~ ^(preserve|none|validating|ready|merge-pending|merged|repair)$ ]] ||
        die "invalid publication state"
      [[ -z "$PASSPORT_EXPECTED_HEAD" || "$PASSPORT_EXPECTED_HEAD" =~ ^[0-9a-f]{40}$ ]] ||
        die "invalid expected passport head"
    elif [[ "$PASSPORT_ACTION" == "validate" && $# -eq 6 &&
            "$2" == "--ticket" && "$4" == "--workdir" && "$6" == "--json" ]]; then
      TICKET="$3" TICKET_WORKDIR="$5"
    else
      usage
    fi
    [[ "$TICKET" =~ ^T-[0-9]+$ ]] || die "invalid ticket identifier"
    resolve_product_workdir "$TICKET_WORKDIR"
    validate_ticket_worktree "$TICKET"
    TICKET_WORKDIR="$RESOLVED_WORKDIR"
    add_certified_origin_env
    controller_state_dir
    PASSPORT_HELPER="$RELEASE_PATH/scripts/ticket-passport.py"
    require_managed_file "$PASSPORT_HELPER" "active release passport helper"
    PASSPORT_ARGS=(
      "$PASSPORT_ACTION"
      --factory-root "$PRODUCT_ROOT"
      --workdir "$TICKET_WORKDIR"
      --state-dir "$CONTROLLER_STATE_DIR"
      --ticket "$TICKET"
      --contract-version "$CONTRACT_VERSION"
      --factory-sha "$KIT_SHA"
      --project "$PROJECT"
    )
    if [[ "$PASSPORT_ACTION" == "correct-converged-success" ||
          "$PASSPORT_ACTION" == "recover-model-identity-success" ||
          "$PASSPORT_ACTION" == "verify-model-identity-success" ]]; then
      PASSPORT_ARGS+=(
        --receipt "$PASSPORT_RECEIPT"
        --run-id "$PASSPORT_RUN_ID"
      )
    elif [[ "$PASSPORT_ACTION" == "export" ]]; then
      PASSPORT_ARGS+=(
        --receipt "$PASSPORT_RECEIPT"
        --publication-state "$PASSPORT_PUBLICATION"
      )
    elif [[ "$PASSPORT_ACTION" == "migrate" ]]; then
      PASSPORT_ARGS+=(--publication-state "$PASSPORT_PUBLICATION")
      [[ -z "$PASSPORT_EXPECTED_HEAD" ]] ||
        PASSPORT_ARGS+=(--expected-head "$PASSPORT_EXPECTED_HEAD")
    fi
    cleanup_runtime
    trap - EXIT HUP INT TERM
    exec "${HELPER_ENV[@]}" "$PYTHON_BIN" -I -S \
      "$PASSPORT_HELPER" "${PASSPORT_ARGS[@]}"
    ;;
  publication)
    [[ "$ACTIVE_CONTRACT" == "1.8.0" || "$ACTIVE_CONTRACT" == "2.0.0" ]] ||
      die "publication leases require contract 1.8.0 or newer"
    PUBLICATION_ACTION="${1:-}"
    if [[ ( "$PUBLICATION_ACTION" == "ready" ||
            "$PUBLICATION_ACTION" == "acquire" ) &&
          $# -eq 8 && "$2" == "--ticket" && "$4" == "--head" &&
          "$6" == "--priority" && "$8" == "--json" ]]; then
      TICKET="$3" PUBLICATION_HEAD="$5" PUBLICATION_PRIORITY="$7"
      [[ "$PUBLICATION_HEAD" =~ ^[0-9a-f]{40}$ ]] ||
        die "invalid publication head"
      [[ "$PUBLICATION_PRIORITY" =~ ^(urgent|high|normal|low|none)$ ]] ||
        die "invalid publication priority"
      PUBLICATION_ARGS=(
        "$PUBLICATION_ACTION" --ticket "$TICKET"
        --head "$PUBLICATION_HEAD" --priority "$PUBLICATION_PRIORITY"
      )
    elif [[ "$PUBLICATION_ACTION" == "release" && $# -eq 6 &&
            "$2" == "--ticket" && "$4" == "--lease" && "$6" == "--json" ]]; then
      TICKET="$3" PUBLICATION_LEASE="$5"
      [[ "$PUBLICATION_LEASE" =~ ^[0-9a-f]{64}$ ]] ||
        die "invalid publication lease"
      PUBLICATION_ARGS=(
        release --ticket "$TICKET" --lease "$PUBLICATION_LEASE"
      )
    elif [[ "$PUBLICATION_ACTION" == "withdraw" && $# -eq 4 &&
            "$2" == "--ticket" && "$4" == "--json" ]]; then
      TICKET="$3"
      PUBLICATION_ARGS=(withdraw --ticket "$TICKET")
    else
      usage
    fi
    [[ "$TICKET" =~ ^T-[0-9]+$ ]] || die "invalid ticket identifier"
    controller_state_dir
    PUBLICATION_HELPER="$RELEASE_PATH/scripts/publication-lease.py"
    require_managed_file "$PUBLICATION_HELPER" "active release publication helper"
    cleanup_runtime
    trap - EXIT HUP INT TERM
    exec "${HELPER_ENV[@]}" "$PYTHON_BIN" -I -S \
      "$PUBLICATION_HELPER" "${PUBLICATION_ARGS[@]}" \
      --state-dir "$CONTROLLER_STATE_DIR"
    ;;
  publication-repair)
    [[ "$ACTIVE_CONTRACT" == "1.8.0" || "$ACTIVE_CONTRACT" == "2.0.0" ]] ||
      die "publication repair requires contract 1.8.0 or newer"
    [[ $# -eq 11 && "$1" == "--ticket" && "$3" == "--lease" &&
       "$5" == "--receipt" && "$7" == "--pr" &&
       "$9" == "--workdir" && "${11}" == "--json" ]] || usage
    TICKET="$2" LEASE_ID="$4" TRANSITION_RECEIPT="$6"
    PUBLICATION_PR="$8" TICKET_WORKDIR="${10}"
    [[ "$TICKET" =~ ^T-[0-9]+$ && "$LEASE_ID" =~ ^[0-9a-f]{64}$ &&
       "$TRANSITION_RECEIPT" =~ ^[0-9a-f]{64}$ &&
       "$PUBLICATION_PR" =~ ^[1-9][0-9]*$ ]] ||
      die "invalid publication repair arguments"
    resolve_product_workdir "$TICKET_WORKDIR"
    validate_ticket_worktree "$TICKET"
    TICKET_WORKDIR="$RESOLVED_WORKDIR"
    add_dispatch_lease_env "$LEASE_ID"
    add_certified_origin_env
    transition_receipt verify ||
      die "transition receipt verification failed"
    [[ "$TRANSITION_STAGE" == AWAIT-MERGE\ protected\ auto-merge* ]] ||
      die "transition receipt does not authorize publication repair"
    transition_receipt consume ||
      die "transition receipt consumption failed"
    PUBLICATION_REPAIR="$RELEASE_PATH/scripts/publication-repair.py"
    require_managed_file "$PUBLICATION_REPAIR" "active release publication repair"
    cleanup_runtime
    trap - EXIT HUP INT TERM
    exec "${HELPER_ENV[@]}" "$PYTHON_BIN" -I -S "$PUBLICATION_REPAIR" create \
      --factory-root "$PRODUCT_ROOT" --workdir "$TICKET_WORKDIR" \
      --state-dir "$CONTROLLER_STATE_DIR" --kit-dir "$RELEASE_PATH" \
      --ticket "$TICKET" --factory-sha "$KIT_SHA" --pr "$PUBLICATION_PR"
    ;;
  ci-rerun)
    [[ "$ACTIVE_CONTRACT" == "1.8.0" || "$ACTIVE_CONTRACT" == "2.0.0" ]] ||
      die "targeted CI rerun requires contract 1.8.0 or newer"
    [[ $# -eq 11 && "$1" == "--ticket" && "$3" == "--lease" &&
       "$5" == "--receipt" && "$7" == "--pr" &&
       "$9" == "--workdir" && "${11}" == "--json" ]] || usage
    TICKET="$2" LEASE_ID="$4" TRANSITION_RECEIPT="$6"
    CI_PR="$8" TICKET_WORKDIR="${10}"
    [[ "$TICKET" =~ ^T-[0-9]+$ ]] || die "invalid ticket identifier"
    [[ "$LEASE_ID" =~ ^[0-9a-f]{64}$ ]] || die "invalid dispatcher lease"
    [[ "$TRANSITION_RECEIPT" =~ ^[0-9a-f]{64}$ ]] ||
      die "invalid transition receipt"
    [[ "$CI_PR" =~ ^[1-9][0-9]*$ ]] || die "invalid PR number"
    resolve_product_workdir "$TICKET_WORKDIR"
    validate_ticket_worktree "$TICKET"
    TICKET_WORKDIR="$RESOLVED_WORKDIR"
    add_dispatch_lease_env "$LEASE_ID"
    transition_receipt verify ||
      die "transition receipt verification failed"
    [[ "$TRANSITION_STAGE" == RUN\ reviewer ||
       "$TRANSITION_STAGE" == RUN\ narrator ||
       "$TRANSITION_STAGE" == AWAIT-* ]] ||
      die "transition receipt does not authorize CI inspection"
    controller_state_dir
    CI_RERUN_HELPER="$RELEASE_PATH/scripts/ci-rerun.py"
    require_managed_file "$CI_RERUN_HELPER" "active release CI rerun helper"
    cleanup_runtime
    trap - EXIT HUP INT TERM
    exec "${HELPER_ENV[@]}" "$PYTHON_BIN" -I -S "$CI_RERUN_HELPER" \
      --factory-root "$PRODUCT_ROOT" --state-dir "$CONTROLLER_STATE_DIR" \
      --workdir "$TICKET_WORKDIR" --ticket "$TICKET" --pr "$CI_PR"
    ;;
  ticket-pr)
    [[ "$ACTIVE_CONTRACT" == "1.6.0" || "$ACTIVE_CONTRACT" == "1.7.0" || "$ACTIVE_CONTRACT" == "1.8.0" ||
       "$ACTIVE_CONTRACT" == "2.0.0" ]] ||
      die "early ticket PR requires contract 1.6.0 or newer"
    TICKET_PR_LEASE="" TICKET_PR_RECEIPT=""
    if [[ ( "$CONTRACT_VERSION" == "1.8.0" || "$CONTRACT_VERSION" == "2.0.0" ) && $# -eq 7 &&
          "$1" == "--ticket" && "$3" == "--receipt" &&
          "$5" == "--workdir" && "$7" == "--json" ]]; then
      TICKET_PR_TICKET="$2" TICKET_PR_RECEIPT="$4" TICKET_PR_WORKDIR="$6"
    elif [[ ( "$CONTRACT_VERSION" == "1.8.0" || "$CONTRACT_VERSION" == "2.0.0" ) && $# -eq 9 &&
            "$1" == "--ticket" && "$3" == "--lease" &&
            "$5" == "--receipt" && "$7" == "--workdir" &&
            "$9" == "--json" ]]; then
      TICKET_PR_TICKET="$2" TICKET_PR_LEASE="$4"
      TICKET_PR_RECEIPT="$6" TICKET_PR_WORKDIR="$8"
      [[ "$TICKET_PR_LEASE" =~ ^[0-9a-f]{64}$ ]] || die "invalid dispatcher lease"
    elif [[ "$CONTRACT_VERSION" != "1.8.0" && "$CONTRACT_VERSION" != "2.0.0" && $# -eq 5 &&
            "$1" == "--ticket" && "$3" == "--workdir" &&
          "$5" == "--json" ]]; then
      TICKET_PR_TICKET="$2" TICKET_PR_WORKDIR="$4"
    elif [[ "$CONTRACT_VERSION" != "1.8.0" && "$CONTRACT_VERSION" != "2.0.0" && $# -eq 7 &&
            "$1" == "--ticket" && "$3" == "--lease" &&
            "$5" == "--workdir" && "$7" == "--json" ]]; then
      TICKET_PR_TICKET="$2" TICKET_PR_LEASE="$4" TICKET_PR_WORKDIR="$6"
      [[ "$TICKET_PR_LEASE" =~ ^[0-9a-f]{64}$ ]] || die "invalid dispatcher lease"
    else
      usage
    fi
    [[ "$TICKET_PR_TICKET" =~ ^T-[0-9]+$ ]] || die "invalid ticket identifier"
    if [[ "$CONTRACT_VERSION" == "1.8.0" || "$CONTRACT_VERSION" == "2.0.0" ]]; then
      [[ "$TICKET_PR_RECEIPT" =~ ^[0-9a-f]{64}$ ]] ||
        die "invalid transition receipt"
    fi
    resolve_product_workdir "$TICKET_PR_WORKDIR"
    validate_ticket_worktree "$TICKET_PR_TICKET"
    [[ ! -e "$PRODUCT_ROOT/factory/MAINTENANCE" ]] ||
      die "product is in maintenance; ticket PR refused"
    TICKET_PR_HELPER="$RELEASE_PATH/scripts/ticket-pr.py"
    require_managed_file "$TICKET_PR_HELPER" "active release ticket PR helper"
    add_certified_origin_env
    add_dispatch_lease_env "$TICKET_PR_LEASE"
    if [[ "$CONTRACT_VERSION" == "1.8.0" || "$CONTRACT_VERSION" == "2.0.0" ]]; then
      TICKET="$TICKET_PR_TICKET" LEASE_ID="$TICKET_PR_LEASE"
      TRANSITION_RECEIPT="$TICKET_PR_RECEIPT"
      transition_receipt verify ||
        die "transition receipt verification failed"
      HELPER_ENV+=(
        "FACTORY_TRANSITION_RECEIPT_SHA256=$TRANSITION_RECEIPT"
        "FACTORY_TRANSITION_STAGE=$TRANSITION_STAGE"
      )
    fi
    cleanup_runtime
    trap - EXIT HUP INT TERM
    exec "${HELPER_ENV[@]}" "$PYTHON_BIN" -I -S "$TICKET_PR_HELPER" \
      --ticket "$TICKET_PR_TICKET" \
      --workdir "$RESOLVED_WORKDIR"
    ;;
  models)
    [[ "$CONTRACT_VERSION" == "1.2.0" || "$CONTRACT_VERSION" == "1.3.0" ||
       "$CONTRACT_VERSION" == "1.4.0" || "$CONTRACT_VERSION" == "1.5.0" ||
       "$CONTRACT_VERSION" == "1.6.0" || "$CONTRACT_VERSION" == "1.7.0" || "$CONTRACT_VERSION" == "1.8.0" ||
       "$CONTRACT_VERSION" == "2.0.0" ]] ||
      die "models requires contract 1.2.0 or newer"
    [[ $# -ge 2 ]] || usage
    MODEL_ACTION="$1"
    MODEL_MUTATION=0
    case "$MODEL_ACTION" in
      profiles|status|inventory)
        [[ $# -eq 2 && "$2" == "--json" ]] || usage
        MODEL_ARGS=("$MODEL_ACTION")
        ;;
      qualification-readiness)
        [[ "$QUALIFICATION_LAUNCHER" == "1" &&
           ( "$CONTRACT_VERSION" == "1.8.0" || "$CONTRACT_VERSION" == "2.0.0" ) ]] ||
          die "qualification fallback readiness requires a Contract 1.8 or newer qualification lane"
        [[ $# -eq 2 && "$2" == "--json" ]] || usage
        MODEL_ARGS=("$MODEL_ACTION")
        ;;
      policy-candidates|reviewer-exception-contract)
        [[ "$CONTRACT_VERSION" == "1.5.0" || "$CONTRACT_VERSION" == "1.6.0" ||
           "$CONTRACT_VERSION" == "1.7.0" || "$CONTRACT_VERSION" == "1.8.0" ||
           "$CONTRACT_VERSION" == "2.0.0" ]] ||
          die "$MODEL_ACTION requires contract 1.5.0"
        [[ $# -eq 2 && "$2" == "--json" ]] || usage
        MODEL_ARGS=("$MODEL_ACTION")
        ;;
      ticket-status)
        [[ "$CONTRACT_VERSION" == "1.5.0" || "$CONTRACT_VERSION" == "1.6.0" ||
           "$CONTRACT_VERSION" == "1.7.0" || "$CONTRACT_VERSION" == "1.8.0" ||
           "$CONTRACT_VERSION" == "2.0.0" ]] ||
          die "model ticket status requires contract 1.5.0"
        [[ $# -eq 4 && "$2" == "--ticket" && "$4" == "--json" ]] || usage
        [[ "$3" =~ ^T-[0-9]+$ ]] || die "invalid ticket identifier"
        MODEL_ARGS=("$MODEL_ACTION" --ticket "$3")
        ;;
      policy-preview)
        [[ "$CONTRACT_VERSION" == "1.5.0" || "$CONTRACT_VERSION" == "1.6.0" ||
           "$CONTRACT_VERSION" == "1.7.0" || "$CONTRACT_VERSION" == "1.8.0" ||
           "$CONTRACT_VERSION" == "2.0.0" ]] ||
          die "model policy preview requires contract 1.5.0"
        [[ $# -eq 4 && "$2" == "--policy" && "$4" == "--json" ]] || usage
        [[ ${#3} -le 65536 ]] || die "model policy payload is oversized"
        MODEL_ARGS=("$MODEL_ACTION" --policy "$3")
        ;;
      policy-apply)
        [[ "$CONTRACT_VERSION" == "1.5.0" || "$CONTRACT_VERSION" == "1.6.0" ||
           "$CONTRACT_VERSION" == "1.7.0" || "$CONTRACT_VERSION" == "1.8.0" ||
           "$CONTRACT_VERSION" == "2.0.0" ]] ||
          die "model policy apply requires contract 1.5.0"
        [[ $# -eq 8 && "$2" == "--policy" &&
           "$4" == "--expected-current-hash" &&
           "$6" == "--approve-hash" && "$8" == "--json" ]] || usage
        [[ ${#3} -le 65536 ]] || die "model policy payload is oversized"
        [[ "$5" =~ ^[0-9a-f]{64}$ && "$7" =~ ^[0-9a-f]{64}$ ]] ||
          die "model policy hashes are invalid"
        MODEL_ARGS=("$MODEL_ACTION" --policy "$3" \
          --expected-current-hash "$5" --approve-hash "$7")
        MODEL_MUTATION=1
        ;;
      plan)
        if [[ $# -eq 2 && "$2" == "--json" ]]; then
          MODEL_ARGS=("$MODEL_ACTION")
        elif [[ $# -eq 4 && "$2" == "--profile" && "$4" == "--json" ]]; then
          [[ "$3" =~ ^[a-z0-9][a-z0-9._-]{0,127}$ && "$3" != "auto" ]] ||
            die "invalid model profile identifier"
          MODEL_ARGS=("$MODEL_ACTION" --profile "$3")
        else
          usage
        fi
        ;;
      activate)
        [[ $# -eq 8 && "$2" == "--profile" && "$4" == "--approve-hash" &&
           "$6" == "--approved-by" && "$8" == "--json" ]] || usage
        [[ "$3" =~ ^[a-z0-9][a-z0-9._-]{0,127}$ && "$3" != "auto" ]] ||
          die "invalid model profile identifier"
        [[ "$5" =~ ^[0-9a-f]{64}$ ]] || die "invalid model approval hash"
        [[ "$7" =~ ^[a-z0-9][a-z0-9._-]{0,127}$ && "$7" != "auto" ]] ||
          die "invalid model approver identifier"
        MODEL_ARGS=("$MODEL_ACTION" --profile "$3" --approve-hash "$5" --approved-by "$7")
        MODEL_MUTATION=1
        ;;
      disable)
        [[ $# -eq 12 && "$2" == "--scope-type" && "$4" == "--scope-id" &&
           "$6" == "--reason" && "$8" == "--ttl-seconds" &&
           "${10}" == "--operator-id" && "${12}" == "--json" ]] || usage
        MODEL_SCOPE_TYPE="$3" MODEL_SCOPE_ID="$5"
        [[ "$MODEL_SCOPE_TYPE" =~ ^(account-route|provider-family|model|route)$ ]] ||
          die "invalid model scope type"
        if [[ "$MODEL_SCOPE_TYPE" == "model" ]]; then
          [[ "$MODEL_SCOPE_ID" =~ ^[A-Za-z0-9][A-Za-z0-9._/-]{0,199}$ &&
             "$MODEL_SCOPE_ID" != "auto" ]] || die "invalid model scope identifier"
        else
          [[ "$MODEL_SCOPE_ID" =~ ^[a-z0-9][a-z0-9._-]{0,127}$ &&
             "$MODEL_SCOPE_ID" != "auto" ]] || die "invalid model scope identifier"
        fi
        [[ "$7" == "credits_exhausted" ]] || die "invalid model disable reason"
        [[ "$9" =~ ^[1-9][0-9]{0,5}$ && "$((10#$9))" -le 604800 ]] ||
          die "invalid model disable TTL"
        [[ "${11}" =~ ^[a-z0-9][a-z0-9._-]{0,127}$ && "${11}" != "auto" ]] ||
          die "invalid model operator identifier"
        MODEL_ARGS=("$MODEL_ACTION" --scope-type "$MODEL_SCOPE_TYPE" \
          --scope-id "$MODEL_SCOPE_ID" --reason "$7" --ttl-seconds "$9" \
          --operator-id "${11}")
        MODEL_MUTATION=1
        ;;
      enable)
        [[ $# -eq 6 && "$2" == "--scope-type" && "$4" == "--scope-id" &&
           "$6" == "--json" ]] || usage
        MODEL_SCOPE_TYPE="$3" MODEL_SCOPE_ID="$5"
        [[ "$MODEL_SCOPE_TYPE" =~ ^(account-route|provider-family|model|route)$ ]] ||
          die "invalid model scope type"
        if [[ "$MODEL_SCOPE_TYPE" == "model" ]]; then
          [[ "$MODEL_SCOPE_ID" =~ ^[A-Za-z0-9][A-Za-z0-9._/-]{0,199}$ &&
             "$MODEL_SCOPE_ID" != "auto" ]] || die "invalid model scope identifier"
        else
          [[ "$MODEL_SCOPE_ID" =~ ^[a-z0-9][a-z0-9._-]{0,127}$ &&
             "$MODEL_SCOPE_ID" != "auto" ]] || die "invalid model scope identifier"
        fi
        MODEL_ARGS=("$MODEL_ACTION" --scope-type "$MODEL_SCOPE_TYPE" --scope-id "$MODEL_SCOPE_ID")
        MODEL_MUTATION=1
        ;;
      migrate-batch-plan|migrate-batch)
        [[ "$CONTRACT_VERSION" == "2.0.0" ]] ||
          die "model route migration batches require contract 2.0.0"
        [[ "${!#}" == "--json" ]] || usage
        set -- "${@:1:$(($# - 1))}"
        shift
        MODEL_ARGS=("$MODEL_ACTION")
        MODEL_BATCH_COUNT=0
        if [[ "$MODEL_ACTION" == "migrate-batch" ]]; then
          [[ $# -ge 4 && "$1" == "--approve-hash" &&
             "$3" == "--approved-by" ]] || usage
          [[ "$2" =~ ^[0-9a-f]{64}$ ]] ||
            die "invalid migration batch approval hash"
          [[ "$4" =~ ^[a-z0-9][a-z0-9._-]{0,127}$ && "$4" != "auto" ]] ||
            die "invalid migration batch approver identifier"
          MODEL_ARGS+=(--approve-hash "$2" --approved-by "$4")
          shift 4
          MODEL_MUTATION=1
        fi
        while [[ $# -gt 0 ]]; do
          [[ $# -ge 4 && "$1" == "--ticket" && "$3" == "--workdir" ]] || usage
          [[ "$2" =~ ^T-[0-9]+$ ]] || die "invalid ticket identifier"
          resolve_product_workdir "$4"
          validate_ticket_worktree "$2"
          MODEL_ARGS+=(--ticket "$2" --workdir "$RESOLVED_WORKDIR")
          MODEL_BATCH_COUNT=$((MODEL_BATCH_COUNT + 1))
          shift 4
        done
        [[ "$MODEL_BATCH_COUNT" -ge 1 && "$MODEL_BATCH_COUNT" -le 4 ]] || usage
        add_certified_origin_env
        ;;
      migrate-plan)
        [[ "$CONTRACT_VERSION" == "1.4.0" || "$CONTRACT_VERSION" == "1.5.0" ||
           "$CONTRACT_VERSION" == "1.6.0" || "$CONTRACT_VERSION" == "1.7.0" || "$CONTRACT_VERSION" == "1.8.0" ||
           "$CONTRACT_VERSION" == "2.0.0" ]] ||
          die "model route migration requires contract 1.4.0 or newer"
        [[ ( $# -eq 6 && "$2" == "--ticket" && "$4" == "--workdir" &&
             "$6" == "--json" ) ||
           ( $# -eq 7 && "$2" == "--ticket" && "$4" == "--workdir" &&
             "$6" == "--include-journal" && "$7" == "--json" ) ]] || usage
        [[ "$3" =~ ^T-[0-9]+$ ]] || die "invalid ticket identifier"
        resolve_product_workdir "$5"
        validate_ticket_worktree "$3"
        MODEL_ARGS=("$MODEL_ACTION" --ticket "$3" --workdir "$RESOLVED_WORKDIR")
        [[ $# -eq 6 ]] || MODEL_ARGS+=(--include-journal)
        add_certified_origin_env
        ;;
      migrate)
        [[ "$CONTRACT_VERSION" == "1.4.0" || "$CONTRACT_VERSION" == "1.5.0" ||
           "$CONTRACT_VERSION" == "1.6.0" || "$CONTRACT_VERSION" == "1.7.0" || "$CONTRACT_VERSION" == "1.8.0" ||
           "$CONTRACT_VERSION" == "2.0.0" ]] ||
          die "model route migration requires contract 1.4.0 or newer"
        [[ $# -eq 12 && "$2" == "--ticket" && "$4" == "--workdir" &&
           "$6" == "--approve-hash" && "$8" == "--readiness-hash" &&
           "${10}" == "--approved-by" && "${12}" == "--json" ]] || usage
        [[ "$3" =~ ^T-[0-9]+$ ]] || die "invalid ticket identifier"
        [[ "$7" =~ ^[0-9a-f]{64}$ ]] || die "invalid migration approval hash"
        [[ "$9" =~ ^[0-9a-f]{64}$ ]] || die "invalid migration readiness hash"
        [[ "${11}" =~ ^[a-z0-9][a-z0-9._-]{0,127}$ && "${11}" != "auto" ]] ||
          die "invalid migration approver identifier"
        resolve_product_workdir "$5"
        validate_ticket_worktree "$3"
        MODEL_ARGS=("$MODEL_ACTION" --ticket "$3" --workdir "$RESOLVED_WORKDIR" \
          --approve-hash "$7" --readiness-hash "$9" --approved-by "${11}")
        add_certified_origin_env
        MODEL_MUTATION=1
        ;;
      fallback-plan|fallback|fallback-auto)
        [[ "$CONTRACT_VERSION" == "1.4.0" || "$CONTRACT_VERSION" == "1.5.0" ||
           "$CONTRACT_VERSION" == "1.6.0" || "$CONTRACT_VERSION" == "1.7.0" || "$CONTRACT_VERSION" == "1.8.0" ||
           "$CONTRACT_VERSION" == "2.0.0" ]] ||
          die "mid-ticket model fallback requires contract 1.4.0 or newer"
        [[ "$MODEL_ACTION" != "fallback-auto" || "$CONTRACT_VERSION" == "1.7.0" ||
           "$CONTRACT_VERSION" == "1.8.0" || "$CONTRACT_VERSION" == "2.0.0" ]] ||
          die "automatic qualification fallback requires contract 1.7.0"
        [[ ( $# -eq 10 || $# -eq 12 ) &&
           "$2" == "--ticket" && "$4" == "--failed-run" &&
           "$6" == "--workdir" && "$8" == "--reason" ]] || usage
        if [[ $# -eq 10 ]]; then
          [[ "${10}" == "--json" ]] || usage
        else
          [[ "${10}" == "--allow-reviewer-family" && "${12}" == "--json" ]] ||
            usage
          [[ "${11}" =~ ^[a-z0-9][a-z0-9._-]{0,127}$ ]] ||
            die "invalid Reviewer exception family"
        fi
        [[ "$3" =~ ^T-[0-9]+$ ]] || die "invalid ticket identifier"
        [[ "$5" =~ ^[A-Za-z0-9._-]{1,200}$ ]] || die "invalid failed run identifier"
        [[ "$9" == "credits_exhausted" || "$9" == "provider_unavailable" ]] ||
          die "invalid model fallback reason"
        resolve_product_workdir "$7"
        validate_ticket_worktree "$3" 1
        MODEL_ARGS=("$MODEL_ACTION" --ticket "$3" --failed-run "$5" \
          --workdir "$RESOLVED_WORKDIR" --reason "$9")
        if [[ $# -eq 12 ]]; then
          MODEL_ARGS+=(--allow-reviewer-family "${11}")
        fi
        add_certified_origin_env
        if [[ "$MODEL_ACTION" == "fallback" || "$MODEL_ACTION" == "fallback-auto" ]]; then
          MODEL_MUTATION=1
        fi
        ;;
      pin-batch)
        [[ "$CONTRACT_VERSION" == "1.8.0" || "$CONTRACT_VERSION" == "2.0.0" ]] ||
          die "batch model pinning requires contract 1.8.0 or newer"
        [[ "${!#}" == "--json" ]] || usage
        set -- "${@:1:$(($# - 1))}"
        shift
        MODEL_ARGS=("$MODEL_ACTION")
        MODEL_BATCH_COUNT=0
        while [[ $# -gt 0 ]]; do
          [[ $# -ge 4 && "$1" == "--ticket" && "$3" == "--workdir" ]] || usage
          [[ "$2" =~ ^T-[0-9]+$ ]] || die "invalid ticket identifier"
          resolve_product_workdir "$4"
          validate_ticket_worktree "$2"
          MODEL_ARGS+=(--ticket "$2" --workdir "$RESOLVED_WORKDIR")
          MODEL_BATCH_COUNT=$((MODEL_BATCH_COUNT + 1))
          shift 4
        done
        [[ "$MODEL_BATCH_COUNT" -ge 1 && "$MODEL_BATCH_COUNT" -le 4 ]] || usage
        add_certified_origin_env
        MODEL_MUTATION=1
        ;;
      pin)
        [[ $# -eq 6 && "$2" == "--ticket" && "$4" == "--workdir" &&
           "$6" == "--json" ]] || usage
        [[ "$3" =~ ^T-[0-9]+$ ]] || die "invalid ticket identifier"
        resolve_product_workdir "$5"
        validate_ticket_worktree "$3"
        MODEL_ARGS=("$MODEL_ACTION" --ticket "$3" --workdir "$RESOLVED_WORKDIR")
        add_certified_origin_env
        MODEL_MUTATION=1
        ;;
      *)
        usage
        ;;
    esac
    if [[ "$MODEL_MUTATION" -eq 1 && -e "$PRODUCT_ROOT/factory/MAINTENANCE" ]]; then
      die "product is in maintenance; model mutation refused"
    fi
    MODEL_HELPER="$RELEASE_PATH/scripts/model-control.sh"
    require_managed_file "$MODEL_HELPER" "active release model-control helper"
    cleanup_runtime
    trap - EXIT HUP INT TERM
    exec "${HELPER_ENV[@]}" /bin/bash "$MODEL_HELPER" "${MODEL_ARGS[@]}"
    ;;
  operator-snapshot)
    [[ "$CONTRACT_VERSION" == "1.5.0" || "$CONTRACT_VERSION" == "1.6.0" ||
       "$CONTRACT_VERSION" == "1.7.0" || "$CONTRACT_VERSION" == "1.8.0" ||
       "$CONTRACT_VERSION" == "2.0.0" ]] ||
      die "operator snapshots require contract 1.5.0"
    [[ $# -eq 2 && "$1" =~ ^(workflow|envelope|spend)$ &&
       "$2" == "--json" ]] || usage
    SNAPSHOT_HELPER="$RELEASE_PATH/scripts/operator-state.py"
    require_managed_file "$SNAPSHOT_HELPER" "active release operator snapshot helper"
    cleanup_runtime
    trap - EXIT HUP INT TERM
    exec "${HELPER_ENV[@]}" "$PYTHON_BIN" -I -S "$SNAPSHOT_HELPER" "$1"
    ;;
  envelope)
    [[ "$CONTRACT_VERSION" == "1.5.0" || "$CONTRACT_VERSION" == "1.6.0" ||
       "$CONTRACT_VERSION" == "1.7.0" || "$CONTRACT_VERSION" == "1.8.0" ||
       "$CONTRACT_VERSION" == "2.0.0" ]] ||
      die "envelope control requires contract 1.5.0"
    [[ $# -ge 2 ]] || usage
    ENVELOPE_ACTION="$1"
    [[ "${!#}" == "--json" ]] || usage
    set -- "${@:1:$(($# - 1))}"
    shift
    ENVELOPE_ARGS=("$ENVELOPE_ACTION" --factory-root "$PRODUCT_ROOT")
    ENVELOPE_MUTATION=0
    case "$ENVELOPE_ACTION" in
      inspect)
        [[ $# -eq 0 ]] || usage
        ;;
      plan|apply)
        [[ "$ENVELOPE_ACTION" != "apply" ]] || ENVELOPE_MUTATION=1
        ENVELOPE_SET_COUNT=0
        while [[ $# -gt 0 ]]; do
          case "$1" in
            --set)
              [[ $# -ge 2 && "$2" =~ ^[A-Z][A-Z0-9_]{0,99}=[0-9]{1,7}([.][0-9]{1,6})?$ ]] ||
                die "invalid envelope setting"
              ENVELOPE_ARGS+=(--set "$2")
              ENVELOPE_SET_COUNT=$((ENVELOPE_SET_COUNT + 1))
              shift 2
              ;;
            --approve-hash)
              [[ "$ENVELOPE_ACTION" == "apply" && $# -ge 2 &&
                 "$2" =~ ^[0-9a-f]{64}$ ]] || die "invalid envelope approval hash"
              ENVELOPE_ARGS+=(--approve-hash "$2")
              shift 2
              ;;
            *) usage ;;
          esac
        done
        [[ "$ENVELOPE_SET_COUNT" -gt 0 ]] || die "envelope change is empty"
        ;;
      override-plan|override-apply)
        [[ "$ENVELOPE_ACTION" != "override-apply" ]] || ENVELOPE_MUTATION=1
        ENVELOPE_SCOPE=""
        while [[ $# -gt 0 ]]; do
          case "$1" in
            --scope)
              [[ $# -ge 2 && "$2" =~ ^(next-attempt|ticket|role|product-day|global-day)$ ]] ||
                die "invalid envelope override scope"
              ENVELOPE_SCOPE="$2"
              ENVELOPE_ARGS+=(--scope "$2")
              shift 2
              ;;
            --ticket)
              [[ $# -ge 2 && "$2" =~ ^T-[0-9]+$ ]] ||
                die "invalid envelope override ticket"
              ENVELOPE_ARGS+=(--ticket "$2")
              shift 2
              ;;
            --role)
              [[ $# -ge 2 && "$2" =~ ^(planner|builder|narrator|spec-linter|test-author|reviewer)$ ]] ||
                die "invalid envelope override role"
              ENVELOPE_ARGS+=(--role "$2")
              shift 2
              ;;
            --day)
              [[ $# -ge 2 && "$2" =~ ^20[0-9]{2}-[0-9]{2}-[0-9]{2}$ ]] ||
                die "invalid envelope override day"
              ENVELOPE_ARGS+=(--day "$2")
              shift 2
              ;;
            --issued-at|--expires-at)
              [[ $# -ge 2 && "$2" =~ ^20[0-9]{2}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$ ]] ||
                die "invalid envelope override timestamp"
              ENVELOPE_ARGS+=("$1" "$2")
              shift 2
              ;;
            --operator-id)
              [[ $# -ge 2 && "$2" =~ ^[a-z0-9][a-z0-9._-]{0,127}$ &&
                 "$2" != "auto" ]] || die "invalid envelope override operator"
              ENVELOPE_ARGS+=(--operator-id "$2")
              shift 2
              ;;
            --reason)
              [[ $# -ge 2 && "$2" =~ ^(budget_exhausted|operator_requested)$ ]] ||
                die "invalid envelope override reason"
              ENVELOPE_ARGS+=(--reason "$2")
              shift 2
              ;;
            --set)
              [[ $# -ge 2 && "$2" =~ ^[A-Z][A-Z0-9_]{0,99}=[0-9]{1,7}([.][0-9]{1,6})?$ ]] ||
                die "invalid envelope override setting"
              ENVELOPE_ARGS+=(--set "$2")
              shift 2
              ;;
            --approve-hash)
              [[ "$ENVELOPE_ACTION" == "override-apply" && $# -ge 2 &&
                 "$2" =~ ^[0-9a-f]{64}$ ]] ||
                die "invalid envelope override approval hash"
              ENVELOPE_ARGS+=(--approve-hash "$2")
              shift 2
              ;;
            *) usage ;;
          esac
        done
        [[ -n "$ENVELOPE_SCOPE" ]] || die "envelope override scope is required"
        if [[ "$ENVELOPE_SCOPE" == "global-day" ]]; then
          ENVELOPE_ARGS+=(--global-env "$GLOBAL_ENV_PATH")
        fi
        ;;
      *) usage ;;
    esac
    if [[ "$ENVELOPE_MUTATION" -eq 1 &&
          -e "$PRODUCT_ROOT/factory/MAINTENANCE" ]]; then
      die "product is in maintenance; envelope mutation refused"
    fi
    ENVELOPE_HELPER="$RELEASE_PATH/scripts/envelope-control.py"
    require_managed_file "$ENVELOPE_HELPER" "active release envelope-control helper"
    cleanup_runtime
    trap - EXIT HUP INT TERM
    exec "${HELPER_ENV[@]}" "$PYTHON_BIN" -I -S \
      "$ENVELOPE_HELPER" "${ENVELOPE_ARGS[@]}"
    ;;
  attempt)
    [[ "$CONTRACT_VERSION" == "1.5.0" || "$CONTRACT_VERSION" == "1.6.0" ||
       "$CONTRACT_VERSION" == "1.7.0" || "$CONTRACT_VERSION" == "1.8.0" ||
       "$CONTRACT_VERSION" == "2.0.0" ]] ||
      die "attempt control requires contract 1.5.0"
    [[ $# -ge 8 ]] || usage
    ATTEMPT_ACTION="$1"
    [[ "$2" == "--ticket" && "$4" == "--run" &&
       "$6" == "--reason" ]] || usage
    [[ "$3" =~ ^T-[0-9]+$ ]] || die "invalid attempt ticket"
    [[ "$5" =~ ^[A-Za-z0-9._-]{1,200}$ ]] || die "invalid attempt run"
    [[ "$7" =~ ^(budget_exhausted|operator_requested)$ ]] ||
      die "invalid attempt cancellation reason"
    ATTEMPT_HELPER="$RELEASE_PATH/scripts/attempt-cancel.py"
    require_managed_file "$ATTEMPT_HELPER" "active release attempt-control helper"
    if [[ "$ATTEMPT_ACTION" == "cancel-plan" ]]; then
      [[ $# -eq 8 && "$8" == "--json" ]] || usage
      cleanup_runtime
      trap - EXIT HUP INT TERM
      exec "${HELPER_ENV[@]}" "$PYTHON_BIN" -I -S "$ATTEMPT_HELPER" preview \
        --factory-root "$PRODUCT_ROOT" --ticket "$3" --run-id "$5" --reason "$7"
    elif [[ "$ATTEMPT_ACTION" == "cancel" ]]; then
      [[ $# -eq 10 && "$8" == "--approve-hash" && "${10}" == "--json" &&
         "$9" =~ ^[0-9a-f]{64}$ ]] || usage
      [[ ! -e "$PRODUCT_ROOT/factory/MAINTENANCE" ]] ||
        die "product is in maintenance; attempt cancellation refused"
      ATTEMPT_PLAN="$(mktemp "$SAFE_TMPDIR/.attempt-cancel.XXXXXX")" ||
        die "could not allocate cancellation preview"
      RAW_OUTPUT_FILE="$ATTEMPT_PLAN"
      "${HELPER_ENV[@]}" "$PYTHON_BIN" -I -S "$ATTEMPT_HELPER" preview \
        --factory-root "$PRODUCT_ROOT" --ticket "$3" --run-id "$5" --reason "$7" \
        > "$ATTEMPT_PLAN" || die "attempt cancellation preview failed"
      ATTEMPT_HASH="$("$PYTHON_BIN" -I -S - "$ATTEMPT_PLAN" <<'PY'
import json, re, sys
value = json.load(open(sys.argv[1], encoding="utf-8"))
digest = value.get("preview_hash", "")
if not re.fullmatch(r"[0-9a-f]{64}", digest):
    raise SystemExit(2)
print(digest)
PY
)" || die "attempt cancellation preview is malformed"
      [[ "$ATTEMPT_HASH" == "$9" ]] || die "attempt cancellation preview changed"
      RAW_OUTPUT_FILE=""
      "${HELPER_ENV[@]}" "$PYTHON_BIN" -I -S "$ATTEMPT_HELPER" apply \
        --factory-root "$PRODUCT_ROOT" --plan "$ATTEMPT_PLAN" \
        --preview-hash "$9"
      ATTEMPT_RC=$?
      rm -f "$ATTEMPT_PLAN"
      cleanup_runtime
      trap - EXIT HUP INT TERM
      exit "$ATTEMPT_RC"
    else
      usage
    fi
    ;;
  preflight)
    validate_preflight_command "$@"
    add_dispatch_lease_env "$LEASE_ID"
    if [[ "$CONTRACT_VERSION" == "1.8.0" || "$CONTRACT_VERSION" == "2.0.0" ]]; then
      transition_receipt verify "$PREFLIGHT_ROLE" ||
        die "transition receipt verification failed"
      if [[ "$TRANSITION_STAGE" != "RUN $PREFLIGHT_ROLE" &&
            "$TRANSITION_STAGE" != "FIX $PREFLIGHT_ROLE" &&
            "$TRANSITION_STAGE" != "FIX builder-or-test-author" ]]; then
        die "transition receipt returned an invalid preflight stage"
      fi
      if [[ "$TRANSITION_PREFLIGHT_STAGE" != "$TRANSITION_STAGE" &&
            !( "$TRANSITION_STAGE" == "RUN planner" &&
               "$TRANSITION_PREFLIGHT_STAGE" == "CATCHUP planner" ) ]]; then
        die "transition receipt returned an invalid preflight admission"
      fi
      HELPER_ENV+=(
        "FACTORY_TRANSITION_RECEIPT_SHA256=$TRANSITION_RECEIPT"
        "FACTORY_TRANSITION_STATE_DIR=$CONTROLLER_STATE_DIR"
        "FACTORY_VERIFIED_TRANSITION_STAGE=$TRANSITION_PREFLIGHT_STAGE"
      )
    fi
    PREFLIGHT_ARGS=(--ticket "$TICKET")
    [[ -z "$PREFLIGHT_ROLE" ]] ||
      PREFLIGHT_ARGS+=(--role "$PREFLIGHT_ROLE")
    [[ -z "$LEASE_ID" ]] ||
      PREFLIGHT_ARGS+=(--lease "$LEASE_ID")
    [[ -z "$TICKET_WORKDIR" ]] ||
      PREFLIGHT_ARGS+=(--workdir "$TICKET_WORKDIR")
    wrap_json_command "$PREFLIGHT_SCHEMA" "preflight" "$TICKET" \
      "$RELEASE_PATH/scripts/preflight.sh" "${PREFLIGHT_ARGS[@]}"
    rc=$?
    exit "$rc"
    ;;
  next-stage)
    [[ "$CONTRACT_VERSION" != "1.8.0" && "$CONTRACT_VERSION" != "2.0.0" ]] ||
      die "contract 1.8 transitions require state-machine receipts"
    validate_ticket_command "$@"
    add_dispatch_lease_env "$LEASE_ID"
    if [[ -n "$LEASE_ID" && -n "$TICKET_WORKDIR" ]]; then
      wrap_json_command "$NEXT_STAGE_SCHEMA" "next-stage" "$TICKET" \
        "$RELEASE_PATH/scripts/next-stage.sh" --ticket "$TICKET" --lease "$LEASE_ID" \
        --workdir "$TICKET_WORKDIR"
    elif [[ -n "$LEASE_ID" ]]; then
      wrap_json_command "$NEXT_STAGE_SCHEMA" "next-stage" "$TICKET" \
        "$RELEASE_PATH/scripts/next-stage.sh" --ticket "$TICKET" --lease "$LEASE_ID"
    elif [[ -n "$TICKET_WORKDIR" ]]; then
      wrap_json_command "$NEXT_STAGE_SCHEMA" "next-stage" "$TICKET" \
        "$RELEASE_PATH/scripts/next-stage.sh" --ticket "$TICKET" --workdir "$TICKET_WORKDIR"
    else
      wrap_json_command "$NEXT_STAGE_SCHEMA" "next-stage" "$TICKET" \
        "$RELEASE_PATH/scripts/next-stage.sh" --ticket "$TICKET"
    fi
    rc=$?
    exit "$rc"
    ;;
  ticket-state)
    [[ "$CONTRACT_VERSION" == "1.2.0" || "$CONTRACT_VERSION" == "1.3.0" ||
       "$CONTRACT_VERSION" == "1.4.0" || "$CONTRACT_VERSION" == "1.5.0" ||
       "$CONTRACT_VERSION" == "1.6.0" || "$CONTRACT_VERSION" == "1.7.0" || "$CONTRACT_VERSION" == "1.8.0" ||
       "$CONTRACT_VERSION" == "2.0.0" ]] ||
      die "ticket-state requires contract 1.2.0 or newer"
    if [[ $# -eq 7 && "$1" == "--ticket" && "$3" == "--workdir" &&
          "$5" == "--action" && "$7" == "--json" ]]; then
      TICKET_STATE_VALUE=""
    elif [[ $# -eq 9 && "$1" == "--ticket" && "$3" == "--workdir" &&
            "$5" == "--action" && "$7" == "--state" && "$9" == "--json" ]]; then
      TICKET_STATE_VALUE="$8"
    else
      usage
    fi
    TICKET="$2" TICKET_ACTION="$6"
    [[ "$TICKET" =~ ^T-[0-9]+$ ]] || die "invalid ticket identifier"
    [[ "$TICKET_ACTION" == "materialize" || "$TICKET_ACTION" == "transition" ||
       "$TICKET_ACTION" == "reviewer-reconcile" ||
       "$TICKET_ACTION" == "qualification-backlog" ]] ||
      die "invalid ticket-state action"
    [[ ( "$CONTRACT_VERSION" != "1.8.0" && "$CONTRACT_VERSION" != "2.0.0" ) ||
       "$TICKET_ACTION" == "reviewer-reconcile" ||
       "$TICKET_ACTION" == "qualification-backlog" ]] ||
      die "contract 1.8 ticket stages are state-machine owned"
    [[ "$TICKET_ACTION" != "transition" || -n "$TICKET_STATE_VALUE" ]] ||
      die "transition requires a state"
    [[ "$TICKET_ACTION" != "reviewer-reconcile" ||
       "$CONTRACT_VERSION" == "1.7.0" || "$CONTRACT_VERSION" == "1.8.0" ||
       "$CONTRACT_VERSION" == "2.0.0" ]] ||
      die "reviewer reconciliation requires contract 1.7.0"
    [[ "$TICKET_ACTION" != "qualification-backlog" ||
       "$CONTRACT_VERSION" == "1.7.0" || "$CONTRACT_VERSION" == "1.8.0" ||
       "$CONTRACT_VERSION" == "2.0.0" ]] ||
      die "qualification backlog return requires contract 1.7.0"
    resolve_product_workdir "$4"
    validate_ticket_worktree "$TICKET"
    [[ ! -e "$PRODUCT_ROOT/factory/MAINTENANCE" ]] ||
      die "product is in maintenance; ticket-state refused"
    TICKET_STATE_HELPER="$RELEASE_PATH/scripts/ticket-state.sh"
    require_managed_file "$TICKET_STATE_HELPER" "active release ticket-state helper"
    add_certified_origin_env
    cleanup_runtime
    trap - EXIT HUP INT TERM
    if [[ -n "$TICKET_STATE_VALUE" ]]; then
      exec_selected_helper "$TICKET_STATE_HELPER" --ticket "$TICKET" \
        --workdir "$RESOLVED_WORKDIR" --action "$TICKET_ACTION" --state "$TICKET_STATE_VALUE"
    else
      exec_selected_helper "$TICKET_STATE_HELPER" --ticket "$TICKET" \
        --workdir "$RESOLVED_WORKDIR" --action "$TICKET_ACTION"
    fi
    ;;
  ticket-attest)
    [[ "$CONTRACT_VERSION" == "1.3.0" || "$CONTRACT_VERSION" == "1.4.0" ||
       "$CONTRACT_VERSION" == "1.5.0" || "$CONTRACT_VERSION" == "1.6.0" ||
       "$CONTRACT_VERSION" == "1.7.0" || "$CONTRACT_VERSION" == "1.8.0" ||
       "$CONTRACT_VERSION" == "2.0.0" ]] ||
      die "ticket-attest requires contract 1.3.0 or newer"
    ATTEST_LEASE="" ATTEST_RECEIPT="" ATTEST_ONLY=0 ATTEST_EMERGENCY=0
    ATTEST_REQUEST="" ATTEST_APPROVE_HASH=""
    if [[ ( "$CONTRACT_VERSION" == "1.8.0" || "$CONTRACT_VERSION" == "2.0.0" ) && $# -eq 9 &&
          "$1" == "--ticket" && "$3" == "--workdir" &&
          "$5" == "--action" && "$6" == "emergency-plan" &&
          "$7" == "--request" && "$9" == "--json" ]]; then
      ATTEST_WORKDIR="$4" ATTEST_ACTION="$6" ATTEST_REQUEST="$8"
      ATTEST_EMERGENCY=1
    elif [[ ( "$CONTRACT_VERSION" == "1.8.0" || "$CONTRACT_VERSION" == "2.0.0" ) && $# -eq 11 &&
            "$1" == "--ticket" && "$3" == "--workdir" &&
            "$5" == "--action" && "$6" == "emergency-apply" &&
            "$7" == "--request" && "$9" == "--approve-hash" &&
            "${11}" == "--json" ]]; then
      ATTEST_WORKDIR="$4" ATTEST_ACTION="$6" ATTEST_REQUEST="$8"
      ATTEST_APPROVE_HASH="${10}" ATTEST_EMERGENCY=1
      [[ "$ATTEST_APPROVE_HASH" =~ ^[0-9a-f]{64}$ ]] ||
        die "invalid emergency approval hash"
    elif [[ ( "$CONTRACT_VERSION" == "1.8.0" || "$CONTRACT_VERSION" == "2.0.0" ) && $# -eq 10 &&
          "$1" == "--ticket" && "$3" == "--receipt" &&
          "$5" == "--workdir" && "$7" == "--action" &&
          "$9" == "--attest-only" && "${10}" == "--json" ]]; then
      ATTEST_RECEIPT="$4" ATTEST_WORKDIR="$6" ATTEST_ACTION="$8"
      ATTEST_ONLY=1
    elif [[ ( "$CONTRACT_VERSION" == "1.8.0" || "$CONTRACT_VERSION" == "2.0.0" ) && $# -eq 12 &&
            "$1" == "--ticket" && "$3" == "--lease" &&
            "$5" == "--receipt" && "$7" == "--workdir" &&
            "$9" == "--action" && "${11}" == "--attest-only" &&
            "${12}" == "--json" ]]; then
      ATTEST_LEASE="$4" ATTEST_RECEIPT="$6"
      ATTEST_WORKDIR="$8" ATTEST_ACTION="${10}"
      ATTEST_ONLY=1
      [[ "$ATTEST_LEASE" =~ ^[0-9a-f]{64}$ ]] || die "invalid dispatcher lease"
    elif [[ ( "$CONTRACT_VERSION" == "1.8.0" || "$CONTRACT_VERSION" == "2.0.0" ) && $# -eq 9 &&
            "$1" == "--ticket" && "$3" == "--lease" &&
            "$5" == "--workdir" && "$7" == "--action" &&
            "$8" == "dependency-refresh-replay" && "$9" == "--json" ]]; then
      ATTEST_LEASE="$4" ATTEST_WORKDIR="$6" ATTEST_ACTION="$8"
      [[ "$ATTEST_LEASE" =~ ^[0-9a-f]{64}$ ]] || die "invalid dispatcher lease"
    elif [[ ( "$CONTRACT_VERSION" == "1.8.0" || "$CONTRACT_VERSION" == "2.0.0" ) && $# -eq 9 &&
          "$1" == "--ticket" && "$3" == "--receipt" &&
          "$5" == "--workdir" && "$7" == "--action" && "$9" == "--json" ]]; then
      ATTEST_RECEIPT="$4" ATTEST_WORKDIR="$6" ATTEST_ACTION="$8"
    elif [[ ( "$CONTRACT_VERSION" == "1.8.0" || "$CONTRACT_VERSION" == "2.0.0" ) && $# -eq 11 &&
            "$1" == "--ticket" && "$3" == "--lease" &&
            "$5" == "--receipt" && "$7" == "--workdir" &&
            "$9" == "--action" && "${11}" == "--json" ]]; then
      ATTEST_LEASE="$4" ATTEST_RECEIPT="$6"
      ATTEST_WORKDIR="$8" ATTEST_ACTION="${10}"
      [[ "$ATTEST_LEASE" =~ ^[0-9a-f]{64}$ ]] || die "invalid dispatcher lease"
    elif [[ $# -eq 7 && "$1" == "--ticket" && "$3" == "--workdir" &&
          "$5" == "--action" && "$7" == "--json" ]]; then
      ATTEST_WORKDIR="$4" ATTEST_ACTION="$6"
    elif [[ $# -eq 9 && "$1" == "--ticket" && "$3" == "--lease" &&
            "$5" == "--workdir" && "$7" == "--action" && "$9" == "--json" ]]; then
      ATTEST_LEASE="$4" ATTEST_WORKDIR="$6" ATTEST_ACTION="$8"
      [[ "$ATTEST_LEASE" =~ ^[0-9a-f]{64}$ ]] || die "invalid dispatcher lease"
    else
      usage
    fi
    ATTEST_TICKET="$2"
    [[ "$ATTEST_TICKET" =~ ^T-[0-9]+$ ]] || die "invalid ticket identifier"
    [[ "$ATTEST_ACTION" == "bundle" || "$ATTEST_ACTION" == "approval" ||
       "$ATTEST_ACTION" == "dependency-refresh" ||
       "$ATTEST_ACTION" == "dependency-refresh-replay" ||
       "$ATTEST_ACTION" == "refresh" || "$ATTEST_ACTION" == "done" ||
       "$ATTEST_ACTION" == "emergency-plan" ||
       "$ATTEST_ACTION" == "emergency-apply" ]] ||
      die "invalid ticket-attest action"
    [[ "$ATTEST_ACTION" != "dependency-refresh-replay" ||
       "$CONTRACT_VERSION" == "1.8.0" || "$CONTRACT_VERSION" == "2.0.0" ]] ||
      die "dependency refresh replay requires contract 1.8.0 or newer"
    if [[ ( "$CONTRACT_VERSION" == "1.8.0" || "$CONTRACT_VERSION" == "2.0.0" ) &&
          "$ATTEST_ACTION" != "done" &&
          "$ATTEST_ACTION" != "dependency-refresh-replay" &&
          "$ATTEST_EMERGENCY" -eq 0 ]]; then
      [[ "$ATTEST_RECEIPT" =~ ^[0-9a-f]{64}$ ]] ||
        die "invalid transition receipt"
    fi
    resolve_product_workdir "$ATTEST_WORKDIR"
    if [[ "$ATTEST_ACTION" == "done" || "$ATTEST_EMERGENCY" -eq 1 ]]; then
      ATTEST_BRANCH="chore/$(printf '%s' "$ATTEST_TICKET" | tr '[:upper:]' '[:lower:]' | tr -d '-')-closeout"
      [[ "$(git -C "$RESOLVED_WORKDIR" symbolic-ref --quiet --short HEAD 2>/dev/null)" == "$ATTEST_BRANCH" ]] ||
        die "done worktree branch must be $ATTEST_BRANCH"
      if [[ "$ATTEST_ACTION" != "emergency-apply" ]]; then
        [[ -z "$(git -C "$RESOLVED_WORKDIR" status --porcelain --untracked-files=all)" ]] ||
          die "done worktree must be clean"
      fi
      if [[ "$(git -C "$RESOLVED_WORKDIR" rev-parse HEAD)" != \
            "$(git -C "$RESOLVED_WORKDIR" rev-parse origin/main)" ]]; then
        [[ -f "$RESOLVED_WORKDIR/factory/attestations/$ATTEST_TICKET/done.json" ]] ||
          die "done worktree must start at origin/main or be an attested retry"
      fi
    else
      validate_ticket_worktree "$ATTEST_TICKET"
    fi
    [[ ! -e "$PRODUCT_ROOT/factory/MAINTENANCE" ]] ||
      die "product is in maintenance; ticket-attest refused"
    ATTEST_HELPER="$RELEASE_PATH/scripts/ticket-attest.sh"
    require_managed_file "$ATTEST_HELPER" "active release ticket-attest helper"
    add_certified_origin_env
    if [[ "$ATTEST_EMERGENCY" -eq 1 ]]; then
      ATTEST_REQUEST="$(expand_absolute_path "$ATTEST_REQUEST" 2>/dev/null || true)"
      [[ -n "$ATTEST_REQUEST" ]] || die "emergency closeout request must be absolute"
      require_managed_file "$ATTEST_REQUEST" "emergency closeout request"
      controller_state_dir
      EMERGENCY_ARGS=(
        --ticket "$ATTEST_TICKET" --workdir "$RESOLVED_WORKDIR"
        --action "$ATTEST_ACTION" --request "$ATTEST_REQUEST"
      )
      [[ "$ATTEST_ACTION" != "emergency-apply" ]] ||
        EMERGENCY_ARGS+=(--approve-hash "$ATTEST_APPROVE_HASH")
      HELPER_ENV+=(
        "FACTORY_CONTROLLER_STATE_DIR=$CONTROLLER_STATE_DIR"
        "FACTORY_CONTRACT_VERSION=$CONTRACT_VERSION"
      )
      cleanup_runtime
      trap - EXIT HUP INT TERM
      exec "${HELPER_ENV[@]}" "$PYTHON_BIN" -I -S \
        "$RELEASE_PATH/scripts/ticket-attest.py" "${EMERGENCY_ARGS[@]}"
    fi
    add_dispatch_lease_env "$ATTEST_LEASE"
    if [[ ( "$CONTRACT_VERSION" == "1.8.0" || "$CONTRACT_VERSION" == "2.0.0" ) &&
          "$ATTEST_ACTION" != "done" &&
          "$ATTEST_ACTION" != "dependency-refresh-replay" ]]; then
      TICKET="$ATTEST_TICKET" LEASE_ID="$ATTEST_LEASE"
      TRANSITION_RECEIPT="$ATTEST_RECEIPT"
      transition_receipt verify ||
        die "transition receipt verification failed"
      case "$ATTEST_ACTION" in
        bundle)
          [[ "$TRANSITION_STAGE" == AWAIT-OPERATOR\ bundle\ posted* ]] ||
            die "transition receipt does not authorize bundle attestation"
          ;;
        approval)
          if [[ "$ATTEST_ONLY" -eq 1 ]]; then
            [[ "$TRANSITION_STAGE" == AWAIT-OPERATOR\ operator\ approval\ observed* ]] ||
              die "transition receipt does not authorize approval attestation"
          else
            [[ "$TRANSITION_STAGE" == AWAIT-MERGE\ approval\ attested* ||
               "$TRANSITION_STAGE" == "AWAIT-MERGE protected auto-merge requested; await merge and closeout" ]] ||
              die "transition receipt does not authorize protected auto-merge"
          fi
          ;;
        refresh)
          [[ "$TRANSITION_STAGE" != REFUSE\ dependency\ refresh\ required* &&
             ( "$TRANSITION_STAGE" == REFUSE* || "$TRANSITION_STAGE" == AWAIT-* ) ]] ||
            die "transition receipt does not authorize refresh"
          ;;
        dependency-refresh)
          [[ "$TRANSITION_STAGE" == REFUSE\ dependency\ refresh\ required* ]] ||
            die "transition receipt does not authorize dependency refresh"
          ;;
      esac
      transition_receipt consume ||
        die "transition receipt consumption failed"
      HELPER_ENV+=(
        "FACTORY_CONTRACT_VERSION=$CONTRACT_VERSION"
        "FACTORY_TRANSITION_RECEIPT_SHA256=$TRANSITION_RECEIPT"
        "FACTORY_TRANSITION_STAGE=$TRANSITION_STAGE"
      )
    fi
    cleanup_runtime
    trap - EXIT HUP INT TERM
    ATTEST_ARGS=(
      --ticket "$ATTEST_TICKET" --workdir "$RESOLVED_WORKDIR"
      --action "$ATTEST_ACTION"
    )
    [[ "$ATTEST_ONLY" -eq 0 ]] || ATTEST_ARGS+=(--attest-only)
    exec_selected_helper "$ATTEST_HELPER" "${ATTEST_ARGS[@]}"
    ;;
  project-ledger)
    [[ "$CONTRACT_VERSION" == "1.2.0" || "$CONTRACT_VERSION" == "1.3.0" ||
       "$CONTRACT_VERSION" == "1.4.0" || "$CONTRACT_VERSION" == "1.5.0" ||
       "$CONTRACT_VERSION" == "1.6.0" || "$CONTRACT_VERSION" == "1.7.0" || "$CONTRACT_VERSION" == "1.8.0" ||
       "$CONTRACT_VERSION" == "2.0.0" ]] ||
      die "project-ledger requires contract 1.2.0 or newer"
    [[ $# -eq 5 && "$1" == "--ticket" && "$3" == "--workdir" && "$5" == "--json" ]] || usage
    PROJECT_TICKET="$2"
    [[ "$PROJECT_TICKET" =~ ^T-[0-9]+$ ]] || die "invalid ticket identifier"
    resolve_product_workdir "$4"
    PROJECT_HELPER="$RELEASE_PATH/scripts/ledger-view.py"
    require_managed_file "$PROJECT_HELPER" "active release ledger projection helper"
    run_selected_python "$PROJECT_HELPER" project \
      --factory-root "$PRODUCT_ROOT" \
      --workdir "$RESOLVED_WORKDIR" \
      --ticket "$PROJECT_TICKET"
    rc=$?
    exit "$rc"
    ;;
  reorder-test-fixes)
    [[ $# -ge 5 &&
       "$1" == "--ticket" &&
       "$3" == "--workdir" &&
       "$5" == "--" ]] || usage
    REORDER_TICKET="$2"
    [[ "$REORDER_TICKET" =~ ^T-[0-9]+$ ]] || die "invalid ticket identifier"
    resolve_product_workdir "$4"
    validate_ticket_worktree "$REORDER_TICKET"
    shift 5
    [[ ! -e "$PRODUCT_ROOT/factory/MAINTENANCE" ]] ||
      die "product is in maintenance; reorder refused"
    REORDER_HELPER="$RELEASE_PATH/scripts/reorder-test-fixes.sh"
    require_managed_file "$REORDER_HELPER" "active release reorder helper"
    cd "$RESOLVED_WORKDIR" || die "reorder workdir became unavailable"
    cleanup_runtime
    trap - EXIT HUP INT TERM
    exec_selected_helper "$REORDER_HELPER" "$@"
    ;;
  run)
    LEASE_ID="" TRANSITION_RECEIPT=""
    if [[ ( "$CONTRACT_VERSION" == "1.8.0" || "$CONTRACT_VERSION" == "2.0.0" ) && $# -ge 12 &&
          "$1" == "--role" && "$3" == "--ticket" &&
          "$5" == "--receipt" && "$7" == "--prompt-file" &&
          "$9" == "--workdir" && "${11}" == "--" ]]; then
      TRANSITION_RECEIPT="$6" RUN_PROMPT="$8" RUN_WORKDIR="${10}" RUN_SHIFT=11
    elif [[ ( "$CONTRACT_VERSION" == "1.8.0" || "$CONTRACT_VERSION" == "2.0.0" ) && $# -ge 14 &&
            "$1" == "--role" && "$3" == "--ticket" &&
            "$5" == "--lease" && "$7" == "--receipt" &&
            "$9" == "--prompt-file" && "${11}" == "--workdir" &&
            "${13}" == "--" ]]; then
      LEASE_ID="$6" TRANSITION_RECEIPT="$8"
      [[ "$LEASE_ID" =~ ^[0-9a-f]{64}$ ]] || die "invalid dispatcher lease"
      RUN_PROMPT="${10}" RUN_WORKDIR="${12}" RUN_SHIFT=13
    elif [[ "$CONTRACT_VERSION" != "1.8.0" && "$CONTRACT_VERSION" != "2.0.0" && $# -ge 10 &&
            "$1" == "--role" && "$3" == "--ticket" &&
            "$5" == "--prompt-file" && "$7" == "--workdir" && "$9" == "--" ]]; then
      RUN_PROMPT="$6" RUN_WORKDIR="$8" RUN_SHIFT=9
    elif [[ "$CONTRACT_VERSION" != "1.8.0" && "$CONTRACT_VERSION" != "2.0.0" && $# -ge 12 &&
            "$1" == "--role" && "$3" == "--ticket" &&
            "$5" == "--lease" && "$7" == "--prompt-file" &&
            "$9" == "--workdir" && "${11}" == "--" ]]; then
      LEASE_ID="$6"
      [[ "$LEASE_ID" =~ ^[0-9a-f]{64}$ ]] || die "invalid dispatcher lease"
      RUN_PROMPT="$8" RUN_WORKDIR="${10}" RUN_SHIFT=11
    else
      usage
    fi
    RUN_ROLE="$2"
    RUN_TICKET="$4"
    role_is_allowed "$RUN_ROLE" || die "run role is not allowed by the active contract"
    [[ "$RUN_TICKET" =~ ^T-[0-9]+$ ]] || die "invalid ticket identifier"
    if [[ "$CONTRACT_VERSION" == "1.8.0" || "$CONTRACT_VERSION" == "2.0.0" ]]; then
      [[ "$TRANSITION_RECEIPT" =~ ^[0-9a-f]{64}$ ]] ||
        die "invalid transition receipt"
    fi
    resolve_prompt_path "$RUN_PROMPT" "$RUN_ROLE"
    resolve_product_workdir "$RUN_WORKDIR"
    validate_ticket_worktree "$RUN_TICKET"
    shift "$RUN_SHIFT"
    TASK_NONEMPTY=0
    for task_part in "$@"; do
      [[ -z "$task_part" ]] || TASK_NONEMPTY=1
    done
    [[ "$TASK_NONEMPTY" -eq 1 ]] || die "run task must be nonempty"
    [[ ! -e "$PRODUCT_ROOT/factory/MAINTENANCE" ]] ||
      die "product is in maintenance; run refused"
    RUNNER="$RELEASE_PATH/scripts/run-agent.sh"
    require_managed_file "$RUNNER" "active release run helper"
    add_dispatch_lease_env "$LEASE_ID"
    add_certified_origin_env
    if [[ -n "$ACTIVE_RUNTIME_NODE$ACTIVE_RUNTIME_NPM" ]]; then
      [[ -n "$ACTIVE_RUNTIME_NODE" && -n "$ACTIVE_RUNTIME_NPM" ]] ||
        die "active runtime tuple is incomplete"
      HELPER_ENV+=(
        "FACTORY_CERTIFIED_NODE_VERSION=$ACTIVE_RUNTIME_NODE"
        "FACTORY_CERTIFIED_NPM_VERSION=$ACTIVE_RUNTIME_NPM"
      )
    fi
    if [[ "$CONTRACT_VERSION" == "1.8.0" || "$CONTRACT_VERSION" == "2.0.0" ]]; then
      TICKET="$RUN_TICKET"
      if ! transition_receipt consume "$RUN_ROLE"; then
        EMERGENCY_HELPER="$RELEASE_PATH/scripts/emergency-admit.py"
        require_managed_file "$EMERGENCY_HELPER" \
          "active release emergency admission helper"
        run_selected_python "$EMERGENCY_HELPER" consume \
          --factory-root "$PRODUCT_ROOT" --workdir "$RESOLVED_WORKDIR" \
          --kit-dir "$RELEASE_PATH" --state-dir "$CONTROLLER_STATE_DIR" \
          --ticket "$RUN_TICKET" --contract-version "$CONTRACT_VERSION" \
          --factory-sha "$KIT_SHA" --project "$PROJECT" \
          --receipt "$TRANSITION_RECEIPT" --role "$RUN_ROLE" \
          --lease "$LEASE_ID" >/dev/null ||
          die "transition receipt consumption failed"
      fi
      HELPER_ENV+=(
        "FACTORY_TRANSITION_RECEIPT_SHA256=$TRANSITION_RECEIPT"
        "FACTORY_TRANSITION_STATE_DIR=$CONTROLLER_STATE_DIR"
      )
    fi
    cleanup_runtime
    trap - EXIT HUP INT TERM
    exec_selected_helper "$RUNNER" \
      --role "$RUN_ROLE" \
      --ticket "$RUN_TICKET" \
      --prompt-file "$RESOLVED_PROMPT" \
      --workdir "$RESOLVED_WORKDIR" \
      -- "$@"
    ;;
  claim|renew|release|release-expired)
    validate_lease_command "$COMMAND" "$@"
    LEASE_HELPER="$RELEASE_PATH/scripts/dispatch-lease.sh"
    require_managed_file "$LEASE_HELPER" "active release dispatcher lease helper"
    cleanup_runtime
    trap - EXIT HUP INT TERM
    if [[ "$COMMAND" == "claim" ]]; then
      exec_selected_helper "$LEASE_HELPER" claim --ticket "$TICKET"
    else
      exec_selected_helper "$LEASE_HELPER" "$COMMAND" --ticket "$TICKET" --lease "$LEASE_ID"
    fi
    ;;
  *)
    usage
    ;;
esac
