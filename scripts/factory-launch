#!/usr/bin/env bash
# Stable Factory boundary. Install explicitly at ~/.factory/bin/factory-launch.
# This file is the trust root: it resolves one active release, validates it,
# then uses only helpers from that physical release for the entire invocation.
set -u

CONTRACT_VERSION=""
PREFLIGHT_SCHEMA="nysa.software-factory.preflight/v1"
NEXT_STAGE_SCHEMA="nysa.software-factory.next-stage/v1"

# The launcher validates paths and Git state before constructing the helper
# environment. Caller-controlled interpreter and repository controls must not
# influence either phase.
unset CDPATH ENV BASH_ENV GH_TOKEN PYTHONHOME PYTHONPATH PYTHONSTARTUP PYTHONUSERBASE \
  PYTHONINSPECT PYTHONBREAKPOINT PYTHONWARNINGS PYTHONHASHSEED PYTHONSAFEPATH \
  PYTHONNOUSERSITE GIT_DIR GIT_WORK_TREE GIT_INDEX_FILE \
  GIT_OBJECT_DIRECTORY GIT_ALTERNATE_OBJECT_DIRECTORIES GIT_COMMON_DIR \
  GIT_CONFIG GIT_CONFIG_GLOBAL GIT_CONFIG_SYSTEM GIT_CONFIG_COUNT \
  GIT_CONFIG_PARAMETERS GIT_CONFIG_NOSYSTEM GIT_ATTR_NOSYSTEM GIT_EXEC_PATH \
  GIT_NAMESPACE GIT_PREFIX GIT_SHALLOW_FILE GIT_REPLACE_REF_BASE \
  GIT_NO_REPLACE_OBJECTS GIT_CEILING_DIRECTORIES \
  GIT_DISCOVERY_ACROSS_FILESYSTEM 2>/dev/null || true
unset FACTORY_CERTIFIED_PRODUCT_ORIGIN 2>/dev/null || true

die() {
  echo "factory-launch: $*" >&2
  exit 1
}

usage() {
  echo "usage: factory-launch <project> <contract|doctor|reconcile|incident-report|watch|ticket-control|qualification|dispatch-plan|state-machine|emergency-admit|passport|publication|publication-repair|ci-rerun|ticket-pr|models|envelope|operator-snapshot|attempt|claim|renew|release|release-expired|preflight|next-stage|ticket-state|ticket-attest|project-ledger|reorder-test-fixes|run> [arguments]" >&2
  exit 2
}

BOOTSTRAP_PYTHON="/usr/bin/python3"
[[ ! -x /Library/Developer/CommandLineTools/usr/bin/python3 ]] ||
  BOOTSTRAP_PYTHON="/Library/Developer/CommandLineTools/usr/bin/python3"
[[ -x "$BOOTSTRAP_PYTHON" ]] || die "fixed system python3 is required"
ACCOUNT_HOME="$("$BOOTSTRAP_PYTHON" -I -S - <<'PY'
import os
import pwd

home = os.path.realpath(pwd.getpwuid(os.getuid()).pw_dir)
if not os.path.isabs(home) or not os.path.isdir(home):
    raise SystemExit(1)
print(home)
PY
)" || die "account home cannot be resolved"
SELF_PATH="$("$BOOTSTRAP_PYTHON" -I -S - "${BASH_SOURCE[0]}" <<'PY'
import os
import sys

path = os.path.realpath(sys.argv[1])
if not os.path.isabs(path) or not os.path.isfile(path):
    raise SystemExit(1)
print(path)
PY
)" || die "launcher self path cannot be resolved"
INSTALLED_LAUNCHER_PATH="$ACCOUNT_HOME/.factory/bin/factory-launch"
ISOLATED_TEST_LAUNCHER=0
QUALIFICATION_LAUNCHER=0

if [[ "$SELF_PATH" == "$INSTALLED_LAUNCHER_PATH" ]]; then
  if "$BOOTSTRAP_PYTHON" -I -S - <<'PY'
import os, sys
blocked = {
    "FACTORY_KIT_CANONICAL_ORIGIN",
    "FACTORY_KIT_FAIL_AFTER_PHASE",
    "FACTORY_KIT_ORIGIN",
    "FACTORY_KITS_ROOT",
    "FACTORY_LAUNCH_TEST_ACCOUNT_HOME",
    "FACTORY_LAUNCH_TEST_HOME",
    "FACTORY_LAUNCH_TEST_MODE",
    "FACTORY_RELEASE_FAIL_AFTER_CUTOVER_PHASE",
    "FACTORY_RELEASE_TEST_HOME",
}
raise SystemExit(0 if any(
    name in blocked or name.startswith("FACTORY_KIT_TEST_")
    for name in os.environ
) else 1)
PY
  then
    die "installed launcher refuses test mode and root overrides"
  fi
  HOME="$ACCOUNT_HOME"
  RAW_KITS_ROOT="$ACCOUNT_HOME/.factory/kits"
else
  QUALIFICATION_RELEASE="$(cd "$(dirname "$SELF_PATH")/.." 2>/dev/null && pwd -P)"
  QUALIFICATION_SHA="$(basename "$QUALIFICATION_RELEASE")"
  QUALIFICATION_ROOT="$(dirname "$(dirname "$QUALIFICATION_RELEASE")")"
  if [[ "$SELF_PATH" == "$QUALIFICATION_RELEASE/scripts/factory-launch" &&
        "$QUALIFICATION_SHA" =~ ^[0-9a-f]{40}$ &&
        "$QUALIFICATION_ROOT" =~ ^/private/tmp/nysa-sf-qualification\.[A-Za-z0-9._-]+$ ]]; then
    "$BOOTSTRAP_PYTHON" -I -S - "$QUALIFICATION_ROOT" <<'PY' ||
import os, stat, sys
path = os.path.realpath(sys.argv[1])
info = os.stat(path)
if info.st_uid != os.geteuid() or stat.S_IMODE(info.st_mode) != 0o700:
    raise SystemExit(1)
PY
      die "qualification release root is unsafe"
    QUALIFICATION_LAUNCHER=1
    HOME="$ACCOUNT_HOME"
    RAW_KITS_ROOT="$QUALIFICATION_ROOT"
  else
    [[ "${FACTORY_LAUNCH_TEST_MODE:-0}" == "1" ]] ||
      die "launcher must execute from the installed or sealed qualification trust root"
    ISOLATED_TEST_LAUNCHER=1
    if [[ -n "${FACTORY_LAUNCH_TEST_ACCOUNT_HOME:-}" ]]; then
      case "$FACTORY_LAUNCH_TEST_ACCOUNT_HOME" in
        /*) ;;
        *) die "test account home must be absolute" ;;
      esac
      [[ -d "$FACTORY_LAUNCH_TEST_ACCOUNT_HOME" ]] ||
        die "test account home is missing"
      TEST_ACCOUNT_HOME="$(cd "$FACTORY_LAUNCH_TEST_ACCOUNT_HOME" 2>/dev/null && pwd -P)" ||
        die "test account home cannot be resolved"
      [[ "$SELF_PATH" != "$TEST_ACCOUNT_HOME/.factory/bin/factory-launch" ]] ||
        die "installed launcher path refuses repository test mode"
    fi
    [[ -n "${FACTORY_LAUNCH_TEST_HOME:-}" &&
       -n "${FACTORY_KITS_ROOT:-}" ]] ||
      die "repository test mode requires explicit isolated roots"
    case "$FACTORY_LAUNCH_TEST_HOME" in
      /*) ;;
      *) die "test HOME must be absolute" ;;
    esac
    [[ -d "$FACTORY_LAUNCH_TEST_HOME" ]] || die "test HOME is missing"
    HOME="$(cd "$FACTORY_LAUNCH_TEST_HOME" 2>/dev/null && pwd -P)" ||
      die "test HOME cannot be resolved"
    "$BOOTSTRAP_PYTHON" -I -S - "$HOME" "$ACCOUNT_HOME" "$FACTORY_KITS_ROOT" <<'PY' ||
import os, pathlib, stat, sys
home, account, kits = map(pathlib.Path, map(os.path.realpath, sys.argv[1:]))
info = home.stat()
if (
    info.st_uid != os.geteuid()
    or stat.S_IMODE(info.st_mode) != 0o700
    or home == account or account in home.parents
    or kits != home / ".factory/kits"
):
    raise SystemExit(1)
PY
      die "repository test mode requires owner-only state outside the real account home"
    RAW_KITS_ROOT="$FACTORY_KITS_ROOT"
  fi
fi

export HOME
SAFE_PATH="$HOME/.factory/bin:/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin"
PATH="$SAFE_PATH"
export PATH

[[ $# -ge 2 ]] || usage
PROJECT="$1"
COMMAND="$2"
shift 2

[[ "$PROJECT" =~ ^[A-Za-z0-9][A-Za-z0-9._-]*$ ]] ||
  die "invalid project slug"

PYTHON_BIN="$BOOTSTRAP_PYTHON"

expand_absolute_path() {
  local value="$1"
  case "$value" in
    *'`'*|*'$('*)
      return 1
      ;;
  esac
  case "$value" in
    '${HOME}'/*) value="$HOME/${value#'${HOME}'/}" ;;
    '$HOME'/*) value="$HOME/${value#'$HOME'/}" ;;
    '~'/*) value="$HOME/${value#'~'/}" ;;
  esac
  case "$value" in
    /*) printf '%s\n' "$value" ;;
    *) return 1 ;;
  esac
}

RAW_TMPDIR="${TMPDIR:-/tmp}"
SAFE_TMPDIR="$(expand_absolute_path "$RAW_TMPDIR" 2>/dev/null || true)"
[[ -n "$SAFE_TMPDIR" && -d "$SAFE_TMPDIR" ]] ||
  die "TMPDIR must be an existing absolute path"
SAFE_TMPDIR="$(cd "$SAFE_TMPDIR" 2>/dev/null && pwd -P)" ||
  die "TMPDIR cannot be resolved"
TMPDIR="$SAFE_TMPDIR"
export TMPDIR

reject_symlink_components() {
  local path="$1" label="$2" current="/" remainder component
  case "$path" in /*) ;; *) die "$label contains a symlink" ;; esac
  remainder="${path#/}"
  while [[ -n "$remainder" ]]; do
    component="${remainder%%/*}"
    if [[ "$remainder" == "$component" ]]; then
      remainder=""
    else
      remainder="${remainder#*/}"
    fi
    [[ -n "$component" ]] || continue
    current="${current%/}/$component"
    [[ ! -L "$current" ]] || die "$label contains a symlink"
  done
}

require_managed_directory() {
  local path="$1" label="$2"
  [[ -d "$path" && ! -L "$path" ]] || die "$label is missing or a symlink"
  reject_symlink_components "$path" "$label"
}

require_managed_file() {
  local path="$1" label="$2"
  [[ -f "$path" && ! -L "$path" ]] || die "$label is missing or a symlink"
  reject_symlink_components "$path" "$label"
}

KITS_ROOT="$(expand_absolute_path "$RAW_KITS_ROOT" 2>/dev/null || true)"
[[ -n "$KITS_ROOT" ]] || die "factory kits root must be an absolute safe path"
require_managed_directory "$KITS_ROOT" "factory kits root"
KITS_ROOT="$(cd "$KITS_ROOT" 2>/dev/null && pwd -P)" ||
  die "factory kits root cannot be resolved"

require_managed_directory "$KITS_ROOT/projects" "factory projects directory"
require_managed_directory "$KITS_ROOT/releases" "factory releases directory"
require_managed_directory "$KITS_ROOT/projects/$PROJECT" "project state directory"
ACTIVE_FILE="$KITS_ROOT/projects/$PROJECT/active.json"
require_managed_file "$ACTIVE_FILE" "project active record"

# Open and parse active.json exactly once from its fixed managed path. Atomic
# replacements after this point cannot change any selected runtime identity.
ACTIVE_DATA="$("$PYTHON_BIN" -I -S - "$ACTIVE_FILE" "$PROJECT" \
  "$KITS_ROOT/contract-floor.json" "$KITS_ROOT/contract-cutover-journal.json" <<'PY'
import hashlib
import json
import os
import stat
import sys

path, expected_project, floor_path, cutover_path = sys.argv[1:]
def unique(pairs):
    value = {}
    for key, item in pairs:
        if key in value:
            raise ValueError("duplicate key")
        value[key] = item
    return value

def owner_json(candidate, maximum):
    descriptor = os.open(candidate, os.O_RDONLY | getattr(os, "O_NOFOLLOW", 0))
    try:
        before = os.fstat(descriptor)
        if (
            not stat.S_ISREG(before.st_mode)
            or before.st_uid != os.geteuid()
            or before.st_nlink != 1
            or stat.S_IMODE(before.st_mode) != 0o600
            or before.st_size > maximum
        ):
            raise ValueError("unsafe owner state")
        raw = os.read(descriptor, before.st_size + 1)
        after = os.fstat(descriptor)
        if len(raw) != before.st_size or (
            before.st_dev, before.st_ino, before.st_size, before.st_mtime_ns
        ) != (after.st_dev, after.st_ino, after.st_size, after.st_mtime_ns):
            raise ValueError("changed owner state")
        return json.loads(raw.decode("utf-8", "strict"), object_pairs_hook=unique)
    finally:
        os.close(descriptor)

descriptor = -1
try:
    descriptor = os.open(path, os.O_RDONLY | getattr(os, "O_NOFOLLOW", 0))
    before = os.fstat(descriptor)
    if (
        not stat.S_ISREG(before.st_mode)
        or before.st_uid != os.geteuid()
        or before.st_nlink != 1
        or stat.S_IMODE(before.st_mode) != 0o600
        or before.st_size > 131072
    ):
        raise ValueError("unsafe file")
    raw = os.read(descriptor, before.st_size + 1)
    after = os.fstat(descriptor)
    if len(raw) != before.st_size or (before.st_dev, before.st_ino, before.st_size) != (
        after.st_dev, after.st_ino, after.st_size
    ):
        raise ValueError("changed file")
    value = json.loads(raw.decode("utf-8", "strict"), object_pairs_hook=unique)
except Exception:
    raise SystemExit(1)
finally:
    if descriptor >= 0:
        os.close(descriptor)

required = (
    "project",
    "kit_sha",
    "kit_tree",
    "contract_version",
    "product_path",
    "release_path",
)
if any(key not in value for key in required):
    raise SystemExit(1)
if value["project"] != expected_project:
    raise SystemExit(1)
try:
    cutover_in_progress = False
    cutover = None
    if os.path.lexists(cutover_path):
        cutover = owner_json(cutover_path, 2_000_000)
        body = {key: item for key, item in cutover.items() if key != "record_sha256"}
        record = hashlib.sha256(
            (json.dumps(body, sort_keys=True, separators=(",", ":")) + "\n").encode()
        ).hexdigest()
        if (
            cutover.get("schema") != "nysa.software-factory.host-cutover-journal/v1"
            or cutover.get("record_sha256") != record
            or cutover.get("status") not in {"in-progress", "pass"}
        ):
            raise ValueError("invalid host cutover journal")
        cutover_in_progress = cutover["status"] == "in-progress"
    if os.path.lexists(floor_path):
        floor = owner_json(floor_path, 4096)
        if floor != {
            "minimum_major": 2,
            "schema": "nysa.software-factory.contract-floor/v1",
        } or not value["contract_version"].startswith("2."):
            raise ValueError("active contract is below floor")
    elif cutover is not None:
        if cutover.get("floor_required") is True or cutover.get("status") == "pass" or cutover.get("phase") in {
            "active_records_switched", "contract_floor_committed",
            "launcher_installed", "retired_runtime_removed", "healthy",
        }:
            raise ValueError("contract floor is missing after host cutover")
except Exception:
    raise SystemExit(1)
for key in required:
    item = value[key]
    if not isinstance(item, str) or not item or "\n" in item or "\r" in item or "\t" in item:
        raise SystemExit(1)
optional = (
    value.get("receipt_id", ""), value.get("product_tree", ""),
    value.get("qualification_mode", ""), value.get("takeover_kits_root", ""),
    value.get("operator_map_path", ""), value.get("runtime_ledger_path", ""),
    value.get("product_sha", ""),
    value.get("controller_state_path", ""),
    value.get("provider_state_path", ""),
    value.get("fallback_readiness_sha256", ""),
)
if value["contract_version"] == "2.0.0":
    for index, item in enumerate(optional):
        if not isinstance(item, str) or any(ch in item for ch in "\n\r\t"):
            raise SystemExit(1)
        if index < 2 and not item:
            raise SystemExit(1)
else:
    raise SystemExit(1)
runtime_tuple = value.get("runtime_tuple", {})
tuple_keys = {
    "factory_sha", "factory_tree", "product_sha", "product_tree",
    "contract_version", "node", "npm",
}
if runtime_tuple != {}:
    if (
        not isinstance(runtime_tuple, dict)
        or set(runtime_tuple) != tuple_keys
        or not optional[6]
    ):
        raise SystemExit(1)
    if any(
        not isinstance(runtime_tuple[key], str)
        or not runtime_tuple[key]
        or any(ch in runtime_tuple[key] for ch in "\n\r\t")
        for key in tuple_keys
    ):
        raise SystemExit(1)
else:
    runtime_tuple = {}
optional = tuple(item if item else "-" for item in optional)
print("\t".join((
    *[value[key] for key in required], *optional,
    json.dumps(runtime_tuple, sort_keys=True, separators=(",", ":")),
    runtime_tuple.get("node", "-"), runtime_tuple.get("npm", "-"),
    "true" if cutover_in_progress else "false",
)))
PY
)" || die "project active record is invalid"

# Deterministic repository-test hook for proving that the parsed active record
# remains authoritative if active.json is atomically replaced afterward.
if [[ "$ISOLATED_TEST_LAUNCHER" -eq 1 &&
      -n "${FACTORY_LAUNCH_TEST_ACTIVE_PARSED_MARKER:-}${FACTORY_LAUNCH_TEST_ACTIVE_PARSED_GATE:-}" ]]; then
  ACTIVE_PARSED_MARKER="${FACTORY_LAUNCH_TEST_ACTIVE_PARSED_MARKER:-}"
  ACTIVE_PARSED_GATE="${FACTORY_LAUNCH_TEST_ACTIVE_PARSED_GATE:-}"
  case "$ACTIVE_PARSED_MARKER" in "$TMPDIR"/*) ;; *) die "active parse marker must be under test TMPDIR" ;; esac
  case "$ACTIVE_PARSED_GATE" in "$TMPDIR"/*) ;; *) die "active parse gate must be under test TMPDIR" ;; esac
  : > "$ACTIVE_PARSED_MARKER" || die "active parse marker could not be created"
  ACTIVE_PARSED_TRIES=0
  while [[ ! -e "$ACTIVE_PARSED_GATE" ]]; do
    ACTIVE_PARSED_TRIES=$((ACTIVE_PARSED_TRIES + 1))
    [[ "$ACTIVE_PARSED_TRIES" -le 500 ]] || die "active parse gate timed out"
    sleep 0.01
  done
fi
unset FACTORY_LAUNCH_TEST_ACTIVE_PARSED_MARKER FACTORY_LAUNCH_TEST_ACTIVE_PARSED_GATE \
  ACTIVE_PARSED_MARKER ACTIVE_PARSED_GATE ACTIVE_PARSED_TRIES 2>/dev/null || true

IFS="$(printf '\t')" read -r ACTIVE_PROJECT KIT_SHA KIT_TREE ACTIVE_CONTRACT \
  ACTIVE_PRODUCT_PATH ACTIVE_RELEASE_PATH RECEIPT_ID ACTIVE_PRODUCT_TREE \
  QUALIFICATION_MODE TAKEOVER_KITS_ROOT ACTIVE_OPERATOR_MAP \
  ACTIVE_RUNTIME_LEDGER \
  ACTIVE_PRODUCT_SHA ACTIVE_CONTROLLER_STATE ACTIVE_PROVIDER_STATE \
  ACTIVE_FALLBACK_READINESS_SHA256 \
  ACTIVE_RUNTIME_TUPLE ACTIVE_RUNTIME_NODE \
  ACTIVE_RUNTIME_NPM HOST_CUTOVER_IN_PROGRESS <<EOF
$ACTIVE_DATA
EOF

[[ "$RECEIPT_ID" == "-" ]] && RECEIPT_ID=""
[[ "$ACTIVE_PRODUCT_TREE" == "-" ]] && ACTIVE_PRODUCT_TREE=""
[[ "$QUALIFICATION_MODE" == "-" ]] && QUALIFICATION_MODE=""
[[ "$TAKEOVER_KITS_ROOT" == "-" ]] && TAKEOVER_KITS_ROOT=""
[[ "$ACTIVE_OPERATOR_MAP" == "-" ]] && ACTIVE_OPERATOR_MAP=""
[[ "$ACTIVE_RUNTIME_LEDGER" == "-" ]] && ACTIVE_RUNTIME_LEDGER=""
[[ "$ACTIVE_PRODUCT_SHA" == "-" ]] && ACTIVE_PRODUCT_SHA=""
[[ "$ACTIVE_CONTROLLER_STATE" == "-" ]] && ACTIVE_CONTROLLER_STATE=""
[[ "$ACTIVE_PROVIDER_STATE" == "-" ]] && ACTIVE_PROVIDER_STATE=""
[[ "$ACTIVE_FALLBACK_READINESS_SHA256" == "-" ]] && ACTIVE_FALLBACK_READINESS_SHA256=""
[[ "$ACTIVE_RUNTIME_NODE" == "-" ]] && ACTIVE_RUNTIME_NODE=""
[[ "$ACTIVE_RUNTIME_NPM" == "-" ]] && ACTIVE_RUNTIME_NPM=""

[[ "$KIT_SHA" =~ ^[0-9a-f]{40}$ ]] ||
  die "active kit SHA is not a lowercase full SHA"
[[ "$KIT_TREE" =~ ^[0-9a-f]{40}$ ]] ||
  die "active kit tree is not a lowercase full object ID"

ACTIVE_PRODUCT_PATH="$(expand_absolute_path "$ACTIVE_PRODUCT_PATH" 2>/dev/null || true)"
ACTIVE_RELEASE_PATH="$(expand_absolute_path "$ACTIVE_RELEASE_PATH" 2>/dev/null || true)"
[[ -n "$ACTIVE_PRODUCT_PATH" && -n "$ACTIVE_RELEASE_PATH" ]] ||
  die "active record contains unsafe paths"
[[ -d "$ACTIVE_PRODUCT_PATH" && -d "$ACTIVE_RELEASE_PATH" ]] ||
  die "active record paths are missing"
require_managed_directory "$ACTIVE_PRODUCT_PATH" "active product path"
require_managed_directory "$ACTIVE_RELEASE_PATH" "active release path"
PRODUCT_ROOT="$(cd "$ACTIVE_PRODUCT_PATH" 2>/dev/null && pwd -P)" ||
  die "active product path cannot be resolved"
RELEASE_PATH="$(cd "$ACTIVE_RELEASE_PATH" 2>/dev/null && pwd -P)" ||
  die "active release path cannot be resolved"
[[ "$(git -C "$PRODUCT_ROOT" -c core.hooksPath=/dev/null \
  -c core.fsmonitor=false -c credential.helper= -c diff.external= \
  rev-parse --show-toplevel 2>/dev/null)" == "$PRODUCT_ROOT" ]] ||
  die "active product path is not an exact physical Git root"
if [[ "$ISOLATED_TEST_LAUNCHER" == "1" ]]; then
  "$BOOTSTRAP_PYTHON" -I -S - "$PRODUCT_ROOT" "$HOME" <<'PY' ||
import os, pathlib, sys
product, home = map(pathlib.Path, map(os.path.realpath, sys.argv[1:]))
if home not in product.parents:
    raise SystemExit(1)
PY
    die "repository test product escapes its isolated home"
fi
EXPECTED_RELEASE="$KITS_ROOT/releases/$KIT_SHA"
require_managed_directory "$EXPECTED_RELEASE" "expected release path"
EXPECTED_RELEASE="$(cd "$EXPECTED_RELEASE" 2>/dev/null && pwd -P)" ||
  die "expected release path cannot be resolved"
[[ "$RELEASE_PATH" == "$EXPECTED_RELEASE" ]] ||
  die "active release escapes its exact physical release location"

case "$ACTIVE_CONTRACT" in
  2.0.0) CONTRACT_VERSION="$ACTIVE_CONTRACT" ;;
  *) die "active Factory contract is incompatible" ;;
esac

if [[ "$HOST_CUTOVER_IN_PROGRESS" == "true" ]]; then
  case "$COMMAND" in
    contract|doctor|reconcile|incident-report|watch) ;;
    *) die "host cutover is in progress; command refused" ;;
  esac
fi

if [[ "$ISOLATED_TEST_LAUNCHER" == "1" ]]; then
  case "$COMMAND" in
    incident-report|publication-repair|ci-rerun|ticket-pr|ticket-attest)
      die "repository test mode refuses GitHub-mutating commands"
      ;;
  esac
fi

if [[ "$QUALIFICATION_LAUNCHER" == "1" ]]; then
  [[ "$ACTIVE_FALLBACK_READINESS_SHA256" =~ ^[0-9a-f]{64}$ ]] ||
    die "qualification fallback readiness binding is invalid"
  [[ "$QUALIFICATION_MODE" == "isolated" || "$QUALIFICATION_MODE" == "takeover" ]] ||
    die "qualification state mode is invalid"
  ACTIVE_OPERATOR_MAP="$(expand_absolute_path "$ACTIVE_OPERATOR_MAP" 2>/dev/null || true)"
  ACTIVE_RUNTIME_LEDGER="$(expand_absolute_path "$ACTIVE_RUNTIME_LEDGER" 2>/dev/null || true)"
  [[ -n "$ACTIVE_OPERATOR_MAP" ]] || die "qualification operator state is invalid"
  require_managed_file "$ACTIVE_OPERATOR_MAP" "qualification operator map"
  if [[ "$QUALIFICATION_MODE" == "takeover" ]]; then
    [[ "$TAKEOVER_KITS_ROOT" == "$ACCOUNT_HOME/.factory/kits" ]] ||
      die "qualification takeover root is invalid"
    require_managed_directory "$TAKEOVER_KITS_ROOT" "qualification takeover kits root"
    [[ -z "$ACTIVE_RUNTIME_LEDGER" ]] ||
      die "qualification takeover names isolated operator state"
  else
    [[ -z "$TAKEOVER_KITS_ROOT" ]] ||
      die "isolated qualification names takeover state"
    [[ -n "$ACTIVE_RUNTIME_LEDGER" ]] ||
      die "qualification runtime ledger is invalid"
    require_managed_file "$ACTIVE_RUNTIME_LEDGER" "qualification runtime ledger"
    [[ "$ACTIVE_OPERATOR_MAP" == "$HOME/.factory/qualification/$PROJECT/operator/operator-map.json" &&
       "$ACTIVE_RUNTIME_LEDGER" == "$HOME/.factory/qualification/$PROJECT/operator/runtime-ledger.csv" ]] ||
      die "isolated qualification operator state path is invalid"
  fi
else
  [[ -z "$QUALIFICATION_MODE$TAKEOVER_KITS_ROOT$ACTIVE_OPERATOR_MAP$ACTIVE_RUNTIME_LEDGER" ]] ||
    die "installed activation contains qualification controls"
fi

GLOBAL_ENV_PATH="$HOME/.factory/global.env"
if [[ "$QUALIFICATION_LAUNCHER" == "1" ]]; then
  GLOBAL_ENV_PATH="$QUALIFICATION_ROOT/global.env"
  require_managed_file "$GLOBAL_ENV_PATH" "qualification global config"
  "$PYTHON_BIN" -I -S - "$GLOBAL_ENV_PATH" <<'PY' ||
import os
import stat
import sys

path = sys.argv[1]
descriptor = os.open(path, os.O_RDONLY | getattr(os, "O_NOFOLLOW", 0))
try:
    metadata = os.fstat(descriptor)
finally:
    os.close(descriptor)
if (
    not stat.S_ISREG(metadata.st_mode)
    or metadata.st_uid != os.geteuid()
    or metadata.st_nlink != 1
    or stat.S_IMODE(metadata.st_mode) != 0o600
    or metadata.st_size > 131072
):
    raise SystemExit(1)
PY
    die "qualification global config is unsafe"
fi

CERTIFIED_PRODUCT_ORIGIN=""
if [[ "$CONTRACT_VERSION" == "2.0.0" ]]; then
  [[ "$RECEIPT_ID" =~ ^[0-9a-f]{64}$ ]] ||
    die "Contract 2 active record lacks a valid receipt binding"
  [[ "$ACTIVE_PRODUCT_TREE" =~ ^[0-9a-f]{40}$ ]] ||
    die "Contract 2 active record lacks a valid product tree binding"
  require_managed_directory "$KITS_ROOT/receipts" "factory certification receipts directory"
  RECEIPT_FILE="$KITS_ROOT/receipts/$RECEIPT_ID.json"
  require_managed_file "$RECEIPT_FILE" "active certification receipt"
CERTIFIED_PRODUCT_ORIGIN="$("$PYTHON_BIN" -I -S - "$RECEIPT_FILE" \
    "$RECEIPT_ID" "$PROJECT" "$KIT_SHA" "$KIT_TREE" "$PRODUCT_ROOT" \
    "$ACTIVE_PRODUCT_TREE" "$CONTRACT_VERSION" "$QUALIFICATION_MODE" \
    "$TAKEOVER_KITS_ROOT" "$ACTIVE_OPERATOR_MAP" "$ACTIVE_RUNTIME_LEDGER" \
    "$ACTIVE_PRODUCT_SHA" \
    "$ACTIVE_FALLBACK_READINESS_SHA256" \
    "$ACTIVE_RUNTIME_TUPLE" "$ISOLATED_TEST_LAUNCHER" <<'PY'
import json, os, stat, sys

(
    path, receipt_id, project, kit_sha, kit_tree, product_path, product_tree,
    contract, qualification_mode, takeover_kits_root, operator_map_path,
    runtime_ledger_path, product_sha, fallback_readiness_sha256, runtime_tuple,
    isolated_test,
) = sys.argv[1:]
flags = os.O_RDONLY | getattr(os, "O_NOFOLLOW", 0)
descriptor = os.open(path, flags)
try:
    metadata = os.fstat(descriptor)
    if not stat.S_ISREG(metadata.st_mode):
        raise SystemExit(1)
    if metadata.st_uid != os.geteuid() or stat.S_IMODE(metadata.st_mode) != 0o600:
        raise SystemExit(1)
    if metadata.st_size > 131072:
        raise SystemExit(1)
    with os.fdopen(descriptor, "r", encoding="utf-8", errors="strict") as handle:
        descriptor = -1
        value = json.load(handle)
finally:
    if descriptor >= 0:
        os.close(descriptor)
expected = {
    "receipt_id": receipt_id,
    "project": project,
    "kit_sha": kit_sha,
    "kit_tree": kit_tree,
    "product_path": product_path,
    "product_tree": product_tree,
    "contract_version": contract,
    "status": "pass",
}
if product_sha:
    expected["product_sha"] = product_sha
if runtime_tuple != "{}":
    expected["runtime_tuple"] = json.loads(runtime_tuple)
if any(value.get(key) != item for key, item in expected.items()):
    raise SystemExit(1)
if isolated_test == "1":
    origin = value.get("product_origin")
    if not isinstance(origin, str):
        raise SystemExit(1)
    if origin.startswith("file://"):
        origin = origin[7:]
    if not origin.startswith("/"):
        raise SystemExit(1)
    physical_origin = os.path.realpath(origin)
    home = os.path.realpath(os.environ["HOME"])
    if (
        not os.path.isdir(physical_origin)
        or os.path.commonpath([home, physical_origin]) != home
        or physical_origin == home
    ):
        raise SystemExit(1)
if isolated_test == "0" and not qualification_mode:
    suite = value.get("kit_suite_evidence")
    if (
        value.get("kit_origin") != "github.com/nysa-company/software-factory"
        or not isinstance(suite, dict)
        or suite.get("verification_source") != "github-actions-full"
        or suite.get("canonical_origin") != value.get("kit_origin")
    ):
        raise SystemExit(1)
if qualification_mode:
    if (
        value.get("qualification_mode") != qualification_mode
        or value.get("operator_map_path") != operator_map_path
        or value.get("fallback_readiness_sha256") != fallback_readiness_sha256
    ):
        raise SystemExit(1)
    if qualification_mode == "takeover":
        if (
            value.get("takeover_kits_root") != takeover_kits_root
            or "runtime_ledger_path" in value
        ):
            raise SystemExit(1)
    elif (
        "takeover_kits_root" in value
        or value.get("runtime_ledger_path") != runtime_ledger_path
    ):
        raise SystemExit(1)
origin = value.get("product_origin")
if not isinstance(origin, str) or not origin or any(ch in origin for ch in "\r\n\t"):
    raise SystemExit(1)
print(origin)
PY
)" || die "active certification receipt does not match the selected product release"
  if [[ "$ISOLATED_TEST_LAUNCHER" == "1" ]]; then
    ACTUAL_PRODUCT_ORIGIN="$(git -C "$PRODUCT_ROOT" \
      -c core.hooksPath=/dev/null -c core.fsmonitor=false \
      -c credential.helper= -c diff.external= \
      remote get-url --push --all origin 2>/dev/null)" ||
      die "repository test product push origin is unavailable"
    [[ "$ACTUAL_PRODUCT_ORIGIN" != *$'\n'* && "$ACTUAL_PRODUCT_ORIGIN" != *$'\r'* &&
       "$ACTUAL_PRODUCT_ORIGIN" != *$'\t'* ]] ||
      die "repository test product push origin is ambiguous"
    "$BOOTSTRAP_PYTHON" -I -S - "$ACTUAL_PRODUCT_ORIGIN" \
      "$CERTIFIED_PRODUCT_ORIGIN" <<'PY' ||
import os, sys
def physical(value):
    if value.startswith("file://"):
        value = value[7:]
    return os.path.realpath(value) if value.startswith("/") else ""
if not physical(sys.argv[1]) or physical(sys.argv[1]) != physical(sys.argv[2]):
    raise SystemExit(1)
PY
      die "repository test product push origin differs from its receipt"
  fi
fi

if [[ "$QUALIFICATION_LAUNCHER" == "1" && -n "$ACTIVE_PRODUCT_SHA" ]]; then
  QUALIFICATION_PRODUCT_SHA="$(git -C "$PRODUCT_ROOT" \
    -c core.hooksPath=/dev/null -c core.fsmonitor=false \
    -c credential.helper= -c diff.external= rev-parse HEAD 2>/dev/null)" ||
    die "qualification product SHA cannot be resolved"
  [[ "$QUALIFICATION_PRODUCT_SHA" == "$ACTIVE_PRODUCT_SHA" ]] ||
