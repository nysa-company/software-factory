#!/usr/bin/env python3
"""Run a pinned Gitleaks scan of repository history and working files."""

from __future__ import annotations

import argparse
import hashlib
import os
from pathlib import Path
import platform
import shutil
import subprocess
import sys
import tarfile
import tempfile
import urllib.request


VERSION = "8.30.1"
ARTIFACTS = {
    ("Darwin", "arm64"): ("darwin_arm64", "b40ab0ae55c505963e365f271a8d3846efbc170aa17f2607f13df610a9aeb6a5"),
    ("Darwin", "x86_64"): ("darwin_x64", "dfe101a4db2255fc85120ac7f3d25e4342c3c20cf749f2c20a18081af1952709"),
    ("Linux", "aarch64"): ("linux_arm64", "e4a487ee7ccd7d3a7f7ec08657610aa3606637dab924210b3aee62570fb4b080"),
    ("Linux", "x86_64"): ("linux_x64", "551f6fc83ea457d62a0d98237cbad105af8d557003051f41f3e7ca7b3f2470eb"),
}


def fail(message: str) -> "NoReturn":
    print(f"secret-scan: {message}", file=sys.stderr)
    raise SystemExit(2)


def find_root(start: Path) -> Path:
    result = subprocess.run(
        ["git", "rev-parse", "--show-toplevel"], cwd=start, text=True, capture_output=True
    )
    if result.returncode:
        fail("run inside a git repository")
    return Path(result.stdout.strip())


def install(root: Path) -> Path:
    override = os.environ.get("GITLEAKS_BIN")
    if override:
        binary = Path(override)
        if not binary.is_file() or not os.access(binary, os.X_OK):
            fail("GITLEAKS_BIN is not executable")
        return binary
    existing = shutil.which("gitleaks")
    if existing:
        return Path(existing)
    key = (platform.system(), platform.machine())
    if key not in ARTIFACTS:
        fail(f"unsupported platform: {key[0]} {key[1]}")
    suffix, expected = ARTIFACTS[key]
    target = root / ".context" / "tools" / "gitleaks" / VERSION / "gitleaks"
    if target.is_file() and os.access(target, os.X_OK):
        return target
    target.parent.mkdir(parents=True, exist_ok=True)
    url = f"https://github.com/gitleaks/gitleaks/releases/download/v{VERSION}/gitleaks_{VERSION}_{suffix}.tar.gz"
    print(f"secret-scan: installing pinned Gitleaks v{VERSION} in .context/tools")
    with tempfile.TemporaryDirectory() as tmp:
        archive = Path(tmp) / "gitleaks.tar.gz"
        try:
            urllib.request.urlretrieve(url, archive)
        except OSError as exc:
            fail(f"could not download pinned scanner: {exc}")
        actual = hashlib.sha256(archive.read_bytes()).hexdigest()
        if actual != expected:
            fail("download checksum mismatch")
        with tarfile.open(archive, "r:gz") as bundle:
            member = next((m for m in bundle.getmembers() if Path(m.name).name == "gitleaks" and m.isfile()), None)
            if member is None:
                fail("scanner archive did not contain gitleaks")
            extracted = bundle.extractfile(member)
            if extracted is None:
                fail("could not read gitleaks from scanner archive")
            target.write_bytes(extracted.read())
    target.chmod(0o755)
    return target


def run(binary: Path, root: Path, mode: str) -> int:
    commands = []
    common = [str(binary), "--redact", "--no-banner", "--exit-code", "1"]
    if mode in ("all", "history"):
        commands.append(common + ["git", str(root)])
    if mode in ("all", "directory"):
        commands.append(common + ["dir", str(root)])
    for command in commands:
        result = subprocess.run(command)
        if result.returncode:
            print("secret-scan: FAIL (findings are redacted)", file=sys.stderr)
            return result.returncode
    print("secret-scan: PASS")
    return 0


def main() -> int:
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--mode", choices=("all", "history", "directory"), default="all")
    parser.add_argument("--root", type=Path, default=Path.cwd())
    args = parser.parse_args()
    root = find_root(args.root.resolve())
    return run(install(root), root, args.mode)


if __name__ == "__main__":
    raise SystemExit(main())
