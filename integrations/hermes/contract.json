{
  "contract": "nysa.software-factory.hermes",
  "contract_version": "1.5.0",
  "doctor_schema": "nysa.software-factory.hermes-doctor/v1",
  "preflight_schema": "nysa.software-factory.preflight/v1",
  "next_stage_schema": "nysa.software-factory.next-stage/v1",
  "supported_hermes": [
    {
      "agent_version": "0.18.2",
      "build_version": "2026.7.7.2",
      "compatibility": "certified"
    }
  ],
  "profile": {
    "default_name": "factory",
    "default_path": "~/.hermes/profiles/factory",
    "project_registry": "projects/<project>.env",
    "required_registry_keys": [
      "PRODUCT_ROOT"
    ],
    "observed_ignored_registry_keys": [
      "KIT_DIR"
    ],
    "soul": "SOUL.md",
    "dispatcher_skill": "skills/factory-dispatch/SKILL.md"
  },
  "launcher": {
    "path": "~/.factory/bin/factory-launch",
    "source": "integrations/hermes/bin/factory-launch",
    "trust_root": {
      "account_home_source": "pwd.getpwuid(os.getuid()).pw_dir",
      "installed_physical_path": "<account-home>/.factory/bin/factory-launch",
      "production_kits_root": "<account-home>/.factory/kits",
      "production_profile_root": "<account-home>/.hermes/profiles/factory",
      "caller_home_and_root_overrides": "ignored or refused",
      "repository_test_mode": "explicit isolated roots allowed only from a non-installed launcher path"
    },
    "argument_order": [
      "<project>",
      "<command>",
      "[command arguments]"
    ],
    "commands": {
      "claim": {
        "arguments": [
          "--ticket",
          "<T-NNN>"
        ],
        "output": "one opaque ticket lease record; available when MAX_CONCURRENT_TICKETS is 2, 3, or 4"
      },
      "renew": {
        "arguments": [
          "--ticket",
          "<T-NNN>",
          "--lease",
          "<opaque-lease-id>"
        ],
        "output": "the renewed ticket lease record"
      },
      "release": {
        "arguments": [
          "--ticket",
          "<T-NNN>",
          "--lease",
          "<opaque-lease-id>"
        ],
        "output": "ticket lease release confirmation"
      },
      "contract": {
        "arguments": [
          "--json"
        ],
        "output": "this manifest"
      },
      "doctor": {
        "arguments": [
          "--json"
        ],
        "output_schema": "nysa.software-factory.hermes-doctor/v1"
      },
      "models": {
        "minimum_contract_version": "1.2.0",
        "helper": "scripts/model-control.sh",
        "grammars": [
          "profiles --json",
          "status --json",
          "policy-candidates --json",
          "policy-preview --policy <canonical-json> --json",
          "policy-apply --policy <canonical-json> --expected-current-hash <lowercase-sha256> --approve-hash <lowercase-sha256> --json",
          "reviewer-exception-contract --json",
          "ticket-status --ticket <T-NNN> --json",
          "plan --json",
          "plan --profile <safe-id> --json",
          "activate --profile <safe-id> --approve-hash <lowercase-sha256> --approved-by <safe-id> --json",
          "disable --scope-type <account-route|provider-family|model|route> --scope-id <safe-selection-or-id> --reason credits_exhausted --ttl-seconds <1..604800> --operator-id <safe-id> --json",
          "enable --scope-type <account-route|provider-family|model|route> --scope-id <safe-selection-or-id> --json",
          "pin --ticket <T-NNN> --workdir <exact-ticket-worktree> --json",
          "migrate-plan --ticket <T-NNN> --workdir <exact-clean-ticket-worktree> --json",
          "migrate --ticket <T-NNN> --workdir <exact-clean-ticket-worktree> --approve-hash <lowercase-sha256> --approved-by <safe-id> --json",
          "fallback-plan --ticket <T-NNN> --failed-run <safe-run-id> --workdir <exact-ticket-worktree> --reason <credits_exhausted|provider_unavailable> --json",
          "fallback --ticket <T-NNN> --failed-run <safe-run-id> --workdir <exact-ticket-worktree> --reason <credits_exhausted|provider_unavailable> [--allow-reviewer-family <safe-id>] --json"
        ],
        "output": "deterministic JSON emitted directly by the selected release model-control helper",
        "output_schemas": {
          "profiles": "model-manager-profiles/v1",
          "status": "model-manager-status/v1",
          "policy-candidates": "factory-model-policy-candidates/v1",
          "policy-preview": "factory-model-policy-preview/v1",
          "policy-apply": "factory-model-policy-apply/v1",
          "reviewer-exception-contract": "factory-reviewer-exception-contract/v1",
          "ticket-status": "factory-ticket-status/v1",
          "plan": "model-resolution-plan/v1",
          "activate": "model-routing-active/v1",
          "disable": "model-routing-overrides/v1",
          "enable": "model-routing-overrides/v1",
          "pin": "ticket-model-route-plan/v1 plus commit_created, commit_sha, and pin_hash",
          "migrate-plan": "ticket-model-route-migration-preview/v1",
          "migrate": "ticket-model-route-journal/v2 plus commit metadata",
          "fallback-plan": "ticket-model-fallback-preview/v1",
          "fallback": "ticket-model-route-journal/v2 plus handoff commit metadata"
        },
        "json_marker": "required as the final launcher argument and stripped before helper invocation",
        "maintenance": {
          "allowed": [
            "profiles",
            "status",
            "policy-candidates",
            "policy-preview",
            "reviewer-exception-contract",
            "ticket-status",
            "plan",
            "migrate-plan",
            "fallback-plan"
          ],
          "refused": [
            "activate",
            "disable",
            "enable",
            "policy-apply",
            "pin",
            "migrate",
            "fallback"
          ]
        },
        "state": {
          "root": "$FACTORY_KITS_ROOT/projects",
          "project": "<project>",
          "active_profile": "$FACTORY_KITS_ROOT/projects/<project>/routing/active.json",
          "temporary_overrides": "$FACTORY_KITS_ROOT/projects/<project>/routing/overrides.json",
          "ticket_route_plan": "<ticket-worktree>/factory/route-plans/<T-NNN>.json (v1 immutable plan or v2 append-only journal)",
          "isolation": "active profiles and temporary overrides are selected only from the validated launcher project"
        },
        "pin_transaction": {
          "first_pin": "validate a clean exact ticket branch and certified origin, record a missing Kit-SHA with the shared validated helper, generate the route plan, stage both paths, create exactly one Software Factory commit, and push HEAD to the exact ticket branch",
          "existing_pin": "an exact committed Kit-SHA and route plan is validated, pushed to the exact ticket branch, and returned without a new commit",
          "refusals": [
            "dirty worktree",
            "wrong or detached ticket branch",
            "certified product origin mismatch",
            "conflicting Kit-SHA or route plan",
            "uncommitted existing route plan",
            "partial or unexpected staged changes"
          ],
          "pre_commit_failure": "restore the ticket and route-plan paths and leave no staged-only state",
          "result_fields": [
            "commit_created",
            "commit_sha",
            "pin_hash"
          ]
        },
        "validation": [
          "exact argument order with no arbitrary manager, catalog, profile-file, or profile-override paths",
          "pin workdir uses the launcher's exact physical ticket worktree validation",
          "fallback uses a dedicated exact-worktree validator that permits only helper-validated partial changes",
          "fallback consumes one exact unexpired Linear operator approval bound to its preview hash",
          "profile GH_TOKEN is not passed to this task-free helper",
          "only pin receives the receipt-bound FACTORY_CERTIFIED_PRODUCT_ORIGIN",
          "task-bearing adapters do not inherit FACTORY_MODEL_STATE_ROOT or FACTORY_PROJECT"
        ]
      },
      "operator-snapshot": {
        "minimum_contract_version": "1.5.0",
        "helper": "scripts/operator-state.py",
        "grammars": [
          "workflow --json",
          "envelope --json",
          "spend --json"
        ],
        "output_schemas": {
          "workflow": "factory-operator-workflow/v1",
          "envelope": "factory-operator-envelope/v1",
          "spend": "factory-operator-spend/v1"
        },
        "security": "read-only, fixed selected project, no caller paths"
      },
      "envelope": {
        "minimum_contract_version": "1.5.0",
        "helper": "scripts/envelope-control.py",
        "grammars": [
          "inspect --json",
          "plan --set <KEY=value>... --json",
          "apply --set <KEY=value>... --approve-hash <lowercase-sha256> --json",
          "override-plan --scope <next-attempt|ticket|role|product-day|global-day> [--ticket <T-NNN>] [--role <role>] [--day <UTC-date>] --issued-at <UTC> --expires-at <UTC> --operator-id <safe-id> --reason <budget_exhausted|operator_requested> --set <KEY=value>... --json",
          "override-apply --scope <next-attempt|ticket|role|product-day|global-day> [--ticket <T-NNN>] [--role <role>] [--day <UTC-date>] --issued-at <UTC> --expires-at <UTC> --operator-id <safe-id> --reason <budget_exhausted|operator_requested> --set <KEY=value>... --approve-hash <lowercase-sha256> --json"
        ],
        "output_schemas": {
          "inspect": "factory-envelope-inspect/v1",
          "plan": "factory-envelope-preview/v1",
          "apply": "factory-envelope-preview/v1 with status applied",
          "override-plan": "factory-envelope-override-preview/v1",
          "override-apply": "factory-envelope-override-preview/v1 with status applied"
        },
        "security": "exact preview hash, bounded expiring override, fixed product/global paths"
      },
      "attempt": {
        "minimum_contract_version": "1.5.0",
        "helper": "scripts/attempt-cancel.py",
        "grammars": [
          "cancel-plan --ticket <T-NNN> --run <safe-run-id> --reason <budget_exhausted|operator_requested> --json",
          "cancel --ticket <T-NNN> --run <safe-run-id> --reason <budget_exhausted|operator_requested> --approve-hash <lowercase-sha256> --json"
        ],
        "output_schemas": {
          "cancel-plan": "factory-attempt-cancel-preview/v1",
          "cancel": "factory-attempt-cancel-receipt/v1"
        },
        "security": "exact run process identity, preview CAS, product-local signal, conservative post-GO accounting"
      },
      "next-stage": {
        "arguments": [
          "--ticket",
          "<T-NNN>",
          "[--lease <opaque-lease-id>]",
          "--workdir",
          "<absolute-product-worktree>",
          "--json"
        ],
        "output_schema": "nysa.software-factory.next-stage/v1",
        "contract_1_3_terminal_action": "COMPLETE means a valid attested Done ticket is present on protected main; release the matching dispatcher lease",
        "wrapper_fields": [
          "schema",
          "schema_version",
          "contract_version",
          "command",
          "project",
          "ticket",
          "status",
          "exit_code",
          "output",
          "action",
          "detail"
        ]
      },
      "preflight": {
        "arguments": [
          "--ticket",
          "<T-NNN>",
          "[--lease <opaque-lease-id>]",
          "--workdir",
          "<absolute-product-worktree>",
          "--json"
        ],
        "output_schema": "nysa.software-factory.preflight/v1",
        "wrapper_fields": [
          "schema",
          "schema_version",
          "contract_version",
          "command",
          "project",
          "ticket",
          "status",
          "exit_code",
          "output"
        ]
      },
      "ticket-state": {
        "arguments": [
          "--ticket",
          "<T-NNN>",
          "--workdir",
          "<absolute-product-worktree>",
          "--action",
          "<materialize|transition>",
          "[--state <ticket-state>]",
          "--json"
        ],
        "output": "the committed ticket state after applying the ignored operator overlay or requested transition",
        "transition_states": [
          "Planning",
          "Building",
          "Review",
          "Blocked-Escalated"
        ],
        "validation": [
          "absolute physical non-symlink distinct linked Git worktree root",
          "same Git common directory as registered PRODUCT_ROOT",
          "non-detached branch exactly matching TICKET_BRANCH_PREFIX plus ticket",
          "automatic pushes match the active certification receipt product origin",
          "generic transitions always exclude Awaiting Approval, Approved, and Done; contract 1.3 uses ticket-attest"
        ]
      },
      "ticket-attest": {
        "arguments": [
          "--ticket",
          "<T-NNN>",
          "[--lease <opaque-lease-id>]",
          "--workdir",
          "<absolute-worktree>",
          "--action",
          "<bundle|approval|done>",
          "--json"
        ],
        "output": "an evidence-bound tracked attestation and exact protected GitHub auto-merge request",
        "validation": [
          "available only under contract 1.3.0",
          "matching unexpired dispatcher lease required when MAX_CONCURRENT_TICKETS is greater than 1 and never persisted or returned",
          "bundle and approval require the exact clean ticket branch and remote tip",
          "bundle binds every successful role-run manifest to its exact committed six-role route-plan tuple, blob, digest, policy hash, and kit SHA",
          "initial done requires exact clean chore/tNNN-closeout with HEAD equal to origin/main; retries require the exact remote attested closeout commit",
          "AUTO_MERGE_METHOD is required and exactly squash, merge, or rebase",
          "done creates or reuses one exact closeout PR and requests protected auto-merge without bypass",
          "a valid existing closeout commit is retryable without another projection or commit",
          "all pushes use the certification receipt product origin",
          "GitHub credentials come only from the trusted Hermes profile"
        ]
      },
      "project-ledger": {
        "arguments": [
          "--ticket",
          "<T-NNN>",
          "--workdir",
          "<absolute-closeout-worktree>",
          "--json"
        ],
        "output_schema": "nysa.software-factory.ledger-projection/v1",
        "validation": [
          "absolute physical non-symlink distinct linked Git worktree root",
          "same Git common directory as registered PRODUCT_ROOT",
          "branch exactly chore/tNNN-closeout and based on origin/main",
          "clean worktree with no live or ambiguous product run"
        ]
      },
      "reorder-test-fixes": {
        "arguments": [
          "--ticket",
          "<T-NNN>",
          "--workdir",
          "<absolute-product-worktree>",
          "--",
          "<arguments for reorder-test-fixes.sh>"
        ],
        "output": "selected release helper process output and exit code",
        "workdir_validation": [
          "absolute physical non-symlink distinct linked Git worktree root",
          "same Git common directory as registered PRODUCT_ROOT",
          "non-detached branch exactly matching TICKET_BRANCH_PREFIX plus ticket",
          "resolved once before helper execution"
        ],
        "ticket_branch": "same policy as launcher.commands.run.ticket_branch"
      },
      "run": {
        "role_whitelist": [
          "planner",
          "spec-linter",
          "test-author",
          "builder",
          "reviewer",
          "narrator"
        ],
        "arguments": [
          "--role",
          "<role>",
          "--ticket",
          "<T-NNN>",
          "[--lease <opaque-lease-id>]",
          "--prompt-file",
          "$FACTORY_RELEASE_PATH/roles/<role>.md",
          "--workdir",
          "<absolute-product-worktree>",
          "--",
          "<task>"
        ],
        "output": "process exit plus release-bound run manifest",
        "validation": [
          "exact argument grammar; adapter overrides forbidden",
          "canonical non-symlink release role prompt",
          "absolute physical non-symlink distinct linked Git worktree root",
          "same Git common directory as registered PRODUCT_ROOT",
          "non-detached branch exactly matching TICKET_BRANCH_PREFIX plus ticket",
          "nonempty task",
          "automatic pushes match the active certification receipt product origin"
        ],
        "ticket_branch": {
          "descriptor": "PRODUCT_ROOT/factory/PROJECT.env",
          "key": "TICKET_BRANCH_PREFIX",
          "default_prefix": "ticket/",
          "expected": "<prefix><T-NNN>"
        }
      }
    },
    "helper_environment": {
      "FACTORY_RELEASE_SHA": "active record kit_sha",
      "FACTORY_RELEASE_TREE": "active record kit_tree",
      "FACTORY_RELEASE_PATH": "resolved physical release path",
      "FACTORY_RELEASE_CONTRACT_VERSION": "active record contract_version",
      "FACTORY_MODEL_STATE_ROOT": "resolved production kits projects directory",
      "FACTORY_PROJECT": "validated launcher project slug",
      "FACTORY_CERTIFIED_PRODUCT_ORIGIN": "contract 1.2+ certification receipt product_origin; consumed by trusted write helpers and never exposed to adapters",
      "FACTORY_DISPATCH_LEASE_ID": "validated optional ticket lease supplied by the dispatcher"
    },
    "helper_environment_allowlist": [
      "HOME",
      "PATH",
      "TMPDIR",
      "FACTORY_ROOT",
      "FACTORY_RELEASE_SHA",
      "FACTORY_RELEASE_TREE",
      "FACTORY_RELEASE_PATH",
      "FACTORY_RELEASE_CONTRACT_VERSION",
      "FACTORY_MODEL_STATE_ROOT",
      "FACTORY_PROJECT",
      "FACTORY_CERTIFIED_PRODUCT_ORIGIN",
      "FACTORY_DISPATCH_LEASE_ID",
      "GH_TOKEN"
    ],
    "helper_optional_credentials": {
      "GH_TOKEN": {
        "source": "$HERMES_FACTORY_PROFILE/.env",
        "assignment": "exactly one optional GH_TOKEN assignment parsed as data",
        "file_policy": "owner-owned regular non-symlink file with mode 0600",
        "caller_value_ignored": true
      }
    },
    "helper_safe_path": "$HOME/.factory/bin:/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin",
    "active_record": {
      "path": "$FACTORY_KITS_ROOT/projects/<project>/active.json",
      "required_fields": [
        "project",
        "kit_sha",
        "kit_tree",
        "contract_version",
        "product_path",
        "release_path"
      ],
      "contract_1_2_required_fields": [
        "receipt_id",
        "product_tree"
      ],
      "contract_1_2_receipt_binding": "contracts 1.2 and 1.3 use receipt_id to select an owner-only mode-0600 receipt whose project, kit SHA/tree, product path/tree, contract, and product origin bind trusted writes",
      "release_location": "$FACTORY_KITS_ROOT/releases/<kit_sha>",
      "selection": "resolved and validated once per invocation"
    },
    "managed_path_policy": "reject every symlink component before physical resolution"
  },
  "concurrency": {
    "descriptor": "PRODUCT_ROOT/factory/PROJECT.env",
    "key": "MAX_CONCURRENT_TICKETS",
    "default": 1,
    "maximum": 4,
    "enabled_value": 2,
    "enabled_values": [
      2,
      3,
      4
    ],
    "lease_required_when_greater_than": 1,
    "state": "PRODUCT_ROOT/factory/.dispatch-leases/<T-NNN>.json",
    "lease_ttl_seconds": 900,
    "stale_policy": "never reassigned automatically; recover explicitly through factory-kit under maintenance after active-run validation"
  },
  "status_categories": [
    "ok",
    "warning",
    "error",
    "unknown"
  ],
  "exit_codes": {
    "0": "no error-category checks",
    "1": "one or more error-category checks",
    "2": "invalid invocation"
  },
  "compatibility_sensitive_surfaces": [
    "contract.json",
    "bin/factory-launch",
    "templates/profile/SOUL.md",
    "templates/profile/skills/factory-dispatch/SKILL.md",
    "templates/launchd/com.nysa.hermes-factory-gateway.plist",
    "templates/launchd/com.nysa.hermes-dashboard.plist",
    "scripts/factory-doctor.sh",
    "roles/dispatcher.md",
    "scripts/preflight.sh",
    "scripts/next-stage.sh",
    "scripts/run-agent.sh",
    "scripts/ticket-state.sh",
    "scripts/ticket-attest.py",
    "scripts/ticket-attest.sh",
    "scripts/lib/effective_ticket.py",
    "scripts/lib/legacy_closeout.py",
    "scripts/lib/terminal_backfill.py",
    "scripts/legacy-closeout.py",
    "scripts/terminal-backfill.py",
    "scripts/lib/product-remote.sh",
    "scripts/ledger-view.py",
    "scripts/dispatch-lease.sh",
    "scripts/lib/dispatch-leases.sh",
    "scripts/factory-kit.sh",
    "scripts/kill-switch.sh",
    "scripts/reorder-test-fixes.sh",
    "scripts/model-control.sh",
    "scripts/model-manager.py",
    "scripts/model-router.py",
    "scripts/model-fallback.py",
    "scripts/envelope-control.py",
    "scripts/attempt-cancel.py",
    "scripts/operator-console.py",
    "scripts/operator-snapshot.py",
    "scripts/operator-state.py",
    "scripts/lib/backend-policy.sh",
    "scripts/lib/process-identity.py",
    "scripts/lib/failed_attempt_handoff.py",
    "scripts/lib/kit-pin.sh",
    "scripts/lib/model-fallback-approval.py",
    "scripts/lib/plain-config.sh",
    "scripts/lib/product-remote.sh",
    "scripts/model-routing/catalog-v1.json",
    "scripts/model-routing/handoff-boundaries-v1.json",
    "scripts/model-routing/profiles-v1.json",
    "factory/route-plans/<T-NNN>.json"
  ],
  "launch_agents": {
    "gateway": {
      "label": "com.nysa.hermes-factory-gateway",
      "scope": "factory profile only"
    },
    "dashboard": {
      "label": "com.nysa.hermes-dashboard",
      "scope": "machine-wide dashboard"
    }
  },
  "security": {
    "credential_reporting": "presence-only",
    "credential_values_forbidden": true,
    "credential_bearing_urls_forbidden": true,
    "profile_credential_source": "mode-0600 $HERMES_FACTORY_PROFILE/.env parsed as data and never sourced",
    "launch_agent_secrets_forbidden": true,
    "public_redaction": [
      "Authorization headers and bearer/basic/token values",
      "quoted, JSON, multiline, and multi-token sensitive-key values",
      "credential-bearing and ordinary URLs"
    ]
  }
}
