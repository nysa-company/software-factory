# Envelope limits for the conformance shakedown — deliberately tiny.
# Generated from ENVELOPE.md; run-agent.sh sources this file.
# 2026-07-12: raised for the first real-CLI ticket (T-101) — real runs cost
# ~$0.35 each and a ticket takes ~4 runs; the mock-era $1 ticket cap could not
# fit one real ticket. Caps remain hard.
PER_RUN_BUDGET_USD=0.50
PER_TICKET_BUDGET_USD=2.50
PER_RUN_MAX_TURNS=15
PER_RUN_TIMEOUT_MIN=5
DAILY_CAP_USD=4.00
