{"type":"item.completed","item":{"id":"item_4","type":"command_execution","command":"/bin/zsh -lc 'BASE=$(git merge-base origin/main HEAD)\ngit diff --stat \"$BASE\"..HEAD\ngit diff --check \"$BASE\"..HEAD\ngit diff \"$BASE\"..HEAD -- conformance/app/server.js conformance/app/tests/health-approvals.test.js conformance/app/tests/health.test.js conformance/factory/tickets/T-102.md\nprintf '\"'\\\\n--- SPEC ---\\\\n'\nsed -n '1,240p' conformance/SPEC.md\nprintf '\\\\n--- TICKET ---\\\\n'\nsed -n '1,180p' conformance/factory/tickets/T-102.md\nprintf '\\\\n--- SERVER ---\\\\n'\nnl -ba conformance/app/server.js | sed -n '1,230p'\nprintf '\\\\n--- NEW TEST ---\\\\n'\nnl -ba conformance/app/tests/health-approvals.test.js\nprintf '\\\\n--- LEGACY TEST ---\\\\n'\nnl -ba conformance/app/tests/health.test.js\"","aggregated_output":" conformance/app/server.js                      |   4 +-\n conformance/app/tests/health-approvals.test.js | 106 +++++++++++++++++++++++++\n conformance/factory/tickets/T-102.md           |  54 +++++++++++--\n 3 files changed, 158 insertions(+), 6 deletions(-)\ndiff --git a/conformance/app/server.js b/conformance/app/server.js\nindex daa8dc1..6749358 100644\n--- a/conformance/app/server.js\n+++ b/conformance/app/server.js\n@@ -144,7 +144,9 @@ const server = http.createServer(async (req, res) => {\n     if (req.method === \"GET\" && url.pathname === \"/health\") {\n       const queue = { pending: 0, done: 0, dead: 0 };\n       for (const j of state.jobs) if (j.status in queue) queue[j.status] += 1;\n-      return json(res, 200, { ok: true, queue });\n+      const approvals = { pending: 0, sent: 0, rejected: 0, blocked_recipient: 0 };\n+      for (const a of state.approvals) if (a.status in approvals) approvals[a.status] += 1;\n+      return json(res, 200, { ok: true, queue, approvals });\n     }\n     if (req.method === \"POST\" && url.pathname === \"/webhook/event\") {\n       const body = await readBody(req);\ndiff --git a/conformance/app/tests/health-approvals.test.js b/conformance/app/tests/health-approvals.test.js\nnew file mode 100644\nindex 0000000..6ae7ce5\n--- /dev/null\n+++ b/conformance/app/tests/health-approvals.test.js\n@@ -0,0 +1,106 @@\n+const { test } = require(\"node:test\");\n+const assert = require(\"node:assert\");\n+const { spawn } = require(\"node:child_process\");\n+const fs = require(\"node:fs\");\n+const path = require(\"node:path\");\n+const os = require(\"node:os\");\n+\n+const SERVER = path.join(__dirname, \"..\", \"server.js\");\n+\n+async function withServer(port, run) {\n+  const base = `http://localhost:${port}`;\n+  const dataDir = fs.mkdtempSync(path.join(os.tmpdir(), \"relay-health-approvals-test-\"));\n+  const proc = spawn(process.execPath, [SERVER], {\n+    env: {\n+      ...process.env,\n+      PORT: String(port),\n+      DATA_DIR: dataDir,\n+      WORKER_MS: \"50\",\n+      ALLOWLIST: \"test@example.com\",\n+    },\n+    stdio: \"ignore\",\n+  });\n+\n+  try {\n+    for (let i = 0; i < 50; i++) {\n+      try {\n+        if ((await fetch(`${base}/health`)).ok) break;\n+      } catch { /* not up yet */ }\n+      if (i === 49) throw new Error(\"server did not come up\");\n+      await new Promise(resolve => setTimeout(resolve, 100));\n+    }\n+    await run(base);\n+  } finally {\n+    proc.kill(\"SIGKILL\");\n+    fs.rmSync(dataDir, { recursive: true, force: true });\n+  }\n+}\n+\n+async function post(base, pathname, body = {}) {\n+  return fetch(base + pathname, {\n+    method: \"POST\",\n+    headers: { \"Content-Type\": \"application/json\" },\n+    body: JSON.stringify(body),\n+  });\n+}\n+\n+async function waitForApproval(base, id, tries = 60) {\n+  for (let i = 0; i < tries; i++) {\n+    const state = await (await fetch(`${base}/api/state`)).json();\n+    if (state.approvals.some(approval => approval.id === id)) return;\n+    await new Promise(resolve => setTimeout(resolve, 100));\n+  }\n+  throw new Error(`approval ${id} was not proposed`);\n+}\n+\n+async function assertHealth(base, expected) {\n+  const response = await fetch(`${base}/health`);\n+  assert.strictEqual(response.status, 200);\n+  assert.strictEqual(response.headers.get(\"content-type\"), \"application/json\");\n+  assert.strictEqual(await response.text(), JSON.stringify(expected));\n+}\n+\n+test(\"1. Fresh server\", async () => {\n+  await withServer(4731, async base => {\n+    await assertHealth(base, {\n+      ok: true,\n+      queue: { pending: 0, done: 0, dead: 0 },\n+      approvals: { pending: 0, sent: 0, rejected: 0, blocked_recipient: 0 },\n+    });\n+  });\n+});\n+\n+test(\"2. One pending approval\", async () => {\n+  await withServer(4732, async base => {\n+    await post(base, \"/webhook/event\", {\n+      id: \"health-one-pending\",\n+      payload: { to: \"test@example.com\" },\n+    });\n+    await waitForApproval(base, \"appr-health-one-pending\");\n+\n+    await assertHealth(base, {\n+      ok: true,\n+      queue: { pending: 0, done: 1, dead: 0 },\n+      approvals: { pending: 1, sent: 0, rejected: 0, blocked_recipient: 0 },\n+    });\n+  });\n+});\n+\n+test(\"3. Approved\", async () => {\n+  await withServer(4733, async base => {\n+    await post(base, \"/webhook/event\", {\n+      id: \"health-approved\",\n+      payload: { to: \"test@example.com\" },\n+    });\n+    await waitForApproval(base, \"appr-health-approved\");\n+\n+    const approval = await post(base, \"/api/approvals/appr-health-approved/approve\");\n+    assert.strictEqual(approval.status, 200);\n+\n+    await assertHealth(base, {\n+      ok: true,\n+      queue: { pending: 0, done: 1, dead: 0 },\n+      approvals: { pending: 0, sent: 1, rejected: 0, blocked_recipient: 0 },\n+    });\n+  });\n+});\ndiff --git a/conformance/factory/tickets/T-102.md b/conformance/factory/tickets/T-102.md\nindex d3cd11a..b8e0a9b 100644\n--- a/conformance/factory/tickets/T-102.md\n+++ b/conformance/factory/tickets/T-102.md\n@@ -1,7 +1,7 @@\n # T-102 — /health reports approvals summary\n \n-State: Ready\n-Branch: (planner creates: ticket/T-102-health-approvals-summary)\n+State: In progress\n+Branch: ticket/T-102-health-approvals-summary\n Risk class: low (read-only endpoint, no external actions)\n \n ## Description\n@@ -12,9 +12,45 @@ The approval statuses in `conformance/app/server.js` are: `pending`, `sent`, `re\n \n ## Acceptance criteria (planner freezes the exact contract)\n \n-1. On a fresh server, `/health` reports zero approvals in every status.\n-2. After a job completes and proposes an action, `/health` shows one pending approval.\n-3. After that approval is approved, `/health` shows it under sent, and pending returns to zero.\n+1. On a fresh server, `/health` reports zero approvals in every status. → satisfied when the response body matches Frozen contract §\"Fresh server\" exactly.\n+2. After a job completes and proposes an action, `/health` shows one pending approval. → satisfied when the response body matches Frozen contract §\"One pending approval\" exactly.\n+3. After that approval is approved, `/health` shows it under sent, and pending returns to zero. → satisfied when the response body matches Frozen contract §\"Approved\" exactly.\n+\n+## Frozen contract\n+\n+`GET /health` gains an `approvals` field alongside the existing `ok` and `queue` fields (unchanged, per T-101). Response is `200 OK`, `Content-Type: application/json`.\n+\n+Shape:\n+\n+```json\n+{\n+  \"ok\": true,\n+  \"queue\": { \"pending\": 0, \"done\": 0, \"dead\": 0 },\n+  \"approvals\": { \"pending\": 0, \"sent\": 0, \"rejected\": 0, \"blocked_recipient\": 0 }\n+}\n+```\n+\n+- `approvals` has exactly these four keys, always present, in this order, values are non-negative integers counting `state.approvals` entries by `.status` (statuses defined in `conformance/app/server.js`: `pending`, `sent`, `rejected`, `blocked_recipient`).\n+- No other keys are added to `approvals`. No existing key of the top-level response (`ok`, `queue`) changes shape or meaning.\n+\n+Acceptance criterion → exact expected body:\n+\n+1. **Fresh server** (AC1) — no events posted yet:\n+   ```json\n+   { \"ok\": true, \"queue\": { \"pending\": 0, \"done\": 0, \"dead\": 0 }, \"approvals\": { \"pending\": 0, \"sent\": 0, \"rejected\": 0, \"blocked_recipient\": 0 } }\n+   ```\n+\n+2. **One pending approval** (AC2) — after posting an event and waiting for its job to reach `done` (which produces one approval in `pending`):\n+   ```json\n+   { \"ok\": true, \"queue\": { \"pending\": 0, \"done\": 1, \"dead\": 0 }, \"approvals\": { \"pending\": 1, \"sent\": 0, \"rejected\": 0, \"blocked_recipient\": 0 } }\n+   ```\n+\n+3. **Approved** (AC3) — after `POST /api/approvals/:id/approve` on that approval (recipient on allowlist, so it succeeds):\n+   ```json\n+   { \"ok\": true, \"queue\": { \"pending\": 0, \"done\": 1, \"dead\": 0 }, \"approvals\": { \"pending\": 0, \"sent\": 1, \"rejected\": 0, \"blocked_recipient\": 0 } }\n+   ```\n+\n+If this contract proves wrong during build or test-authoring, the ticket goes back to Ready for re-planning as a new version — do not silently change the shape.\n \n ## Conventions\n \n@@ -25,3 +61,11 @@ The approval statuses in `conformance/app/server.js` are: `pending`, `sent`, `re\n ## Log\n \n - 2026-07-12: ticket created by the operator; State → Ready. First ticket to be dispatched by Hermes (dispatcher trial).\n+- 2026-07-12: planner froze `GET /health` `approvals` contract and mapped acceptance criteria to exact response bodies.\n+- 2026-07-12 21:01:57: planner run completed through the wrapper; contract frozen in commit `8f0bc25`; State → In progress; cost $0.3306252.\n+- 2026-07-12 21:06:49: test-author run completed through the wrapper; 3 contract tests committed in `18a7731`, all failing for the expected missing `approvals` field (0 passed, 3 failed); cost $0.2296.\n+- 2026-07-12: builder implemented the frozen contract exactly (added `approvals` counts to the `/health` handler in `conformance/app/server.js`). `tests/health-approvals.test.js` (3/3) passes with exact `JSON.stringify` matches, confirming the implementation matches the frozen contract. **Blocked before commit:** this breaks all 4 pre-existing T-101 tests in `tests/health.test.js` (tests 1, 1b, 2, 3), which assert the `/health` body with `assert.deepStrictEqual(...)` against object literals that have no `approvals` key — `deepStrictEqual` rejects any extra key, so adding `approvals` anywhere in the response necessarily fails them. This is not an implementation bug: no server-side change can satisfy both \"exact frozen `approvals` shape per AC1–3\" and \"T-101's `health.test.js` stays green,\" because the latter was written before this contract existed and asserts an exact object with no extra keys. Per the builder's no-test-editing rule, I have not touched `tests/health.test.js` or any other test file, and have not committed the (correct, but suite-red) implementation change. Flagging for re-planning/reviewer adjudication: either (a) the contract stands and `health.test.js`'s 4 assertions need updating by the test-author/reviewer to tolerate/expect the new `approvals` key, or (b) the contract needs to change. Full suite as of this run: 11 passed, 4 failed (all 4 failures are the `health.test.js` ones described above; `health-approvals.test.js` and `conformance.test.js` are fully green).\n+- 2026-07-12 21:10:01: builder run completed through the wrapper and committed implementation plus its ticket note in `5e201e0`; new contract tests pass 3/3 but the full suite is red (11 passed, 4 pre-existing T-101 health tests failed); State → Blocked-Escalated; cost $0.6861495. Javier must decide whether the frozen additive contract stands and authorize test-author updates to `conformance/app/tests/health.test.js`, or send T-102 back to planner for a revised contract.\n+- 2026-07-12: operator decision — the frozen additive T-102 contract stands; test-author is authorized to update only the exact-match `/health` expectations in `conformance/app/tests/health.test.js` to include the frozen `approvals` object; State → In progress.\n+- 2026-07-12: dispatch stopped because mandatory `next-stage.sh --ticket T-102` returned `RUN reviewer`, not `RUN test-author`; State → Blocked-Escalated. Javier must reconcile the sequencer/bookkeeping so it names the authorized test-author correction; no role run was launched.\n+- 2026-07-12: operator resolution — no state surgery is needed; the frozen additive contract stands, the stale pre-T-102 exact-match assertions in `conformance/app/tests/health.test.js` are the fault, and `RUN reviewer` is the legal adjudication step; State → In progress.\n\n--- SPEC ---\n# Conformance product — \"Relay\"\n\nA deliberately small product shaped like Nysa's hard parts, used to shake down the factory kit and re-run after any kit change. It is disposable as a product and permanent as a test bed.\n\n## Why these features\n\nNysa's real failure modes are not CRUD — they are intake, async processing, approval-before-external-action, and partial failure. Relay has exactly those and nothing else:\n\n| Relay feature | Stands in for (Nysa) |\n|---|---|\n| Webhook event intake, idempotent by event id | Meeting-bot / email intake (duplicate deliveries happen) |\n| Durable background job with retries + dead-letter | Transcript processing, knowledge extraction |\n| Proposed action requiring approval before execution | Propose→approval autonomy rule |\n| Sandboxed send (allowlisted recipients, outbox record) | Gmail send connector in sandbox mode |\n| Crash recovery from persisted state | The always-on service being redeployed/killed mid-work |\n\n## Behavior spec\n\n1. `POST /webhook/event` with `{id, type, payload}` accepts an event. A repeated `id` is acknowledged but never creates a second job (idempotency).\n2. Each accepted event enqueues one background job. The worker retries a failing job up to 3 attempts, then marks it dead (dead-letter) — visible, never silently dropped.\n3. A successful job produces a **proposed action** (a send: `to`, `subject`, `body`) in state `pending`. Nothing is sent at this point.\n4. `POST /api/approvals/:id/approve` executes the send **only if** the recipient is on the allowlist; the send is a record in the outbox (sandbox — no real delivery). A non-allowlisted recipient is refused even when approved, recorded as `blocked_recipient`.\n5. `POST /api/approvals/:id/reject` closes the proposal; nothing sends.\n6. All state persists to disk atomically on every change. Killing the process at any moment loses nothing: on restart, accepted events, unfinished jobs, and pending approvals resume.\n7. `GET /` shows a minimal UI: events, jobs (with attempts), approvals, outbox. `GET /api/state` returns the same as JSON.\n\n## Test cases (the conformance suite)\n\n1. Walking skeleton: event in → visible in list.\n2. Duplicate event id → exactly one job.\n3. Transient failure (`payload.failTimes: 2`) → succeeds on attempt 3, attempts recorded.\n4. Permanent failure → dead after 3 attempts, visible in dead-letter.\n5. Approval gate: outbox empty before approval; send appears only after approve.\n6. Allowlist: approved send to an unlisted recipient is blocked, recorded, not sent.\n7. Crash recovery: kill the server mid-flight; restart; pending work completes; nothing duplicated.\n\nConfig via env: `PORT` (default 4700), `DATA_DIR` (default `./data`), `ALLOWLIST` (comma-separated, default `test@example.com`), `WORKER_MS` (worker tick, default 200).\n\n## Known modeling limitation\n\nRelay's \"send\" is an in-process outbox write persisted atomically with the status change, so the real-world failure window — crash *between* an external side effect and recording its receipt — cannot occur here. That window is a product-engine concern (idempotency keys on the connector, write-then-verify), owed by each product's engine spec; Relay tests everything up to that boundary.\n\n--- TICKET ---\n# T-102 — /health reports approvals summary\n\nState: In progress\nBranch: ticket/T-102-health-approvals-summary\nRisk class: low (read-only endpoint, no external actions)\n\n## Description\n\nT-101 gave operators queue counts on `GET /health`. The other thing an operator checks at a glance is the approvals pipeline: how many proposed actions are waiting for a human, and how the closed ones ended. Extend `GET /health` to also report approvals counts by status.\n\nThe approval statuses in `conformance/app/server.js` are: `pending`, `sent`, `rejected`, `blocked_recipient`. The existing `ok` and `queue` fields must not change (T-101's tests stay green).\n\n## Acceptance criteria (planner freezes the exact contract)\n\n1. On a fresh server, `/health` reports zero approvals in every status. → satisfied when the response body matches Frozen contract §\"Fresh server\" exactly.\n2. After a job completes and proposes an action, `/health` shows one pending approval. → satisfied when the response body matches Frozen contract §\"One pending approval\" exactly.\n3. After that approval is approved, `/health` shows it under sent, and pending returns to zero. → satisfied when the response body matches Frozen contract §\"Approved\" exactly.\n\n## Frozen contract\n\n`GET /health` gains an `approvals` field alongside the existing `ok` and `queue` fields (unchanged, per T-101). Response is `200 OK`, `Content-Type: application/json`.\n\nShape:\n\n```json\n{\n  \"ok\": true,\n  \"queue\": { \"pending\": 0, \"done\": 0, \"dead\": 0 },\n  \"approvals\": { \"pending\": 0, \"sent\": 0, \"rejected\": 0, \"blocked_recipient\": 0 }\n}\n```\n\n- `approvals` has exactly these four keys, always present, in this order, values are non-negative integers counting `state.approvals` entries by `.status` (statuses defined in `conformance/app/server.js`: `pending`, `sent`, `rejected`, `blocked_recipient`).\n- No other keys are added to `approvals`. No existing key of the top-level response (`ok`, `queue`) changes shape or meaning.\n\nAcceptance criterion → exact expected body:\n\n1. **Fresh server** (AC1) — no events posted yet:\n   ```json\n   { \"ok\": true, \"queue\": { \"pending\": 0, \"done\": 0, \"dead\": 0 }, \"approvals\": { \"pending\": 0, \"sent\": 0, \"rejected\": 0, \"blocked_recipient\": 0 } }\n   ```\n\n2. **One pending approval** (AC2) — after posting an event and waiting for its job to reach `done` (which produces one approval in `pending`):\n   ```json\n   { \"ok\": true, \"queue\": { \"pending\": 0, \"done\": 1, \"dead\": 0 }, \"approvals\": { \"pending\": 1, \"sent\": 0, \"rejected\": 0, \"blocked_recipient\": 0 } }\n   ```\n\n3. **Approved** (AC3) — after `POST /api/approvals/:id/approve` on that approval (recipient on allowlist, so it succeeds):\n   ```json\n   { \"ok\": true, \"queue\": { \"pending\": 0, \"done\": 1, \"dead\": 0 }, \"approvals\": { \"pending\": 0, \"sent\": 1, \"rejected\": 0, \"blocked_recipient\": 0 } }\n   ```\n\nIf this contract proves wrong during build or test-authoring, the ticket goes back to Ready for re-planning as a new version — do not silently change the shape.\n\n## Conventions\n\n- App lives in `conformance/app/` (zero-dependency Node 18+; see `conformance/SPEC.md`).\n- Tests go in `conformance/app/tests/` — new file `tests/health-approvals.test.js`, same style as the existing suites (node:test, spawn the real server on its own port with a temp DATA_DIR).\n- Run tests from `conformance/app/` with `node --test tests/health-approvals.test.js`.\n\n## Log\n\n- 2026-07-12: ticket created by the operator; State → Ready. First ticket to be dispatched by Hermes (dispatcher trial).\n- 2026-07-12: planner froze `GET /health` `approvals` contract and mapped acceptance criteria to exact response bodies.\n- 2026-07-12 21:01:57: planner run completed through the wrapper; contract frozen in commit `8f0bc25`; State → In progress; cost $0.3306252.\n- 2026-07-12 21:06:49: test-author run completed through the wrapper; 3 contract tests committed in `18a7731`, all failing for the expected missing `approvals` field (0 passed, 3 failed); cost $0.2296.\n- 2026-07-12: builder implemented the frozen contract exactly (added `approvals` counts to the `/health` handler in `conformance/app/server.js`). `tests/health-approvals.test.js` (3/3) passes with exact `JSON.stringify` matches, confirming the implementation matches the frozen contract. **Blocked before commit:** this breaks all 4 pre-existing T-101 tests in `tests/health.test.js` (tests 1, 1b, 2, 3), which assert the `/health` body with `assert.deepStrictEqual(...)` against object literals that have no `approvals` key — `deepStrictEqual` rejects any extra key, so adding `approvals` anywhere in the response necessarily fails them. This is not an implementation bug: no server-side change can satisfy both \"exact frozen `approvals` shape per AC1–3\" and \"T-101's `health.test.js` stays green,\" because the latter was written before this contract existed and asserts an exact object with no extra keys. Per the builder's no-test-editing rule, I have not touched `tests/health.test.js` or any other test file, and have not committed the (correct, but suite-red) implementation change. Flagging for re-planning/reviewer adjudication: either (a) the contract stands and `health.test.js`'s 4 assertions need updating by the test-author/reviewer to tolerate/expect the new `approvals` key, or (b) the contract needs to change. Full suite as of this run: 11 passed, 4 failed (all 4 failures are the `health.test.js` ones described above; `health-approvals.test.js` and `conformance.test.js` are fully green).\n- 2026-07-12 21:10:01: builder run completed through the wrapper and committed implementation plus its ticket note in `5e201e0`; new contract tests pass 3/3 but the full suite is red (11 passed, 4 pre-existing T-101 health tests failed); State → Blocked-Escalated; cost $0.6861495. Javier must decide whether the frozen additive contract stands and authorize test-author updates to `conformance/app/tests/health.test.js`, or send T-102 back to planner for a revised contract.\n- 2026-07-12: operator decision — the frozen additive T-102 contract stands; test-author is authorized to update only the exact-match `/health` expectations in `conformance/app/tests/health.test.js` to include the frozen `approvals` object; State → In progress.\n- 2026-07-12: dispatch stopped because mandatory `next-stage.sh --ticket T-102` returned `RUN reviewer`, not `RUN test-author`; State → Blocked-Escalated. Javier must reconcile the sequencer/bookkeeping so it names the authorized test-author correction; no role run was launched.\n- 2026-07-12: operator resolution — no state surgery is needed; the frozen additive contract stands, the stale pre-T-102 exact-match assertions in `conformance/app/tests/health.test.js` are the fault, and `RUN reviewer` is the legal adjudication step; State → In progress.\n\n--- SERVER ---\n     1\t// Relay — conformance product. Zero dependencies; Node 18+.\n     2\t// See ../SPEC.md for the behavior contract this implements.\n     3\tconst http = require(\"node:http\");\n     4\tconst fs = require(\"node:fs\");\n     5\tconst path = require(\"node:path\");\n     6\tconst crypto = require(\"node:crypto\");\n     7\t\n     8\tconst PORT = Number(process.env.PORT || 4700);\n     9\tconst DATA_DIR = process.env.DATA_DIR || path.join(__dirname, \"data\");\n    10\tconst STATE_FILE = path.join(DATA_DIR, \"state.json\");\n    11\tconst ALLOWLIST = (process.env.ALLOWLIST || \"test@example.com\").split(\",\").map(s => s.trim());\n    12\tconst WORKER_MS = Number(process.env.WORKER_MS || 200);\n    13\tconst MAX_ATTEMPTS = 3;\n    14\t\n    15\t// ---------- durable state ----------\n    16\tlet state = { events: [], jobs: [], approvals: [], outbox: [] };\n    17\t\n    18\tfunction loadState() {\n    19\t  try {\n    20\t    state = JSON.parse(fs.readFileSync(STATE_FILE, \"utf8\"));\n    21\t  } catch {\n    22\t    /* first boot or unreadable: start clean */\n    23\t  }\n    24\t}\n    25\t\n    26\t// Atomic persist: write temp file, then rename. A crash mid-write never\n    27\t// corrupts the previous good state.\n    28\tfunction persist() {\n    29\t  fs.mkdirSync(DATA_DIR, { recursive: true });\n    30\t  const tmp = STATE_FILE + \".\" + crypto.randomBytes(4).toString(\"hex\");\n    31\t  fs.writeFileSync(tmp, JSON.stringify(state, null, 2));\n    32\t  fs.renameSync(tmp, STATE_FILE);\n    33\t}\n    34\t\n    35\t// ---------- domain ----------\n    36\tfunction acceptEvent(evt) {\n    37\t  if (!evt || typeof evt.id !== \"string\" || !evt.id) return { ok: false, error: \"missing event id\" };\n    38\t  const existing = state.events.find(e => e.id === evt.id);\n    39\t  if (existing) return { ok: true, duplicate: true, eventId: evt.id }; // idempotent ack\n    40\t  state.events.push({ id: evt.id, type: evt.type || \"generic\", payload: evt.payload || {}, receivedAt: new Date().toISOString() });\n    41\t  state.jobs.push({\n    42\t    id: \"job-\" + evt.id,\n    43\t    eventId: evt.id,\n    44\t    status: \"pending\", // pending | done | dead\n    45\t    attempts: 0,\n    46\t    lastError: null,\n    47\t  });\n    48\t  persist();\n    49\t  return { ok: true, duplicate: false, eventId: evt.id };\n    50\t}\n    51\t\n    52\tfunction processJob(job) {\n    53\t  const evt = state.events.find(e => e.id === job.eventId);\n    54\t  job.attempts += 1;\n    55\t  // Simulated transient/permanent failure: payload.failTimes = number of\n    56\t  // attempts that must fail before success (99 = effectively permanent).\n    57\t  const failTimes = Number(evt?.payload?.failTimes || 0);\n    58\t  if (job.attempts <= failTimes) {\n    59\t    job.lastError = `simulated failure on attempt ${job.attempts}`;\n    60\t    if (job.attempts >= MAX_ATTEMPTS) job.status = \"dead\";\n    61\t    persist();\n    62\t    return;\n    63\t  }\n    64\t  // Success: produce a proposed action requiring approval. Nothing sends here.\n    65\t  state.approvals.push({\n    66\t    id: \"appr-\" + job.eventId,\n    67\t    jobId: job.id,\n    68\t    action: {\n    69\t      to: evt?.payload?.to || ALLOWLIST[0],\n    70\t      subject: evt?.payload?.subject || `Follow-up for ${job.eventId}`,\n    71\t      body: evt?.payload?.body || \"Proposed by Relay worker.\",\n    72\t    },\n    73\t    status: \"pending\", // pending | sent | rejected | blocked_recipient\n    74\t    proposedAt: new Date().toISOString(),\n    75\t  });\n    76\t  job.status = \"done\";\n    77\t  job.lastError = null;\n    78\t  persist();\n    79\t}\n    80\t\n    81\tfunction workerTick() {\n    82\t  const job = state.jobs.find(j => j.status === \"pending\");\n    83\t  if (job) processJob(job);\n    84\t}\n    85\t\n    86\tfunction approve(id) {\n    87\t  const appr = state.approvals.find(a => a.id === id);\n    88\t  if (!appr) return { ok: false, code: 404, error: \"no such approval\" };\n    89\t  if (appr.status !== \"pending\") return { ok: false, code: 409, error: `already ${appr.status}` };\n    90\t  if (!ALLOWLIST.includes(appr.action.to)) {\n    91\t    appr.status = \"blocked_recipient\";\n    92\t    persist();\n    93\t    return { ok: false, code: 403, error: `recipient ${appr.action.to} not on allowlist — send blocked`, status: appr.status };\n    94\t  }\n    95\t  state.outbox.push({ ...appr.action, approvalId: appr.id, sentAt: new Date().toISOString() });\n    96\t  appr.status = \"sent\";\n    97\t  persist();\n    98\t  return { ok: true, status: \"sent\" };\n    99\t}\n   100\t\n   101\tfunction reject(id) {\n   102\t  const appr = state.approvals.find(a => a.id === id);\n   103\t  if (!appr) return { ok: false, code: 404, error: \"no such approval\" };\n   104\t  if (appr.status !== \"pending\") return { ok: false, code: 409, error: `already ${appr.status}` };\n   105\t  appr.status = \"rejected\";\n   106\t  persist();\n   107\t  return { ok: true, status: \"rejected\" };\n   108\t}\n   109\t\n   110\t// ---------- http ----------\n   111\tfunction json(res, code, obj) {\n   112\t  res.writeHead(code, { \"Content-Type\": \"application/json\" });\n   113\t  res.end(JSON.stringify(obj));\n   114\t}\n   115\t\n   116\tfunction readBody(req) {\n   117\t  return new Promise((resolve, reject) => {\n   118\t    let data = \"\";\n   119\t    req.on(\"data\", c => { data += c; if (data.length > 1e6) req.destroy(); });\n   120\t    req.on(\"end\", () => { try { resolve(data ? JSON.parse(data) : {}); } catch (e) { reject(e); } });\n   121\t    req.on(\"error\", reject);\n   122\t  });\n   123\t}\n   124\t\n   125\tfunction ui() {\n   126\t  const row = (cells) => `<tr>${cells.map(c => `<td>${String(c)}</td>`).join(\"\")}</tr>`;\n   127\t  return `<!doctype html><meta charset=\"utf-8\"><title>Relay</title>\n   128\t<style>body{font-family:system-ui;margin:2rem;max-width:60rem}table{border-collapse:collapse;width:100%;margin-bottom:1.5rem}td,th{border:1px solid #ddd;padding:.4rem .6rem;text-align:left;font-size:14px}h2{margin:.2rem 0 .4rem}</style>\n   129\t<h1>Relay</h1>\n   130\t<h2>Events (${state.events.length})</h2><table><tr><th>id</th><th>type</th><th>received</th></tr>${state.events.map(e => row([e.id, e.type, e.receivedAt])).join(\"\")}</table>\n   131\t<h2>Jobs</h2><table><tr><th>id</th><th>status</th><th>attempts</th><th>lastError</th></tr>${state.jobs.map(j => row([j.id, j.status, j.attempts, j.lastError || \"\"])).join(\"\")}</table>\n   132\t<h2>Approvals</h2><table><tr><th>id</th><th>to</th><th>subject</th><th>status</th></tr>${state.approvals.map(a => row([a.id, a.action.to, a.action.subject, a.status])).join(\"\")}</table>\n   133\t<h2>Outbox (sandboxed)</h2><table><tr><th>to</th><th>subject</th><th>sentAt</th></tr>${state.outbox.map(o => row([o.to, o.subject, o.sentAt])).join(\"\")}</table>`;\n   134\t}\n   135\t\n   136\tconst server = http.createServer(async (req, res) => {\n   137\t  const url = new URL(req.url, `http://localhost:${PORT}`);\n   138\t  try {\n   139\t    if (req.method === \"GET\" && url.pathname === \"/\") {\n   140\t      res.writeHead(200, { \"Content-Type\": \"text/html\" });\n   141\t      return res.end(ui());\n   142\t    }\n   143\t    if (req.method === \"GET\" && url.pathname === \"/api/state\") return json(res, 200, state);\n   144\t    if (req.method === \"GET\" && url.pathname === \"/health\") {\n   145\t      const queue = { pending: 0, done: 0, dead: 0 };\n   146\t      for (const j of state.jobs) if (j.status in queue) queue[j.status] += 1;\n   147\t      const approvals = { pending: 0, sent: 0, rejected: 0, blocked_recipient: 0 };\n   148\t      for (const a of state.approvals) if (a.status in approvals) approvals[a.status] += 1;\n   149\t      return json(res, 200, { ok: true, queue, approvals });\n   150\t    }\n   151\t    if (req.method === \"POST\" && url.pathname === \"/webhook/event\") {\n   152\t      const body = await readBody(req);\n   153\t      const result = acceptEvent(body);\n   154\t      return json(res, result.ok ? 200 : 400, result);\n   155\t    }\n   156\t    const mApprove = url.pathname.match(/^\\/api\\/approvals\\/([^/]+)\\/approve$/);\n   157\t    if (req.method === \"POST\" && mApprove) {\n   158\t      const result = approve(mApprove[1]);\n   159\t      return json(res, result.ok ? 200 : result.code, result);\n   160\t    }\n   161\t    const mReject = url.pathname.match(/^\\/api\\/approvals\\/([^/]+)\\/reject$/);\n   162\t    if (req.method === \"POST\" && mReject) {\n   163\t      const result = reject(mReject[1]);\n   164\t      return json(res, result.ok ? 200 : result.code, result);\n   165\t    }\n   166\t    json(res, 404, { error: \"not found\" });\n   167\t  } catch (e) {\n   168\t    json(res, 400, { error: String(e.message || e) });\n   169\t  }\n   170\t});\n   171\t\n   172\tloadState();\n   173\tsetInterval(workerTick, WORKER_MS);\n   174\tserver.listen(PORT, () => console.log(`relay listening on :${PORT} (data: ${DATA_DIR})`));\n\n--- NEW TEST ---\n     1\tconst { test } = require(\"node:test\");\n     2\tconst assert = require(\"node:assert\");\n     3\tconst { spawn } = require(\"node:child_process\");\n     4\tconst fs = require(\"node:fs\");\n     5\tconst path = require(\"node:path\");\n     6\tconst os = require(\"node:os\");\n     7\t\n     8\tconst SERVER = path.join(__dirname, \"..\", \"server.js\");\n     9\t\n    10\tasync function withServer(port, run) {\n    11\t  const base = `http://localhost:${port}`;\n    12\t  const dataDir = fs.mkdtempSync(path.join(os.tmpdir(), \"relay-health-approvals-test-\"));\n    13\t  const proc = spawn(process.execPath, [SERVER], {\n    14\t    env: {\n    15\t      ...process.env,\n    16\t      PORT: String(port),\n    17\t      DATA_DIR: dataDir,\n    18\t      WORKER_MS: \"50\",\n    19\t      ALLOWLIST: \"test@example.com\",\n    20\t    },\n    21\t    stdio: \"ignore\",\n    22\t  });\n    23\t\n    24\t  try {\n    25\t    for (let i = 0; i < 50; i++) {\n    26\t      try {\n    27\t        if ((await fetch(`${base}/health`)).ok) break;\n    28\t      } catch { /* not up yet */ }\n    29\t      if (i === 49) throw new Error(\"server did not come up\");\n    30\t      await new Promise(resolve => setTimeout(resolve, 100));\n    31\t    }\n    32\t    await run(base);\n    33\t  } finally {\n    34\t    proc.kill(\"SIGKILL\");\n    35\t    fs.rmSync(dataDir, { recursive: true, force: true });\n    36\t  }\n    37\t}\n    38\t\n    39\tasync function post(base, pathname, body = {}) {\n    40\t  return fetch(base + pathname, {\n    41\t    method: \"POST\",\n    42\t    headers: { \"Content-Type\": \"application/json\" },\n    43\t    body: JSON.stringify(body),\n    44\t  });\n    45\t}\n    46\t\n    47\tasync function waitForApproval(base, id, tries = 60) {\n    48\t  for (let i = 0; i < tries; i++) {\n    49\t    const state = await (await fetch(`${base}/api/state`)).json();\n    50\t    if (state.approvals.some(approval => approval.id === id)) return;\n    51\t    await new Promise(resolve => setTimeout(resolve, 100));\n    52\t  }\n    53\t  throw new Error(`approval ${id} was not proposed`);\n    54\t}\n    55\t\n    56\tasync function assertHealth(base, expected) {\n    57\t  const response = await fetch(`${base}/health`);\n    58\t  assert.strictEqual(response.status, 200);\n    59\t  assert.strictEqual(response.headers.get(\"content-type\"), \"application/json\");\n    60\t  assert.strictEqual(await response.text(), JSON.stringify(expected));\n    61\t}\n    62\t\n    63\ttest(\"1. Fresh server\", async () => {\n    64\t  await withServer(4731, async base => {\n    65\t    await assertHealth(base, {\n    66\t      ok: true,\n    67\t      queue: { pending: 0, done: 0, dead: 0 },\n    68\t      approvals: { pending: 0, sent: 0, rejected: 0, blocked_recipient: 0 },\n    69\t    });\n    70\t  });\n    71\t});\n    72\t\n    73\ttest(\"2. One pending approval\", async () => {\n    74\t  await withServer(4732, async base => {\n    75\t    await post(base, \"/webhook/event\", {\n    76\t      id: \"health-one-pending\",\n    77\t      payload: { to: \"test@example.com\" },\n    78\t    });\n    79\t    await waitForApproval(base, \"appr-health-one-pending\");\n    80\t\n    81\t    await assertHealth(base, {\n    82\t      ok: true,\n    83\t      queue: { pending: 0, done: 1, dead: 0 },\n    84\t      approvals: { pending: 1, sent: 0, rejected: 0, blocked_recipient: 0 },\n    85\t    });\n    86\t  });\n    87\t});\n    88\t\n    89\ttest(\"3. Approved\", async () => {\n    90\t  await withServer(4733, async base => {\n    91\t    await post(base, \"/webhook/event\", {\n    92\t      id: \"health-approved\",\n    93\t      payload: { to: \"test@example.com\" },\n    94\t    });\n    95\t    await waitForApproval(base, \"appr-health-approved\");\n    96\t\n    97\t    const approval = await post(base, \"/api/approvals/appr-health-approved/approve\");\n    98\t    assert.strictEqual(approval.status, 200);\n    99\t\n   100\t    await assertHealth(base, {\n   101\t      ok: true,\n   102\t      queue: { pending: 0, done: 1, dead: 0 },\n   103\t      approvals: { pending: 0, sent: 1, rejected: 0, blocked_recipient: 0 },\n   104\t    });\n   105\t  });\n   106\t});\n\n--- LEGACY TEST ---\n     1\tconst { test, before, after } = require(\"node:test\");\n     2\tconst assert = require(\"node:assert\");\n     3\tconst { spawn } = require(\"node:child_process\");\n     4\tconst fs = require(\"node:fs\");\n     5\tconst path = require(\"node:path\");\n     6\tconst os = require(\"node:os\");\n     7\t\n     8\tconst PORT = 4721;\n     9\tconst BASE = `http://localhost:${PORT}`;\n    10\tconst DATA_DIR = fs.mkdtempSync(path.join(os.tmpdir(), \"relay-health-test-\"));\n    11\tconst SERVER = path.join(__dirname, \"..\", \"server.js\");\n    12\tlet proc;\n    13\t\n    14\tconst post = (body) => fetch(`${BASE}/webhook/event`, {\n    15\t  method: \"POST\",\n    16\t  headers: { \"Content-Type\": \"application/json\" },\n    17\t  body: JSON.stringify(body),\n    18\t});\n    19\tconst getHealth = async () => (await fetch(`${BASE}/health`)).json();\n    20\tconst getState = async () => (await fetch(`${BASE}/api/state`)).json();\n    21\t\n    22\tasync function settle(pred, tries = 60) {\n    23\t  for (let i = 0; i < tries; i++) {\n    24\t    const state = await getState();\n    25\t    if (pred(state)) return;\n    26\t    await new Promise(resolve => setTimeout(resolve, 100));\n    27\t  }\n    28\t  throw new Error(\"job did not settle\");\n    29\t}\n    30\t\n    31\tbefore(async () => {\n    32\t  proc = spawn(process.execPath, [SERVER], {\n    33\t    env: { ...process.env, PORT: String(PORT), DATA_DIR, WORKER_MS: \"50\" },\n    34\t    stdio: \"ignore\",\n    35\t  });\n    36\t  for (let i = 0; i < 50; i++) {\n    37\t    try {\n    38\t      if ((await fetch(`${BASE}/health`)).ok) return;\n    39\t    } catch { /* not up yet */ }\n    40\t    await new Promise(resolve => setTimeout(resolve, 100));\n    41\t  }\n    42\t  throw new Error(\"server did not come up\");\n    43\t});\n    44\t\n    45\tafter(() => {\n    46\t  proc?.kill(\"SIGKILL\");\n    47\t  fs.rmSync(DATA_DIR, { recursive: true, force: true });\n    48\t});\n    49\t\n    50\ttest(\"1. on a fresh server, /health reports an empty queue\", async () => {\n    51\t  const response = await fetch(`${BASE}/health`);\n    52\t  assert.strictEqual(response.status, 200);\n    53\t  assert.deepStrictEqual(await response.json(), {\n    54\t    ok: true,\n    55\t    queue: { pending: 0, done: 0, dead: 0 },\n    56\t  });\n    57\t});\n    58\t\n    59\ttest(\"1b. after an event is accepted, /health reports queue.pending incremented by 1\", async () => {\n    60\t  const pendingPort = 4722;\n    61\t  const pendingBase = `http://localhost:${pendingPort}`;\n    62\t  const pendingDataDir = fs.mkdtempSync(path.join(os.tmpdir(), \"relay-health-pending-test-\"));\n    63\t  const pendingProc = spawn(process.execPath, [SERVER], {\n    64\t    env: { ...process.env, PORT: String(pendingPort), DATA_DIR: pendingDataDir, WORKER_MS: \"600000\" },\n    65\t    stdio: \"ignore\",\n    66\t  });\n    67\t\n    68\t  try {\n    69\t    for (let i = 0; i < 50; i++) {\n    70\t      try {\n    71\t        if ((await fetch(`${pendingBase}/health`)).ok) break;\n    72\t      } catch { /* not up yet */ }\n    73\t      if (i === 49) throw new Error(\"pending server did not come up\");\n    74\t      await new Promise(resolve => setTimeout(resolve, 100));\n    75\t    }\n    76\t\n    77\t    await fetch(`${pendingBase}/webhook/event`, {\n    78\t      method: \"POST\",\n    79\t      headers: { \"Content-Type\": \"application/json\" },\n    80\t      body: JSON.stringify({ id: \"health-pending\", payload: {} }),\n    81\t    });\n    82\t\n    83\t    assert.deepStrictEqual(await (await fetch(`${pendingBase}/health`)).json(), {\n    84\t      ok: true,\n    85\t      queue: { pending: 1, done: 0, dead: 0 },\n    86\t    });\n    87\t  } finally {\n    88\t    pendingProc.kill(\"SIGKILL\");\n    89\t    fs.rmSync(pendingDataDir, { recursive: true, force: true });\n    90\t  }\n    91\t});\n    92\t\n    93\ttest(\"2. after a job completes, /health reports queue.done incremented by 1\", async () => {\n    94\t  await post({ id: \"health-done\", payload: {} });\n    95\t  await settle(state => state.jobs.find(job => job.eventId === \"health-done\")?.status === \"done\");\n    96\t\n    97\t  assert.deepStrictEqual(await getHealth(), {\n    98\t    ok: true,\n    99\t    queue: { pending: 0, done: 1, dead: 0 },\n   100\t  });\n   101\t});\n   102\t\n   103\ttest(\"3. after a job exhausts retries, /health reports queue.dead incremented by 1\", async () => {\n   104\t  await post({ id: \"health-dead\", payload: { failTimes: 99 } });\n   105\t  await settle(state => state.jobs.find(job => job.eventId === \"health-dead\")?.status === \"dead\");\n   106\t\n   107\t  assert.deepStrictEqual(await getHealth(), {\n   108\t    ok: true,\n   109\t    queue: { pending: 0, done: 1, dead: 1 },\n   110\t  });\n   111\t});\n","exit_code":0,"status":"completed"}}
