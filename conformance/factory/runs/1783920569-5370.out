/app/tests/conformance.test.js\nconformance/app/tests/reject-reason.test.js\nconformance/app/tests/health-approvals.test.js\nconformance/app/tests/health.test.js\nconformance/app/tests/retry-dead.test.js\nconformance/app/server.js\nci/github-actions-ci.template.yml\n?? conformance/factory/runs/1783918994-98019.out\n?? conformance/factory/runs/1783919207-99006.out\n?? conformance/factory/runs/1783919328-99557.out\n?? conformance/factory/runs/1783919498-394.out\n?? conformance/factory/runs/1783919699-1499.out\n?? conformance/factory/runs/1783920569-5370.out\n?? conformance/factory/runs/1783920569-5370.pid\ne9bad59 (HEAD -> ticket/T-104-retry-dead-job, origin/ticket/T-104-retry-dead-job) T-104: authorize reviewer round 4\n794d25a T-104: escalate authorization round mismatch\n29e5779 T-104: authorize reviewer round 3\n25dbd57 T-104: escalate sequencer round limit\nefc855a T-104: record operator round-3 authorization\nf72aa10 T-104: log overlapping reviewer run\nd7eb9a4 T-104: escalate reviewer round 2\nf95da44 T-104: log reviewer fix tests\n596577b T-104: record reviewer round 1 verdict\n82872d7 T-104: log builder run\n780e5bb T-104: implement retry-dead-job route and dead-letter budget reset\n58823c9 T-104: cover immediate and repeated retry transitions\n","exit_code":0,"status":"completed"}}
