dead.test.js | 259 +++++++++++++++++++++++++++++++\\\\n conformance/factory/tickets/T-104.md     |   1 +\\\\n 2 files changed, 260 insertions(+)\\\\nA  conformance/app/tests/retry-dead.test.js\\\\nM  conformance/factory/tickets/T-104.md\\\\n?? conformance/factory/runs/1783918994-98019.out\\\\n?? conformance/factory/runs/1783918994-98019.pid\\\\n[ticket/T-104-retry-dead-job b1d9ddf] T-104: add failing retry-dead acceptance tests\\\\n 2 files changed, 260 insertions(+)\\\\n create mode 100644 conformance/app/tests/retry-dead.test.js\\\\n\\\",\\\"exit_code\\\":0,\\\"status\\\":\\\"completed\\\"}}\\n{\\\"type\\\":\\\"item.started\\\",\\\"item\\\":{\\\"id\\\":\\\"item_14\\\",\\\"type\\\":\\\"command_execution\\\",\\\"command\\\":\\\"/bin/zsh -lc 'git show --check --stat --oneline HEAD && git log --oneline --decorate -4 && git status --short --branch'\\\",\\\"aggregated_output\\\":\\\"\\\",\\\"exit_code\\\":null,\\\"status\\\":\\\"in_progress\\\"}}\\n{\\\"type\\\":\\\"item.completed\\\",\\\"item\\\":{\\\"id\\\":\\\"item_14\\\",\\\"type\\\":\\\"command_execution\\\",\\\"command\\\":\\\"/bin/zsh -lc 'git show --check --stat --oneline HEAD && git log --oneline --decorate -4 && git status --short --branch'\\\",\\\"aggregated_output\\\":\\\"b1d9ddf T-104: add failing retry-dead acceptance tests\\\\nb1d9ddf (HEAD -> ticket/T-104-retry-dead-job) T-104: add failing retry-dead acceptance tests\\\\nd2af767 (origin/ticket/T-104-retry-dead-job) T-104: log planner run\\\\ne08f203 T-104: freeze retry-dead-job contract (planner)\\\\n0526f4a (origin/main, origin/HEAD, main) Envelope: repo daily cap aligned to machine cap (15)\\\\n## ticket/T-104-retry-dead-job...origin/ticket/T-104-retry-dead-job [ahead 1]\\\\n?? conformance/factory/runs/1783918994-98019.out\\\\n?? conformance/factory/runs/1783918994-98019.pid\\\\n\\\",\\\"exit_code\\\":0,\\\"status\\\":\\\"completed\\\"}}\\n{\\\"type\\\":\\\"item.completed\\\",\\\"item\\\":{\\\"id\\\":\\\"item_15\\\",\\\"type\\\":\\\"agent_message\\\",\\\"text\\\":\\\"Committed failing acceptance tests as `b1d9ddf` (`T-104: add failing retry-dead acceptance tests`).\\\\n\\\\n- Added four tests matching AC1–AC4 plus exact unknown-job `404` coverage.\\\\n- Added the test summary to the ticket; all criteria were testable.\\\\n- Targeted suite: 0 passed, 5 failed for the expected missing retry route/response behavior.\\\\n- Full suite: all 20 pre-existing tests passed; only the 5 new tests failed.\\\\n- No implementation or pre-existing tests changed.\\\\n- Unrelated factory run artifacts remain untracked.\\\"}}\\n{\\\"type\\\":\\\"turn.completed\\\",\\\"usage\\\":{\\\"input_tokens\\\":320509,\\\"cached_input_tokens\\\":288768,\\\"output_tokens\\\":6666,\\\"reasoning_output_tokens\\\":1992}}\\nturns=1 cost_usd=0.4673\\n\\nconformance/factory/runs/1783919207-99006.out\\n{\\\"type\\\":\\\"result\\\",\\\"subtype\\\":\\\"success\\\",\\\"is_error\\\":false,\\\"api_error_status\\\":null,\\\"duration_ms\\\":73058,\\\"duration_api_ms\\\":64907,\\\"ttft_ms\\\":2021,\\\"ttft_stream_ms\\\":1676,\\\"time_to_request_ms\\\":205,\\\"num_turns\\\":15,\\\"result\\\":\\\"Implementation committed at `aefdef1`.\\\\n\\\\n**Summary:**\\\\n- **Files touched:** `conformance/app/server.js` only — no test files modified.\\\\n- **Changes:** Added `retries`/`attemptsSinceRetry` fields at job creation; `processJob` now increments `attemptsSinceRetry` alongside `attempts` and keys the dead-letter trigger off `attemptsSinceRetry >= MAX_ATTEMPTS`; added `retryJob()` domain function and the `POST /api/jobs/:id/retry` route matching the frozen contract exactly (404/409/200 bodies, code stripped before serializing).\\\\n- **Tests:** All 25 tests pass (`node --test tests/*.test.js`) — 20 pre-existing + 5 new retry-dead acceptance tests, including the crash-recovery one.\\\\n- **Concerns:** None. No lint/typecheck script exists in this zero-dependency project; `node --test` is the full verification surface.\\\",\\\"stop_reason\\\":\\\"end_turn\\\",\\\"session_id\\\":\\\"55a37ee8-2c0c-4763-b90c-8fd191dc10e9\\\",\\\"total_cost_usd\\\":0.5076823,\\\"usage\\\":{\\\"input_tokens\\\":30,\\\"cache_creation_input_tokens\\\":35906,\\\"cache_read_input_tokens\\\":734531,\\\"output_tokens\\\":4742,\\\"server_tool_use\\\":{\\\"web_search_requests\\\":0,\\\"web_fetch_requests\\\":0},\\\"service_tier\\\":\\\"standard\\\",\\\"cache_creation\\\":{\\\"ephemeral_1h_input_tokens\\\":35906,\\\"ephemeral_5m_input_tokens\\\":0},\\\"inference_geo\\\":\\\"not_available\\\",\\\"iterations\\\":[{\\\"input_tokens\\\":2,\\\"output_tokens\\\":327,\\\"cache_read_input_tokens\\\":58526,\\\"cache_creation_input_tokens\\\":590,\\\"cache_creation\\\":{\\\"ephemeral_5m_input_tokens\\\":0,\\\"ephemeral_1h_input_tokens\\\":590},\\\"type\\\":\\\"message\\\"}],\\\"speed\\\":\\\"standard\\\"},\\\"modelUsage\\\":{\\\"claude-sonnet-5\\\":{\\\"inputTokens\\\":30,\\\"outputTokens\\\":4742,\\\"cacheReadInputTokens\\\":734531,\\\"cacheCreationInputTokens\\\":35906,\\\"webSearchRequests\\\":0,\\\"costUSD\\\":0.5070153,\\\"contextWindow\\\":1000000,\\\"maxOutputTokens\\\":64000},\\\"claude-haiku-4-5-20251001\\\":{\\\"inputTokens\\\":582,\\\"outputTokens\\\":17,\\\"cacheReadInputTokens\\\":0,\\\"cacheCreationInputTokens\\\":0,\\\"webSearchRequests\\\":0,\\\"costUSD\\\":0.0006670000000000001,\\\"contextWindow\\\":200000,\\\"maxOutputTokens\\\":32000}},\\\"permission_denials\\\":[],\\\"terminal_reason\\\":\\\"completed\\\",\\\"fast_mode_state\\\":\\\"off\\\",\\\"uuid\\\":\\\"4033b6ab-4741-44f4-a4a9-cbce7d56b582\\\"}\\nturns=15 cost_usd=0.5076823\\n\\nconformance/factory/runs/1783919328-99557.out\\nREMOTE CHECKS\\nno pull requests found for branch \\\"ticket/T-104-retry-dead-job\\\"\\n\",\"exit_code\":1,\"status\":\"failed\"}}\nconformance/factory/runs/1783919328-99557.out:16:{\"type\":\"item.completed\",\"item\":{\"id\":\"item_7\",\"type\":\"agent_message\",\"text\":\"REQUEST CHANGES — round 1\\n\\n1. The accepted-retry transition is not inspected before the worker advances. An implementation that incorrectly clears `lastError` during the retry would pass all 25 tests. Add a controlled-worker assertion immediately after the `200` response verifying persisted state is `pending`, `attempts` and `lastError` are unchanged, `attemptsSinceRetry` is `0`, and `retries` is `1`.\\n\\n2. The frozen rule that `retries` increments by exactly one per accepted retry is only tested for the first retry. Add a second dead → retry cycle and assert the response and job record report `retries: 2` while preserving cumulative attempts and resetting only the fresh-attempt counter.\\n\\nCommit order and test immutability are correct. The pre-builder state reproduces 20 existing passes and 5 intended failures; the current full suite independently passes 25/25. The implementation otherwise matches the frozen contract and conventions.\"}}\nconformance/factory/tickets/T-104.md:25:Before freezing the contract, enumerate every existing test that asserts exact response bodies this change would touch (`/health` queue counts, job objects in `/api/state`, the conformance suite's dead-letter test). If the contract necessarily breaks any of them, say so in the frozen contract and list the exact tests the test-author must amend *in the same test-authoring stage* — do not leave the collision for the builder to discover.\nconformance/factory/tickets/T-104.md:52:- `attemptsSinceRetry` (number): attempts made since job creation, or since the most recent accepted retry, whichever is later. Incremented by `1` in the same worker tick that increments `attempts` (so it always equals `attempts` until the first retry, after which it runs ahead of `attempts` by the reset amount). This is the internal counter that drives the \"3 more attempts\" budget below — it is not itself a public promise beyond what AC1–AC4 require, but it is real state and will appear verbatim in `/api/state`, so the test-author may assert on it directly.\nconformance/factory/tickets/T-104.md:63:If this contract proves wrong during build or test-authoring, the ticket goes back to Ready for re-planning as a new version — do not silently change the shape.\nconformance/factory/tickets/T-104.md:74:**Conclusion: zero existing tests require amendment.** `tests/retry-dead.test.js` is a purely additive new file; the test-author does not need to touch any pre-existing test file for this ticket.\nconformance/factory/tickets/T-104.md:87:- 2026-07-12: test author added `tests/retry-dead.test.js` with one acceptance test each for: retry-to-success and normal proposed action creation; exactly three fresh failed attempts with cumulative attempt history; immutable `409` refusal for both pending and done jobs; and persisted retry processing after `SIGKILL` + restart. The suite also covers the exact frozen unknown-job `404` response. All four criteria were expressible as tests; no demo-check-only items.\nconformance/factory/tickets/T-104.md:88:- 2026-07-12: test-author (Codex) committed five frozen-contract checks at `b1d9ddf`; all five fail for the expected missing retry route/response behavior while all 20 existing tests pass; no product code or pre-existing tests changed; ledger cost $0.4673.\nconformance/factory/tickets/T-104.md:89:- 2026-07-12: builder (Claude Code) implemented the frozen retry route, additive counters, and reset dead-letter budget in `conformance/app/server.js` at `aefdef1` without touching tests; full suite passes 25/25; ledger cost $0.5076823.\nconformance/factory/tickets/T-104.md:90:- 2026-07-12 23:10:53: reviewer round 1: REQUEST CHANGES — The accepted-retry transition is not inspected before the worker advances. An implementation that incorrectly clears `lastError` during the retry would pass all 25 tests. Add a controlled-worker assertion immediately after the `200` response verifying persisted state is `pending`, `attempts` and `lastError` are unchanged, `attemptsSinceRetry` is `0`, and `retries` is `1`. The frozen rule that `retries` increments by exactly one per accepted retry is only tested for the first retry. Add a second dead → retry cycle and assert the response and job record report `retries: 2` while preserving cumulative attempts and resetting only the fresh-attempt counter. Commit order and test immutability are correct. The pre-builder state reproduces 20 existing passes and 5 intended failures; the current full suite independently passes 25/25. The implementation otherwise matches the frozen contract and conventions. Cost $0.2527.\nconformance/factory/tickets/T-104.md:91:- 2026-07-12: test author addressed reviewer round 1 in `tests/retry-dead.test.js`: AC1 now restarts with a controlled long worker interval and verifies the persisted immediate accepted-retry transition preserves `attempts: 3` and `lastError` while setting `pending`, `retries: 1`, and `attemptsSinceRetry: 0`; AC2 now covers a second complete dead → retry → dead cycle, asserting the accepted response/record report `retries: 2`, cumulative attempts remain `6` at retry and reach `9` after exactly three fresh failures, and only `attemptsSinceRetry` resets. All criteria remain expressible as automated tests; no demo-check-only items.\nconformance/factory/tickets/T-104.md:92:- 2026-07-12: test-author (Codex) addressed reviewer round 1 at `66cde3e`; targeted suite passes 5/5 and full suite passes 25/25; only the acceptance tests and ticket log changed; ledger cost $0.3445.\nconformance/SHAKEDOWN-REPORT.md:15:| Test-immutability gate | passes on a clean builder branch; fails (exit 1) when a builder commit touches a test file |\nconformance/SHAKEDOWN-REPORT.md:25:5. **Ticket branches must merge, not delete.** During the immutability demo the ticket branch was deleted unmerged and the shakedown's own adapter fixes were nearly lost (recovered via reflog). The ticket-flow doc's rule — one branch, one PR, merged via approval — exists for a reason; the drill violated it and paid.\nconformance/SHAKEDOWN-REPORT.md:31:- Railway account for staging/preview deploys (`ci/railway.md`).\nconformance/SHAKEDOWN-REPORT.md:35:## Hardening round (same day) — two-model review of the built kit\nconformance/SHAKEDOWN-REPORT.md:39:1. **Immutability gate bypass (both reviewers):** v1 exempted commits whose *message* contained `[test-author]` — a marker the builder itself controls. Rewritten to two identity-free mechanical rules: a commit may touch tests or code, never both (separation); and every test commit must precede every implementation commit (order). Verified: clean branch passes; late test edit fails rule 2; a mixed commit carrying the old marker fails rule 1.\nconformance/SHAKEDOWN-REPORT.md:42:4. **Cross-family rule became mechanical:** the wrapper now maps roles to adapters (builder/planner → claude-code; test-author/reviewer → codex) and refuses mismatches, instead of trusting prompts.\nconformance/SHAKEDOWN-REPORT.md:43:5. **Operator approval became mechanical:** branch protection now requires 1 approving GitHub review (the operator's, after reading the bundle) — previously 0, which made approval-before-merge procedural only.\nconformance/SHAKEDOWN-REPORT.md:48:The enforcement layer now holds against its own reviewers' attacks: no identity-based bypasses, anchored kill switch, reservation-based caps, mechanical cross-family and approval rules. Conformance suite: 8/8 green. Remaining honest gap, unchanged: **no ticket has yet run with real (non-mock) CLI agents** — that first real run is what the operator go-ahead buys, and it is the kit's final acceptance test.\nconformance/factory/runs/1783912635-77319.out:4:{\"type\":\"item.completed\",\"item\":{\"id\":\"item_0\",\"type\":\"agent_message\",\"text\":\"I’ll update only the four exact-match `/health` expectations, verify the full suite, and commit that single test-file change on the specified branch. I’ll first inspect the repository guidance and frozen contract to ensure the scenario counts are exact.\"}}\nconformance/factory/runs/1783912635-77319.out:5:{\"type\":\"item.started\",\"item\":{\"id\":\"item_1\",\"type\":\"command_execution\",\"command\":\"/bin/zsh -lc \\\"pwd && rg --files -g 'AGENTS.md' -g '*conventions*' -g '*T-102*' -g 'health.test.js' -g 'package.json' -g 'README*' | sort && git status --short --branch\\\"\",\"aggregated_output\":\"\",\"exit_code\":null,\"status\":\"in_progress\"}}\nconformance/factory/runs/1783912635-77319.out:6:{\"type\":\"item.completed\",\"item\":{\"id\":\"item_1\",\"type\":\"command_execution\",\"command\":\"/bin/zsh -lc \\\"pwd && rg --files -g 'AGENTS.md' -g '*conventions*' -g '*T-102*' -g 'health.test.js' -g 'package.json' -g 'README*' | sort && git status --short --branch\\\"\",\"aggregated_output\":\"/Users/sofiagonzalez/Projects/sf-worktrees/T-102\\nREADME.md\\nconformance/app/package.json\\nconformance/app/tests/health.test.js\\nconformance/factory/tickets/T-102.md\\nroles/README.md\\n## ticket/T-102-health-approvals-summary\\n\",\"exit_code\":0,\"status\":\"completed\"}}\n","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_9","type":"command_execution","command":"/bin/zsh -lc \"git show e08f203:conformance/factory/tickets/T-104.md | sed -n '/## Frozen contract/,/## Existing test audit/p'; git diff e08f203..HEAD -- conformance/app/server.js\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_9","type":"command_execution","command":"/bin/zsh -lc \"git show e08f203:conformance/factory/tickets/T-104.md | sed -n '/## Frozen contract/,/## Existing test audit/p'; git diff e08f203..HEAD -- conformance/app/server.js\"","aggregated_output":"## Frozen contract\n\n### `POST /api/jobs/:id/retry`\n\n`:id` is the job's `id` field exactly as it appears in `/api/state` (e.g. `job-e4`), matched against `state.jobs`, route regex `^\\/api\\/jobs\\/([^/]+)\\/retry$`. No request body is read or required.\n\n- Unknown `:id` → `404 { \"ok\": false, \"error\": \"no such job\" }`, no state change.\n- Job exists but `status !== \"dead\"` (i.e. `pending` or `done`) → `409 { \"ok\": false, \"error\": \"only dead jobs can be retried (status: <current-status>)\" }` — `<current-status>` is the literal current value of `job.status` (`\"pending\"` or `\"done\"`), record unchanged (no field, including `lastError`, is touched; no `persist()` call happens on this branch).\n- Job exists and `status === \"dead\"` → accepted:\n  - `job.status` → `\"pending\"`\n  - `job.attemptsSinceRetry` → reset to `0`\n  - `job.retries` → incremented by `1`\n  - `job.attempts` and `job.lastError` are **not** modified by the retry call itself (the next worker tick updates them exactly as it does today)\n  - state is persisted atomically before the response is sent\n  - Response: `200 { \"ok\": true, \"status\": \"pending\", \"retries\": <job.retries after increment> }`\n\n### `GET /api/state` — `jobs[]` shape (additive, present on every job from creation, not just retried ones)\n\nEvery job object gains two new keys, initialized at creation in `acceptEvent` alongside the existing `attempts: 0, lastError: null`:\n\n```json\n{ \"id\": \"job-e1\", \"eventId\": \"e1\", \"status\": \"pending\", \"attempts\": 0, \"lastError\": null, \"retries\": 0, \"attemptsSinceRetry\": 0 }\n```\n\n- `retries` (number): count of times `POST /api/jobs/:id/retry` has been accepted for this job. `0` until first retry, then increments by exactly `1` per accepted retry call. This is \"the record shows it was retried\" representation the ticket description asks the planner to freeze.\n- `attemptsSinceRetry` (number): attempts made since job creation, or since the most recent accepted retry, whichever is later. Incremented by `1` in the same worker tick that increments `attempts` (so it always equals `attempts` until the first retry, after which it runs ahead of `attempts` by the reset amount). This is the internal counter that drives the \"3 more attempts\" budget below — it is not itself a public promise beyond what AC1–AC4 require, but it is real state and will appear verbatim in `/api/state`, so the test-author may assert on it directly.\n- `attempts` is unchanged in meaning: **cumulative total attempts across the job's entire lifetime, including all retries** — never reset. This is the \"cumulative attempts visible on the record\" the ticket asks for.\n\n### Worker/dead-letter logic change (in `processJob`)\n\nToday: `if (job.attempts <= failTimes) { ...; if (job.attempts >= MAX_ATTEMPTS) job.status = \"dead\"; }`.\n\nNew: increment both `job.attempts` and `job.attemptsSinceRetry` on every attempt; the dead-letter check moves from `job.attempts >= MAX_ATTEMPTS` to `job.attemptsSinceRetry >= MAX_ATTEMPTS` (`MAX_ATTEMPTS` stays `3`, unchanged, reused as-is). The failure-vs-success check itself (`job.attempts <= failTimes`) stays keyed on cumulative `attempts`, not the reset counter — this is what makes \"payload stops failing\" (AC1) fall out for free: once cumulative `attempts` exceeds the event's fixed `failTimes`, every future attempt (retried or not) succeeds, without any payload mutation. For a job never retried, `attemptsSinceRetry === attempts` at all times, so pre-existing dead-lettering behavior (dead at exactly 3 cumulative attempts) is bit-for-bit unchanged.\n\n`workerTick` itself is unchanged: it still picks the first `status === \"pending\"` job in array order per tick, which already covers \"the worker picks it up on its normal tick\" for a re-queued job.\n\nIf this contract proves wrong during build or test-authoring, the ticket goes back to Ready for re-planning as a new version — do not silently change the shape.\n\n## Existing test audit (planner note lesson from T-102)\ndiff --git a/conformance/app/server.js b/conformance/app/server.js\nindex ef04468..ffc00cd 100644\n--- a/conformance/app/server.js\n+++ b/conformance/app/server.js\n@@ -44,6 +44,8 @@ function acceptEvent(evt) {\n     status: \"pending\", // pending | done | dead\n     attempts: 0,\n     lastError: null,\n+    retries: 0,\n+    attemptsSinceRetry: 0,\n   });\n   persist();\n   return { ok: true, duplicate: false, eventId: evt.id };\n@@ -52,12 +54,13 @@ function acceptEvent(evt) {\n function processJob(job) {\n   const evt = state.events.find(e => e.id === job.eventId);\n   job.attempts += 1;\n+  job.attemptsSinceRetry += 1;\n   // Simulated transient/permanent failure: payload.failTimes = number of\n   // attempts that must fail before success (99 = effectively permanent).\n   const failTimes = Number(evt?.payload?.failTimes || 0);\n   if (job.attempts <= failTimes) {\n     job.lastError = `simulated failure on attempt ${job.attempts}`;\n-    if (job.attempts >= MAX_ATTEMPTS) job.status = \"dead\";\n+    if (job.attemptsSinceRetry >= MAX_ATTEMPTS) job.status = \"dead\";\n     persist();\n     return;\n   }\n@@ -109,6 +112,19 @@ function reject(id, body) {\n   return { ok: true, status: \"rejected\", reason };\n }\n \n+function retryJob(id) {\n+  const job = state.jobs.find(j => j.id === id);\n+  if (!job) return { ok: false, code: 404, error: \"no such job\" };\n+  if (job.status !== \"dead\") {\n+    return { ok: false, code: 409, error: `only dead jobs can be retried (status: ${job.status})` };\n+  }\n+  job.status = \"pending\";\n+  job.attemptsSinceRetry = 0;\n+  job.retries += 1;\n+  persist();\n+  return { ok: true, code: 200, status: \"pending\", retries: job.retries };\n+}\n+\n // ---------- http ----------\n function json(res, code, obj) {\n   res.writeHead(code, { \"Content-Type\": \"application/json\" });\n@@ -166,6 +182,11 @@ const server = http.createServer(async (req, res) => {\n       const { code, ...result } = reject(mReject[1], body);\n       return json(res, result.ok ? 200 : code, result);\n     }\n+    const mRetry = url.pathname.match(/^\\/api\\/jobs\\/([^/]+)\\/retry$/);\n+    if (req.method === \"POST\" && mRetry) {\n+      const { code, ...result } = retryJob(mRetry[1]);\n+      return json(res, code, result);\n+    }\n     json(res, 404, { error: \"not found\" });\n   } catch (e) {\n     json(res, 400, { error: String(e.message || e) });\n","exit_code":0,"status":"completed"}}
