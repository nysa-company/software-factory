{"type":"item.completed","item":{"id":"item_15","type":"command_execution","command":"/bin/zsh -lc \"sed -n '1,100p' ci/github-actions-ci.template.yml; sed -n '1,120p' .github/workflows/ci.yml 2>/dev/null || true; sed -n '1,120p' .github/scripts/test-immutability-check.sh 2>/dev/null || true; (cd conformance/app && ../../../ci/test-immutability-check.sh)\"","aggregated_output":"# CI template — extracted from the Relay shakedown (what was actually needed,\n# nothing speculative). Copy to .github/workflows/ci.yml in the product repo\n# and adjust the placeholders marked <...>.\nname: ci\n\non:\n  pull_request:\n  push:\n    branches: [main]\n\njobs:\n  ci:\n    runs-on: ubuntu-latest\n    steps:\n      - uses: actions/checkout@v4\n      - uses: actions/setup-node@v4\n        with:\n          node-version: 22\n      # <add: npm ci / lint / typecheck once the product has them>\n      - name: tests\n        run: npm test\n        working-directory: <app directory>\n      # <add: build step + Playwright self-referential snapshots once UI exists>\n\n  test-immutability:\n    runs-on: ubuntu-latest\n    steps:\n      - uses: actions/checkout@v4\n        with:\n          fetch-depth: 0   # the check walks every commit on the branch\n      - name: builder commits must not touch tests\n        run: .github/scripts/test-immutability-check.sh\n        env:\n          BASE_REF: origin/${{ github.base_ref || 'main' }}\n          TEST_PATHS: <test paths, e.g. \"app/tests/\">\n\n# Both jobs go into branch protection as required checks: \"ci\" and\n# \"test-immutability\" (see ci/branch-protection.md).\n# Live CI for this repo, instantiated from ci/github-actions-ci.template.yml.\n# The \"product\" here is the Relay conformance app; when the kit is\n# instantiated for a real product, that repo gets its own copy.\nname: ci\n\non:\n  pull_request:\n  push:\n    branches: [main]\n\njobs:\n  ci:\n    runs-on: ubuntu-latest\n    steps:\n      - uses: actions/checkout@v4\n      - uses: actions/setup-node@v4\n        with:\n          node-version: 22\n      - name: tests\n        run: npm test\n        working-directory: conformance/app\n\n  test-immutability:\n    runs-on: ubuntu-latest\n    steps:\n      - uses: actions/checkout@v4\n        with:\n          fetch-depth: 0   # the check walks every commit on the branch\n      - name: builder commits must not touch tests\n        run: bash ci/test-immutability-check.sh\n        env:\n          BASE_REF: origin/${{ github.base_ref || 'main' }}\n          TEST_PATHS: conformance/app/tests/\nzsh:1: no such file or directory: ../../../ci/test-immutability-check.sh\n","exit_code":127,"status":"failed"}}
