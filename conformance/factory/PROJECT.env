# Project descriptor — everything a dispatcher needs to run this product,
# kept in the product repo so it is versioned and reviewed like code.
# Contract documented in docs/architecture.md (multi-project engine model).
PROJECT_NAME=relay
GH_REPO=nysa-company/software-factory
TEST_PATHS="conformance/app/tests/"
WORKTREES_DIR=$HOME/Projects/sf-worktrees
TICKET_BRANCH_PREFIX=ticket/
CERTIFY_SCRIPT=factory/certify.sh
# Relay lives inside the kit repo itself (shakedown special case), so the
# kit pin is implicit — external products write factory/KIT_PIN instead.
